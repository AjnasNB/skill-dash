{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillDash — Skill Library and AI community",
    "version": "0.4.0",
    "description": "SkillDash is a software tool and skill library for AI agents. Public skill and tool discovery requires no account. Owner-authorized submissions use verified email sessions and stay private until reviewer approval."
  },
  "servers": [
    {
      "url": "https://skills.maqamagent.com"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service status and catalog counts"
          }
        }
      }
    },
    "/api/skills": {
      "get": {
        "operationId": "searchSkills",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 500
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "stars",
                "name"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "official",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results with total, offset, limit, skills, and generatedAt"
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "categories",
        "responses": {
          "200": {
            "description": "Category names and skill counts"
          }
        }
      }
    },
    "/api/skills/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "getSkill",
        "responses": {
          "200": {
            "description": "Skill metadata and download URLs"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      }
    },
    "/api/skills/{id}/content": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "readSkill",
        "responses": {
          "200": {
            "description": "Original SKILL.md text"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      }
    },
    "/api/skills/{id}/manifest": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "getManifest",
        "responses": {
          "200": {
            "description": "Pinned file URLs, lengths, SHA-256 hashes, and ZIP checksum"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      }
    },
    "/api/skills/{id}/download": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "downloadSkill",
        "responses": {
          "200": {
            "description": "ZIP containing the complete skill folder and license notices"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      }
    },
    "/api/submissions": {
      "post": {
        "operationId": "submitSkill",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "repo",
                  "path"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "format": "uri"
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already published"
          },
          "202": {
            "description": "Queued for review"
          },
          "400": {
            "description": "Invalid source"
          },
          "429": {
            "description": "Daily submission limit exceeded"
          },
          "503": {
            "description": "Submission service unavailable"
          }
        },
        "deprecated": true,
        "description": "Legacy source suggestions. For publication, receipts and contact follow-up use /api/community/listings after owner email verification."
      }
    },
    "/api/auth/session": {
      "get": {
        "summary": "Inspect the current verified email session",
        "responses": {
          "200": {
            "description": "Current private account or null, with no-store caching."
          }
        }
      }
    },
    "/api/auth/start": {
      "post": {
        "summary": "Request a one-time email sign-in link",
        "description": "Rate limited. Links expire after 15 minutes. Does not return the token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "displayName"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sign-in email accepted by the email provider."
          },
          "429": {
            "description": "Rate limited."
          },
          "503": {
            "description": "Email could not be sent; no usable token retained."
          }
        }
      }
    },
    "/api/auth/verify": {
      "post": {
        "summary": "Consume a requested sign-in token once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified session cookie issued."
          },
          "401": {
            "description": "Invalid, expired or already used link."
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Revoke the current session",
        "security": [
          {
            "emailSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current cookie cleared and session revoked."
          }
        }
      }
    },
    "/api/community/listings": {
      "get": {
        "summary": "Search publicly approved AI listings",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "skill",
                "product",
                "plugin",
                "library",
                "mcp",
                "tool"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reviewed public listings with share links, maker names and real community vote counts. No account emails or pending submissions."
          }
        }
      },
      "post": {
        "operationId": "submitAgentSkillOrTool",
        "summary": "Submit public details for owner review and a verified-email receipt",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "SkillDash owner-authorized submission",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "name",
                  "tagline",
                  "description",
                  "website",
                  "category",
                  "pricing",
                  "rights"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "skill",
                      "product",
                      "chatbot",
                      "plugin",
                      "library",
                      "mcp",
                      "tool"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  },
                  "tagline": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 140
                  },
                  "description": {
                    "type": "string",
                    "minLength": 50,
                    "maxLength": 5000
                  },
                  "website": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500,
                    "description": "Public HTTPS URL without credentials."
                  },
                  "sourceUrl": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "category": {
                    "enum": [
                      "Development",
                      "Design",
                      "AI & agents",
                      "Marketing",
                      "Data & research",
                      "Cloud & DevOps",
                      "Security",
                      "Writing",
                      "Product & business",
                      "Documents",
                      "Automation",
                      "Video & audio"
                    ]
                  },
                  "pricing": {
                    "enum": [
                      "Free",
                      "Open source",
                      "Freemium",
                      "Paid"
                    ]
                  },
                  "rights": {
                    "const": true,
                    "description": "The owner authorized publication of these public details."
                  },
                  "contactEmail": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254,
                    "description": "Private. Must match the verified account email; defaults to that email."
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Optional and private. No format or ownership verification."
                  },
                  "agentDetails": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "repository": {
                        "type": "string",
                        "maxLength": 300,
                        "description": "Public GitHub repository URL. Required for a skill."
                      },
                      "skillPath": {
                        "type": "string",
                        "maxLength": 300,
                        "description": "Relative folder containing SKILL.md; use . for the root. Required for a skill."
                      },
                      "compatibility": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "prerequisites": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "installation": {
                        "type": "string",
                        "maxLength": 3000
                      }
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "skill"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "required": [
                        "agentDetails"
                      ],
                      "properties": {
                        "agentDetails": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "repository": {
                              "type": "string",
                              "maxLength": 300,
                              "description": "Public GitHub repository URL. Required for a skill."
                            },
                            "skillPath": {
                              "type": "string",
                              "maxLength": 300,
                              "description": "Relative folder containing SKILL.md; use . for the root. Required for a skill."
                            },
                            "compatibility": {
                              "type": "string",
                              "maxLength": 500
                            },
                            "prerequisites": {
                              "type": "string",
                              "maxLength": 1000
                            },
                            "installation": {
                              "type": "string",
                              "maxLength": 3000
                            }
                          },
                          "required": [
                            "repository",
                            "skillPath"
                          ]
                        }
                      }
                    }
                  }
                ],
                "x-endpoint": "https://skills.maqamagent.com/api/community/listings",
                "x-authentication": "Verified owner email-link session. Discovery is public; submissions require owner authorization.",
                "x-review": "Pending until reviewer approval. Reviewer defines agent compatibility and usage instructions before publication.",
                "x-notifications": "Submission receipt and approved/rejected review outcomes go to the verified owner email."
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Public machine-readable result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Verify owner email first"
          },
          "409": {
            "description": "Already submitted"
          }
        }
      }
    },
    "/api/community/mine": {
      "get": {
        "summary": "Inspect your own submission statuses and review notes",
        "security": [
          {
            "emailSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Only the current account’s submissions."
          }
        }
      }
    },
    "/api/community/listings/{id}/vote": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Inspect your vote and the public total",
        "security": [
          {
            "emailSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current vote and count."
          }
        }
      },
      "put": {
        "summary": "Set or withdraw one unique account vote",
        "security": [
          {
            "emailSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "voted"
                ],
                "properties": {
                  "voted": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent vote state and real total."
          },
          "401": {
            "description": "Verified sign-in required."
          },
          "404": {
            "description": "Only published listings can receive votes."
          }
        }
      }
    },
    "/api/community/review": {
      "get": {
        "summary": "Reviewer-only pending queue and failed notifications",
        "security": [
          {
            "emailSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Private reviewer queue."
          },
          "403": {
            "description": "Server-configured reviewer account required."
          }
        }
      }
    },
    "/api/community/review/{id}": {
      "post": {
        "summary": "Approve or reject a pending submission",
        "security": [
          {
            "emailSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status",
                  "note"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "published",
                      "rejected"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 1000
                  },
                  "checks": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "boolean"
                      },
                      "details": {
                        "type": "boolean"
                      },
                      "rights": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded review outcome and public link when approved."
          },
          "400": {
            "description": "Approval requires all three source, details and rights checks."
          },
          "403": {
            "description": "Reviewer account required."
          },
          "409": {
            "description": "Already reviewed."
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "callPublicMcp",
        "summary": "Read-only public SkillDash MCP over stateless Streamable HTTP",
        "description": "JSON-RPC MCP transport. Initialize with a compatible MCP client, then call search_skills, read_skill, plan_skill_install or search_listings. Request bodies are bounded to 8 KiB. This endpoint does not install files or expose project memory.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "method": {
                    "type": "string"
                  },
                  "id": {},
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response"
          },
          "202": {
            "description": "Notification accepted"
          },
          "400": {
            "description": "Invalid protocol message"
          },
          "413": {
            "description": "Request exceeds 8 KiB"
          }
        }
      }
    },
    "/api/agent": {
      "get": {
        "operationId": "getAgentLibraryInfo",
        "summary": "Understand SkillDash agent interfaces and submission requirements",
        "responses": {
          "200": {
            "description": "Public machine-readable result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/tools": {
      "get": {
        "operationId": "searchAgentTools",
        "summary": "Find curated agent tools, plugins, libraries, MCP servers and chatbots",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "plugin",
                "library",
                "mcp",
                "tool",
                "chatbot"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public machine-readable result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/submission-schema": {
      "get": {
        "operationId": "getSubmissionSchema",
        "summary": "Get the exact owner-authorized submission JSON schema",
        "responses": {
          "200": {
            "description": "Public machine-readable result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        }
      }
    },
    "securitySchemes": {
      "emailSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-skilldash",
        "description": "HttpOnly session issued after one-time email verification. Never expose or log this credential."
      },
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-skilldash",
        "description": "Existing owner session from email-link verification. Never publish the session cookie."
      }
    }
  }
}
