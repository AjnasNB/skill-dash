{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-skill-library",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/mcp",
      "/skills",
      "/skills/*",
      "/collections/*",
      "/guides/*",
      "/for-agents",
      "/for-agents.html",
      "/for-agents/",
      "/about",
      "/about.html",
      "/about/",
      "/directory/*",
      "/products",
      "/publish",
      "/account",
      "/review",
      "/listings/*",
      "/badges/*",
      "/sitemaps/community.xml"
    ],
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-skill-library",
      "database_id": "84b5e385-830a-4745-a8ea-465f691d6293",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "skills.maqamagent.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ADMIN_EMAIL": "contact@cognifyr.co",
    "EMAIL_FROM": "skilldash@cognifyr.co"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "skilldash@cognifyr.co"
      ]
    }
  ]
}
