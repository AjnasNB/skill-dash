{
  "name": "agent-skill-library",
  "version": "0.1.0",
  "description": "Search, inspect, and install source-pinned agent skills for Codex, Claude Code, and Delta Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Ajnas NB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/skill-dash.git"
  },
  "homepage": "https://skills.maqamagent.com",
  "bugs": "https://github.com/AjnasNB/skill-dash/issues",
  "bin": {
    "skill-library": "bin/skill-library.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./search": "./lib/search.mjs",
    "./install": {
      "types": "./lib/install.d.ts",
      "default": "./lib/install.mjs"
    }
  },
  "engines": { "node": ">=20.19" },
  "files": [
    "bin/",
    "lib/",
    "registry/catalog.json",
    "registry/manifests/",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "dev": "npm run preview",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-assets.mjs",
    "sync": "node scripts/sync-registry.mjs",
    "hydrate": "node scripts/hydrate-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-registry.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "prepack": "npm run check && npm test",
    "test:browser": "node scripts/test-browser.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:copy-seo": "node scripts/test-copy-seo-browser.mjs",
    "notify:indexnow": "node scripts/notify-indexnow.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.0",
    "vite": "^8.0.0",
    "wrangler": "^4.137.0",
    "yaml": "^2.8.2"
  }
}
