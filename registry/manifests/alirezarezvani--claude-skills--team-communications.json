{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--team-communications","name":"team-communications","description":"Write internal company communications — 3P updates (Progress/Plans/Problems), company-wide newsletters, FAQ roundups, incident reports, leadership updates, status reports, project updates, and general internal comms. Use this skill any time the user asks to draft, edit, or format something meant for internal audiences. Trigger on keywords like \"3P\", \"weekly update\", \"newsletter\", \"FAQ\", \"internal comms\", \"status report\", \"company update\", \"team update\", \"incident report\", or any request to summarize work for leadership, teammates, or the broader company. Even casual requests like \"write my update\" or \"summarize what my team did this week\" should trigger this skill.","category":"Writing","tags":["team","communications","write","internal","company","3p","updates","progress","plans","problems","wide","newsletters","faq","roundups","incident","reports","leadership","status"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"project-management/skills/team-communications","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/project-management/skills/team-communications","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":6,"bytes":15031,"sha256":"b6b7e1ce17fb86f735e9d99bdb9692f321d2a22a8a987f7821fb09c0a1f983fe","historical":false},"files":[{"path":"SKILL.md","sourcePath":"project-management/skills/team-communications/SKILL.md","bytes":4422,"sha256":"b6b7e1ce17fb86f735e9d99bdb9692f321d2a22a8a987f7821fb09c0a1f983fe","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/project-management/skills/team-communicatio