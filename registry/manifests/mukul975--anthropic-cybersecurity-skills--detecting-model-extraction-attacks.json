{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--detecting-model-extraction-attacks","name":"detecting-model-extraction-attacks","description":"Detect MITRE ATLAS AML.T0024 attacks (model stealing, inversion, membership inference) performed via inference-API abuse, by monitoring per-principal query volume/distribution, rate-limiting and perturbing outputs, and red-teaming your model's extractability. Use for a public or partner inference API needing cloning/inversion/membership-inference detection, or a pre-deployment red-team exercise to measure extraction risk.","category":"Cloud & DevOps","tags":["detecting","model","extraction","attacks","detect","mitre","atlas","aml.t0024","stealing","inversion","membership","inference","performed","via","api","abuse","by","monitoring"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/detecting-model-extraction-attacks/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/detecting-model-extraction-attacks","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-model-extraction-attacks","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":5,"bytes":32863,"sha256":"f721213e5733b63c2f6f3f26c134a3b8de96d75dc515600c0854fe97d223f4bd","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/detecting-model-extraction-attacks/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-model-extraction-attacks/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/detecting-model-extraction-attacks/SKILL.md","bytes":11750,"sha256":"f721213e5733b63c2f6f3f26c134a3b8de96d75dc5