{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--react18-string-refs","name":"react18-string-refs","description":"Provides exact migration patterns for React string refs (ref=\"name\" + this.refs.name) to React.createRef() in class components. Use this skill whenever migrating string ref usage - including single element refs, multiple refs in a component, refs in lists, callback refs, and refs passed to child components. Always use this skill before writing any ref migration code - the multiple-refs-in-list pattern is particularly tricky and this skill prevents the most common mistakes. Use it for React 18.3.1 migration (string refs warn) and React 19 migration (string refs removed).","category":"Writing","tags":["react18","string","refs","provides","exact","migration","patterns","react","ref","name","this.refs.name","react.createref","class","components.","skill","whenever","migrating","usage"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/react18-string-refs","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react18-string-refs","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":9985,"sha256":"c876a43c2aaaac6746c48364ebadf050787922d259ef6f021b51d36f2db9fc67","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/react18-string-refs/SKILL.md","bytes":2120,"sha256":"c876a43c2aaaac6746c48364ebadf050787922d259ef6f021b51d36f2db9fc67","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react18-string-refs/SKILL.md"},{"path":"references/patterns.md","sourcePath":"skills/react18-string-refs/references/patterns.md","bytes":6806,"sha256":"4a6c78b0039d96aca99f27c2f524b3d70ac60687a088aba135d679f635ce7f14","mode":420,"url":"ht