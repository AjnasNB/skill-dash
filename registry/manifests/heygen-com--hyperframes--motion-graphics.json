{"schemaVersion":1,"skill":{"id":"heygen-com--hyperframes--motion-graphics","name":"motion-graphics","description":"A short, design-led motion graphic where motion is the message — kinetic typography, stat count-up, chart/data-viz hit, logo sting / brand lockup, lower-third / callout / social overlay, animated map (highlight regions, connect places, zoom to a location), animated tweet / news-article / headline, webpage / UI animation (scroll, cursor, callouts), or fusing a real image's geometry into a chart. Usually under 10s (up to ~30s), no narration or live-action subject; renders to MP4 or transparent overlay. Longer / narrated / multi-scene → /general-video. Unclear → /hyperframes.","category":"Video & audio","tags":["motion","graphics","short","design","led","graphic","where","is","message","kinetic","typography","stat","count","up","chart","data","viz","hit"],"repo":"heygen-com/hyperframes","owner":"heygen-com","stars":52761,"official":true,"featured":false,"license":"Apache-2.0","licensePath":"LICENSE","revision":"58c873d8161d6a2357eacf89a540bfecc359349b","path":"skills/motion-graphics","sourceUrl":"https://github.com/heygen-com/hyperframes/tree/58c873d8161d6a2357eacf89a540bfecc359349b/skills/motion-graphics","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T06:32:31Z","fileCount":24,"bytes":125839,"sha256":"08d8511423df5199871bbea26790858311e17f79b14633e94db86655919ec1d3","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/motion-graphics/SKILL.md","bytes":15671,"sha256":"08d8511423df5199871bbea26790858311e17f79b14633e94db86655919ec1d3","mode":420,"url":"https://raw.githubusercontent.com/heygen-com/hyperframes/58c873d8161d6a2357eacf89a540bfecc359349b/skills/motion-graphics/SKILL.md"},{"path":"agents/builder.md","sourcePath":"skills/motion-graphics/agents/builder.md","bytes":3764,"sha256":"65cb8e2246a51038a793dda13e0f4d6a2a091c163f7a6d4af3097612b704c640","mode":420,"url":"https://raw.githubusercontent.com/heygen-com/hyperframes/