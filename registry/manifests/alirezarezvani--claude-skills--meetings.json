{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--meetings","name":"meetings","description":"Use when someone wants to decide whether a meeting is worth calling, price a meeting in dollars, build a timeboxed agenda with desired outcomes, or turn messy meeting notes into owned action items — or says \"should this be a meeting\", \"/cs:meeting-prep\", or \"/cs:meeting-actions\". Runs a cost gate (ASYNC / NOT-READY / MEET), builds a decision-first agenda, and extracts an owner + due-date checklist that flags every orphan.","category":"Development","tags":["meetings","when","someone","wants","decide","whether","meeting","is","worth","calling","price","dollars","timeboxed","agenda","desired","outcomes","turn","messy"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"productivity/meetings/skills/meetings","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/productivity/meetings/skills/meetings","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":10,"bytes":58697,"sha256":"c990f9c02f47da992739d68773ce9d6a33ca7d4cdcc462d0adf9ca962a674c5d","historical":false},"files":[{"path":"SKILL.md","sourcePath":"productivity/meetings/skills/meetings/SKILL.md","bytes":6003,"sha256":"c990f9c02f47da992739d68773ce9d6a33ca7d4cdcc462d0adf9ca962a674c5d","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/meetings/skills/meetings/SKILL.md"},{"path":"assets/example_agenda.md","sourcePath":"productivity/meetings/skills/meetings/assets/example_agenda.md","bytes":3361,"sha256":"9da73554d7eae3c0391578be73c41cacfc659222f357efb992c3560bab5f4413","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b20983