{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--sql-pro","name":"sql-pro","description":"Optimizes SQL queries, designs database schemas, and troubleshoots performance issues. Use when a user asks why their query is slow, needs help writing complex joins or aggregations, mentions database performance issues, or wants to design or migrate a schema. Invoke for complex queries, window functions, CTEs, indexing strategies, query plan analysis, covering index creation, recursive queries, EXPLAIN/ANALYZE interpretation, before/after query benchmarking, or migrating queries between database dialects (PostgreSQL, MySQL, SQL Server, Oracle).","category":"Design","tags":["sql","pro","optimizes","queries","designs","database","schemas","troubleshoots","performance","issues.","when","user","asks","why","their","query","is","slow"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/sql-pro","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/sql-pro","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":7,"bytes":57890,"sha256":"88ee296bc482dc47ad4bc9f2d0e21c0d37568690e43874fd55beed1099cfcf5d","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/sql-pro/SKILL.md","bytes":5224,"sha256":"88ee296bc482dc47ad4bc9f2d0e21c0d37568690e43874fd55beed1099cfcf5d","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/sql-pro/SKILL.md"},{"path":"references/database-design.md","sourcePath":"skills/sql-pro/references/database-design.md","bytes":12540,"sha256":"b8d0676ac91213999c28e03dae2a7685d78dda05b6abe3f6b34690d2ae19d0f6","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/sql-pro/r