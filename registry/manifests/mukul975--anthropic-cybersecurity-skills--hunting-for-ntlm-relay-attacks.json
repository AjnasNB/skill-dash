{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-ntlm-relay-attacks","name":"hunting-for-ntlm-relay-attacks","description":"Detects NTLM relay attacks (MITRE T1557.001) by analyzing Windows Event ID 4624 logon type 3 with NTLMSSP authentication, flagging IP-to-hostname mismatches, Responder/LLMNR poisoning signatures, SMB signing status, and anomalous cross-domain authentication patterns. Use when investigating credential-relay activity in Active Directory or building detections for NTLM relay and coercion-based attacks.","category":"Development","tags":["hunting","ntlm","relay","attacks","detects","mitre","t1557.001","by","analyzing","windows","event","id","4624","logon","type","ntlmssp","authentication","flagging"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-ntlm-relay-attacks/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-ntlm-relay-attacks","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-ntlm-relay-attacks","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":31459,"sha256":"3cd66b92fd62bc6b8350d6ef29c43a9f008074a68d132070590f6f9c95ba6497","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-ntlm-relay-attacks/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-ntlm-relay-attacks/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-ntlm-relay-attacks/SKILL.md","bytes":2881,"sha256":"3cd66b92fd62bc6b8350d6ef29c43a9f008074a68d132070590f6f9c95ba6497","mode":420,"url":"https://raw.githubusercontent.