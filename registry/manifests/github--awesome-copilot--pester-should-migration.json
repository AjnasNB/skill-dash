{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--pester-should-migration","name":"pester-should-migration","description":"Experimental (preview) Pester skill for migrating classic Should -Be (v5) assertion syntax to the new Should-* (v6) assertions (note the hyphen, no space), e.g. `Should -Be` -> `Should-Be`, `Should -Not -Be` -> `Should-NotBe`. Tracks Pester 6, which is still a release candidate, so this guidance may change; verified against Pester 6.0.0-rc2. Use when converting Pester v5 assertions to Pester v6 Should-* operators, modernizing a Pester test suite, or when a user asks to migrate, convert, or rewrite `Should -...` calls in .Tests.ps1 / PowerShell files.","category":"Development","tags":["pester","should","migration","experimental","preview","skill","migrating","classic","be","v5","assertion","syntax","new","v6","assertions","note","hyphen","no"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/pester-should-migration","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/pester-should-migration","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":18547,"sha256":"d80c47ed3cda083f6411da12d0251a136608eada05c846eeba361e3168c9f14f","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/pester-should-migration/SKILL.md","bytes":7927,"sha256":"d80c47ed3cda083f6411da12d0251a136608eada05c846eeba361e3168c9f14f","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/pester-should-migration/SKILL.md"},{"path":"references/assertion-map.md","sourcePath":"skills/pester-should-migration/references/assertion-map.md","bytes":9561,"sha256":"5e2a82c979802a35ce3fff274f8c98ed20f6ffc902d2ae4f8510f9c7f6a2d46e","mode":420,"url":"https