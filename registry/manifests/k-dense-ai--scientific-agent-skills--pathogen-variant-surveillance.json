{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--pathogen-variant-surveillance","name":"pathogen-variant-surveillance","description":"Queries public GenSpectrum LAPIS data for pathogen genomic surveillance, current lineage nomenclature, weekly sequence proportions, reporting delays, and descriptive mutation frequencies. Use for variant surveillance, Pango lineage validation, dominant submitted lineages, Nextclade assignment provenance, SARS-CoV-2, influenza/H5N1 clades, RSV, mpox, measles, dengue, or LAPIS queries. Distinguishes sequence prevalence from infection prevalence, clades from genotypes, missing calls from reference matches, and sampling changes from biological growth advantage.","category":"Marketing","tags":["pathogen","variant","surveillance","queries","public","genspectrum","lapis","data","genomic","current","lineage","nomenclature","weekly","sequence","proportions","reporting","delays","descriptive"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/pathogen-variant-surveillance","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/pathogen-variant-surveillance","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":10,"bytes":107021,"sha256":"95510f890a47ab2e2275832fe60e725eca34e5318dcde88b0940d9362b3ab590","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/pathogen-variant-surveillance/SKILL.md","bytes":10817,"sha256":"95510f890a47ab2e2275832fe60e725eca34e5318dcde88b0940d9362b3ab590","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/pathogen-variant-surveillance/SKILL.md"},{"path":"references/lapis-api.md","sourcePath":"skills/pathogen-variant-surveillance/re