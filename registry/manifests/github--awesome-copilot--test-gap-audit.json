{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--test-gap-audit","name":"test-gap-audit","description":"Run a read-only audit for missing, weak, stale, or mis-scoped test coverage. If the user does not name a scope, audit the full repository and identify important code paths, routes, features, services, workflows, and contracts that lack proper tests. If the user names a feature, PR, branch, route, workflow, service, bug fix, API, security-sensitive path, or risky code change, focus only on that specific scope. Use when the user asks what tests are missing, whether coverage is enough, what regression tests to add, or how to prove a change is safe. This is not a general bug audit and not a security review; it evaluates whether behavior is covered by tests.","category":"Security","tags":["test","gap","audit","run","read","only","missing","weak","stale","mis","scoped","coverage.","if","user","does","not","name","scope"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/test-gap-audit","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/test-gap-audit","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":32075,"sha256":"a7747ac0b60d33ec6a44b9703ae11e8f6bf7aede251f117cc46599d182bfef21","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/test-gap-audit/SKILL.md","bytes":13585,"sha256":"a7747ac0b60d33ec6a44b9703ae11e8f6bf7aede251f117cc46599d182bfef21","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/test-gap-audit/SKILL.md"},{"path":"scripts/coverage_map.py","sourcePath":"skills/test-gap-audit/scripts/coverage_map.py","bytes":17431,"sha256":"ba40f3756cf30aa499981f9ba684dabb996b239c9898fc7062fbe4186cd18e63","mode":420,"url":"