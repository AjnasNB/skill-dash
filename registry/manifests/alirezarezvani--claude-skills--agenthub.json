{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--agenthub","name":"agenthub","description":"Multi-agent collaboration plugin that spawns N parallel subagents competing on the same task via git worktree isolation. Agents work independently, results are evaluated by metric or LLM judge, and the best branch is merged. Use when: user wants multiple approaches tried in parallel — code optimization, content variation, research exploration, or any task that benefits from parallel competition. Requires: a git repo.","category":"Data & research","tags":["agenthub","multi","agent","collaboration","plugin","spawns","parallel","subagents","competing","same","task","via","git","worktree","isolation.","agents","work","independently"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/agenthub/skills/agenthub","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/agenthub/skills/agenthub","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":84829,"sha256":"c350408074e38f852253e30c0c2eab059b1f53fbf812a2316b23faea6d527571","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/agenthub/skills/agenthub/SKILL.md","bytes":7918,"sha256":"c350408074e38f852253e30c0c2eab059b1f53fbf812a2316b23faea6d527571","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/agenthub/skills/agenthub/SKILL.md"},{"path":"references/agent-templates.md","sourcePath":"engineering/agenthub/skills/agenthub/references/agent-templates.md","bytes":7795,"sha256":"82ecbeebfd360975897a03c0f7b092d4b6e4d38e7bd6ce1b638fd877ff2c4afc","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed0048