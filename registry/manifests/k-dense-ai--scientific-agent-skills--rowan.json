{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--rowan","name":"rowan","description":"Rowan is a cloud-native molecular modeling and medicinal-chemistry workflow platform with a Python API. Use for pKa and macropKa prediction, conformer and tautomer ensembles, docking and analogue docking, protein-ligand cofolding, MSA generation, molecular dynamics, permeability, descriptor workflows, and related small-molecule or protein modeling tasks. Ideal for programmatic batch screening, multi-step chemistry pipelines, and workflows that would otherwise require maintaining local HPC/GPU infrastructure.","category":"Cloud & DevOps","tags":["rowan","is","cloud","native","molecular","modeling","medicinal","chemistry","workflow","platform","python","api.","pka","macropka","prediction","conformer","tautomer","ensembles"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/rowan","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/rowan","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":7,"bytes":53745,"sha256":"d631f00ae0f9325aa58912bb571b7eb43bc42c553498e4c97f4d65a1683c8599","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/rowan/SKILL.md","bytes":17335,"sha256":"d631f00ae0f9325aa58912bb571b7eb43bc42c553498e4c97f4d65a1683c8599","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/rowan/SKILL.md"},{"path":"references/access_and_pricing.md","sourcePath":"skills/rowan/references/access_and_pricing.md","bytes":1595,"sha256":"17509f5c4f9de6830297ac6d7a58e1f6eaa0eee5cf55e3c21f8db7f4bed720a3","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100