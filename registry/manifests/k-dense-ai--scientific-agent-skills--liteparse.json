{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--liteparse","name":"liteparse","description":"Local document and PDF parsing that returns spatial text with bounding boxes. Use for extracting text from PDFs, DOCX, Office files, and images; running OCR on scans; producing layout-preserved JSON for RAG; batch-ingesting folders of papers; or rendering pages to PNG for multimodal agents. Distinguishing capabilities are spatial text boxes, Markdown, page raster output, and local parsing with optional custom HTTP OCR.","category":"Documents","tags":["liteparse","local","document","pdf","parsing","returns","spatial","text","bounding","boxes.","extracting","from","pdfs","docx","office","files","images","running"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/liteparse","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/liteparse","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":8,"bytes":45650,"sha256":"02a789c7959670cb8898e329588a41d43fa7b270c768a70c22aed05031d042a4","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/liteparse/SKILL.md","bytes":12382,"sha256":"02a789c7959670cb8898e329588a41d43fa7b270c768a70c22aed05031d042a4","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/liteparse/SKILL.md"},{"path":"references/api_reference.md","sourcePath":"skills/liteparse/references/api_reference.md","bytes":8514,"sha256":"2aa143daf3423f460a73c37d36441af782819d3aeae0bcf61023f8d340364973","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/liteparse/references/api_reference.md"},{"path":"references/ch