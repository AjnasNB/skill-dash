{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--skill-tester","name":"skill-tester","description":"Validate, test, and score the quality of skills within the claude-skills ecosystem. Comprehensive meta-skill: structure validation, Python script testing (syntax + imports + runtime + output format), multi-dimensional quality scoring with letter grades and tier classification (BASIC/STANDARD/POWERFUL). Use when authoring a new skill, auditing existing skills for tier promotion, setting up pre-commit hooks for skill quality, or integrating skill QA into CI.","category":"Automation","tags":["skill","tester","validate","test","score","quality","skills","within","claude","ecosystem.","comprehensive","meta","structure","validation","python","script","testing","syntax"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/skill-tester","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/skill-tester","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":19,"bytes":254026,"sha256":"a62efa4e6d596e442083543f86a6bfc5724b0d06a4921d9a31bbc1c5d12e23e0","historical":false},"files":[{"path":"README.md","sourcePath":"engineering/skills/skill-tester/README.md","bytes":6829,"sha256":"b02483e58b14a85d48fa11f7b171a9f71c6ba5c82020bbef3a073ca96d9e6765","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/skill-tester/README.md"},{"path":"SKILL.md","sourcePath":"engineering/skills/skill-tester/SKILL.md","bytes":5075,"sha256":"a62efa4e6d596e442083543f86a6bfc5724b0d06a4921d9a31bbc1c5d12e23e0","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f9