{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--anti-ui-slop","name":"anti-ui-slop","description":"Stop coding agents from shipping generic UI. Use UIZZE's 800,000+ real web and iOS screens to build product-specific interfaces, define a design contract, cover required states, and run a hard finish gate. Use when designing, implementing, redesigning, critiquing, or pre-ship reviewing a web or iOS interface in Codex, Claude Code, Cursor, Copilot, or another coding agent. Trigger with \"anti-ui-slop\", \"stop UI slop\", \"ground this UI in real screens\", or \"run the UI finish gate\".","category":"Design","tags":["anti","ui","slop","stop","coding","agents","from","shipping","generic","ui.","uizze","800","000+","real","web","ios","screens","product"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"Apache-2.0","licensePath":"skills/anti-ui-slop/LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/anti-ui-slop","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/anti-ui-slop","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":14,"bytes":24978,"sha256":"38beaf00024589581ed70bcf97e1372e0cdca8e08bfd69ee5e8d3b8beefb3f35","historical":false},"files":[{"path":"CHECKSUMS.sha256","sourcePath":"skills/anti-ui-slop/CHECKSUMS.sha256","bytes":1089,"sha256":"4e6493230f44ae9fd74f97a8b18eca1e781784cd66b21462477d7bf81e3781e4","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/anti-ui-slop/CHECKSUMS.sha256"},{"path":"LICENSE","sourcePath":"skills/anti-ui-slop/LICENSE","bytes":10766,"sha256":"02bb8c3b4e70190e3986c0404ad2fd8d639b4f534252d82379cc1b502b6d1812","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/anti-ui-slop/LICENSE"},{"path":"MANIFEST.json","sourcePath