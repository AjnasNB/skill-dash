{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--scanning-container-images-with-grype","name":"scanning-container-images-with-grype","description":"Scans container images, filesystems, and SBOMs for known CVEs with Anchore Grype, matching Syft-generated SBOM packages against NVD, GitHub Advisories, and OS-specific feeds with configurable severity thresholds and failure gates. Use when Grype or Syft is the chosen toolchain, when scanning an existing SBOM rather than an image, or when gating a build on severity. Keywords: Grype, Syft, SBOM, NVD, GitHub Advisory, --fail-on, severity threshold. Do not use when the toolchain is Trivy - use scanning-docker-images-with-trivy.","category":"Cloud & DevOps","tags":["scanning","container","images","grype","scans","filesystems","sboms","known","cves","anchore","matching","syft","generated","sbom","packages","against","nvd","github"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/scanning-container-images-with-grype/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/scanning-container-images-with-grype","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/scanning-container-images-with-grype","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":39222,"sha256":"7f581d7da0bb79eed97b224619afeb3e543e27b5a39b018c3138250778a97c5b","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/scanning-container-images-with-grype/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/scanning-container-images-with-grype/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/sca