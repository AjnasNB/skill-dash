{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--dependency-auditor","name":"dependency-auditor","description":"Audit and manage dependencies across multi-language projects. Identifies vulnerabilities, license conflicts, transitive dependency risks, and safe-upgrade paths. Use when auditing third-party packages before release, investigating a CVE, planning a major version bump, or running a license-compliance review. Examples: 'audit our npm dependencies', 'do we have GPL contamination', 'plan the upgrade to React 19'.","category":"Security","tags":["dependency","auditor","audit","manage","dependencies","across","multi","language","projects.","identifies","vulnerabilities","license","conflicts","transitive","risks","safe","upgrade","paths."],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/dependency-auditor","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/dependency-auditor","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":17,"bytes":202347,"sha256":"4bde5bd43d14b39a9c282f1ab74b202d102b070b99a5083724e84526bc5e2f0a","historical":false},"files":[{"path":"README.md","sourcePath":"engineering/skills/dependency-auditor/README.md","bytes":15211,"sha256":"023b2506b44dd23c791664e91f1836f9795450333565762cf86267adee8cddbb","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/dependency-auditor/README.md"},{"path":"SKILL.md","sourcePath":"engineering/skills/dependency-auditor/SKILL.md","bytes":4591,"sha256":"4bde5bd43d14b39a9c282f1ab74b202d102b070b99a5083724e84526bc5e2f0a","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b20