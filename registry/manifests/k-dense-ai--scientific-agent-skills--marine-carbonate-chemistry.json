{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--marine-carbonate-chemistry","name":"marine-carbonate-chemistry","description":"Solves seawater carbonate chemistry with PyCO2SYS for chemical oceanography, ocean acidification, and marine carbon-cycle research. Use for paired total alkalinity, dissolved inorganic carbon, pH, or seawater pCO2/fCO2 measurements; carbonate speciation; aragonite and calcite saturation; Revelle factors; lab-to-in-situ temperature and pressure corrections; and measurement uncertainty propagation. Applies to carbonate-system calculations, not general aqueous speciation or air-sea gas-flux estimation.","category":"Data & research","tags":["marine","carbonate","chemistry","solves","seawater","pyco2sys","chemical","oceanography","ocean","acidification","carbon","cycle","research.","paired","total","alkalinity","dissolved","inorganic"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/marine-carbonate-chemistry","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/marine-carbonate-chemistry","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":5,"bytes":34153,"sha256":"03e58c7f9d7df75a323a6a8cf29ec18ae524cc308e5002c27fb5c65e1230f174","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/marine-carbonate-chemistry/SKILL.md","bytes":9548,"sha256":"03e58c7f9d7df75a323a6a8cf29ec18ae524cc308e5002c27fb5c65e1230f174","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/marine-carbonate-chemistry/SKILL.md"},{"path":"references/chemistry-decisions.md","sourcePath":"skills/marine-carbonate-chemistry/references/chemistry-decisions.md","bytes":6520,"sha256":"82ba976bf836