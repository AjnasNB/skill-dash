{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--deep-research","name":"deep-research","description":"Run a disciplined, multi-source research investigation for a high-stakes question or decision — fan-out web search across many channels, parallel sub-agents, source triangulation (each claim backed by ≥3 independent sources), an adversarial review pass, and every source saved to its own file with verbatim quotes for reuse. Use when a low-quality answer is expensive: strategy work, comparing N products/methods/markets, validating a hypothesis with external data, or mapping how a field works. NOT for quick fact-checks (answer directly), structured 12-dimension competitor scoring (use competitive-teardown), or fast topic overviews where the decision risk is low (use the research router instead).","category":"Data & research","tags":["deep","research","run","disciplined","multi","source","investigation","high","stakes","question","decision","fan","out","web","search","across","many","channels"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"research/deep-research/skills/deep-research","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/research/deep-research/skills/deep-research","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":3,"bytes":9886,"sha256":"0c3f02d1ba581a2368c5e8a3b99a2428f42e78081136621359cfecef2fabca25","historical":false},"files":[{"path":"SKILL.md","sourcePath":"research/deep-research/skills/deep-research/SKILL.md","bytes":7834,"sha256":"0c3f02d1ba581a2368c5e8a3b99a2428f42e78081136621359cfecef2fabca25","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/research/deep-research/skills/deep-research/SKILL.md"},{"path":"