{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--deep-work","name":"deep-work","description":"Use when someone wants to plan a deep work day, time-block their calendar or task list, budget or cut shallow work, protect focus hours, track deep-work sessions and streaks, run an end-of-day shutdown ritual, or says \"/deep-work\" or \"/time-block\". Classifies tasks deep vs shallow, builds an energy-first time-blocked schedule that refuses deep demand past the 4-hour ceiling, batches shallow work into at most two windows, and logs focus sessions against a weekly target.","category":"Development","tags":["deep","work","when","someone","wants","plan","day","time","block","their","calendar","task","list","budget","cut","shallow","protect","focus"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"productivity/deep-work/skills/deep-work","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/productivity/deep-work/skills/deep-work","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":10,"bytes":64370,"sha256":"ed801572d6e8c24b795383950b2b20139a455d4d9f157d8a5d2383863ae2f499","historical":false},"files":[{"path":"SKILL.md","sourcePath":"productivity/deep-work/skills/deep-work/SKILL.md","bytes":6095,"sha256":"ed801572d6e8c24b795383950b2b20139a455d4d9f157d8a5d2383863ae2f499","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/deep-work/skills/deep-work/SKILL.md"},{"path":"assets/example_time_block_plan.md","sourcePath":"productivity/deep-work/skills/deep-work/assets/example_time_block_plan.md","bytes":3869,"sha256":"33c5830a93034c80f4f5f716d7b1b720a7d9e2de25d50dd0d5a14523404690ac","mode":420,"url":"https://raw.githubusercontent.com/alire