{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--performing-privacy-impact-assessment","name":"performing-privacy-impact-assessment","description":"Automates the Privacy Impact Assessment (PIA) workflow including data flow mapping, privacy risk scoring matrices, GDPR Article 35 DPIA and CCPA/CPRA alignment checks, data inventory cataloging, and remediation tracking. Implements the NIST Privacy Framework PRAM methodology and ICO DPIA guidance for systematic identification and mitigation of privacy risks across processing activities. Use when conducting privacy assessments for new systems, evaluating regulatory compliance posture, or building automated privacy governance programs.","category":"Automation","tags":["performing","privacy","impact","assessment","automates","pia","workflow","including","data","flow","mapping","risk","scoring","matrices","gdpr","article","35","dpia"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/performing-privacy-impact-assessment/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/performing-privacy-impact-assessment","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/performing-privacy-impact-assessment","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":93606,"sha256":"b906c778bad53bc8ca265385e195018c25686371b12f7c1d3a02aa5b0421befa","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/performing-privacy-impact-assessment/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/performing-privacy-impact-assessment/LICENSE"},{"path":"SKILL.md","sourcePath":"skill