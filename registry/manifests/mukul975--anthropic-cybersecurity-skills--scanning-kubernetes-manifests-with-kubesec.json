{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--scanning-kubernetes-manifests-with-kubesec","name":"scanning-kubernetes-manifests-with-kubesec","description":"Scores Kubernetes resource manifests with Kubesec to flag misconfiguration and privilege-escalation risk before deployment, mapping each finding back to the securityContext change that fixes it. Use when gating manifests in CI, reviewing YAML or a rendered chart before it reaches a cluster, or explaining why a manifest scored negatively. Keywords: Kubesec, manifest score, securityContext, readOnlyRootFilesystem, runAsNonRoot, CI gate. Do not use for scanning built images for CVEs - use scanning-docker-images-with-trivy; for admission-time enforcement use implementing-opa-gatekeeper-for-policy-enforcement.","category":"Cloud & DevOps","tags":["scanning","kubernetes","manifests","kubesec","scores","resource","flag","misconfiguration","privilege","escalation","risk","before","deployment","mapping","each","finding","back","securitycontext"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/scanning-kubernetes-manifests-with-kubesec/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/scanning-kubernetes-manifests-with-kubesec","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/scanning-kubernetes-manifests-with-kubesec","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":41710,"sha256":"b1ad22d0ae2f4fa6a49ce9cd1d9a4f10c0f160331f22f91b1f6e1c97d43d50aa","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/scanning-kubernetes-manifests-with-kubesec/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecur