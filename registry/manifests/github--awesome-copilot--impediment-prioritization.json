{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--impediment-prioritization","name":"impediment-prioritization","description":"Ranks any list of impediments and their countermeasures using a value-stream scoring model (ROI, Cost to Implement, Ease of Deployment, Risk Factor) and a fixed prioritization formula. Use when someone asks to prioritize, rank, sequence, or triage impediments, countermeasures, remediation items, risks, findings, gaps, action items, or backlog entries; or mentions value-stream prioritization, A3 / lean countermeasure ranking, ROI vs. effort scoring, or building a remediation / improvement backlog. Works with GHQR findings, audit results, retrospective action items, risk registers, architecture review gaps, or any free-form `{impediment, countermeasure}` list.","category":"Cloud & DevOps","tags":["impediment","prioritization","ranks","any","list","impediments","their","countermeasures","value","stream","scoring","model","roi","cost","implement","ease","deployment","risk"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/impediment-prioritization","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/impediment-prioritization","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":16084,"sha256":"dd6c9adda40b97375f9a72537d536ef9c9e98a1f43827d9f84bea4e699bece43","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/impediment-prioritization/SKILL.md","bytes":9072,"sha256":"dd6c9adda40b97375f9a72537d536ef9c9e98a1f43827d9f84bea4e699bece43","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/impediment-prioritization/SKILL.md"},{"path":"references/scoring-rubric.md","sourcePath":"skills/impediment-prioritizat