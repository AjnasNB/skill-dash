{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--deploying-ransomware-canary-files","name":"deploying-ransomware-canary-files","description":"Deploys and monitors ransomware canary files using Python's watchdog library, placing decoy files mimicking high-value targets (financial records, credentials, database exports) where ransomware enumerates first, and alerting via email, Slack, or syslog on any read/modify/rename/delete. Use for early-warning ransomware detection on file servers, NAS, or endpoints, or to supplement EDR where agents can't be deployed.","category":"Cloud & DevOps","tags":["deploying","ransomware","canary","files","deploys","monitors","python","watchdog","library","placing","decoy","mimicking","high","value","targets","financial","records","credentials"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/deploying-ransomware-canary-files/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/deploying-ransomware-canary-files","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/deploying-ransomware-canary-files","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":40416,"sha256":"f3e6dae09db71310bf7b6f7105da27ba7d3283c83c014fea9c3898a95b3dcd45","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/deploying-ransomware-canary-files/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/deploying-ransomware-canary-files/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/deploying-ransomware-canary-files/SKILL.md","bytes":4832,"sha256":"f3e6dae09db71310bf7b6f7105da27ba7d3283c83c014fea9c3