{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--react18-batching-patterns","name":"react18-batching-patterns","description":"Provides exact patterns for diagnosing and fixing automatic batching regressions in React 18 class components. Use this skill whenever a class component has multiple setState calls in an async method, inside setTimeout, inside a Promise .then() or .catch(), or in a native event handler. Use it before writing any flushSync call - the decision tree here prevents unnecessary flushSync overuse. Also use this skill when fixing test failures caused by intermediate state assertions that break after React 18 upgrade.","category":"Writing","tags":["react18","batching","patterns","provides","exact","diagnosing","fixing","automatic","regressions","react","18","class","components.","skill","whenever","component","has","multiple"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/react18-batching-patterns","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react18-batching-patterns","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":4,"bytes":11988,"sha256":"f4bdb6d5b817c19b00062392ff51965d42fe185facbb5724653dd9aa39c3140e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/react18-batching-patterns/SKILL.md","bytes":2489,"sha256":"f4bdb6d5b817c19b00062392ff51965d42fe185facbb5724653dd9aa39c3140e","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react18-batching-patterns/SKILL.md"},{"path":"references/batching-categories.md","sourcePath":"skills/react18-batching-patterns/references/batching-categories.md","bytes":5971,"sha256":"bc3b35cffc4ef226ac2bec5755eb1784fc7367b743ae152dda01d745ffc58b36","mode":420,"url":"http