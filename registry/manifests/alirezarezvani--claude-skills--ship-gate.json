{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--ship-gate","name":"ship-gate","description":"Pre-production audit that scans a codebase for security, database, deployment, code quality, AI/LLM, dependency, frontend, and observability issues. Intercepts deploy commands and blocks until critical items pass. Stack-agnostic. Use for \"run ship gate\", \"am I ready to ship\", \"pre-launch audit\", \"can I deploy\", \"push to production\", \"go live checklist\", \"preflight check\". Not for CI/CD setup or infra provisioning.","category":"Security","tags":["ship","gate","pre","production","audit","scans","codebase","security","database","deployment","code","quality","ai","llm","dependency","frontend","observability","issues."],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/ship-gate","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/ship-gate","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":93985,"sha256":"05f7eee0d78735f3076fc02c732e4c660f55e2f058922e1ef46280a414294fa5","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/skills/ship-gate/SKILL.md","bytes":6606,"sha256":"05f7eee0d78735f3076fc02c732e4c660f55e2f058922e1ef46280a414294fa5","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/ship-gate/SKILL.md"},{"path":"references/checks.md","sourcePath":"engineering/skills/ship-gate/references/checks.md","bytes":19088,"sha256":"54f40a29d0d6431b311c6070e4fe1b2a8258d77c0c0d0642203c99875eb0cc4f","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/ship-gate/refere