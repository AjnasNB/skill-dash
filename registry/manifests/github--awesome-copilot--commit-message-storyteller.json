{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--commit-message-storyteller","name":"commit-message-storyteller","description":"Analyzes git diffs or staged changes and generates narrative commit messages that explain WHY a change was made, not just what changed — following Conventional Commits format. Use when asked to \"write a commit message\", \"generate a commit\", \"describe my changes\", \"what should I commit this as\", \"commit this\", \"summarize my diff\", or \"help me commit\". Works with git diff output, staged files, or plain descriptions of changes.","category":"Writing","tags":["commit","message","storyteller","analyzes","git","diffs","staged","changes","generates","narrative","messages","explain","why","change","was","made","not","just"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/commit-message-storyteller","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/commit-message-storyteller","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":10295,"sha256":"9a351d6276d9c17c5e5ac0920efc1dfa054cf9e17c7db52a9fc2a0e38f39e65a","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/commit-message-storyteller/SKILL.md","bytes":5175,"sha256":"9a351d6276d9c17c5e5ac0920efc1dfa054cf9e17c7db52a9fc2a0e38f39e65a","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/commit-message-storyteller/SKILL.md"},{"path":"references/conventional-commits-guide.md","sourcePath":"skills/commit-message-storyteller/references/conventional-commits-guide.md","bytes":4061,"sha256":"f1f575e5af5cb7b2a42ce22dc2112190b2834fef7b31fe75bd44cd0af5db0e62","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a