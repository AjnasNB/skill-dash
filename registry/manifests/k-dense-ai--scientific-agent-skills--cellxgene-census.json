{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--cellxgene-census","name":"cellxgene-census","description":"Queries the CZ CELLxGENE Census programmatically for versioned public single-cell and spatial transcriptomics data. Use when you need population-scale cell metadata, gene expression slices, Census summary counts, source H5AD URIs/downloads, embeddings, spatial Census data, or reference atlas comparisons across organisms, tissues, diseases, assays, and cell types. For analyzing your own local single-cell data use scanpy, anndata, or scvi-tools.","category":"Development","tags":["cellxgene","census","queries","cz","programmatically","versioned","public","single","cell","spatial","transcriptomics","data.","when","you","population","scale","metadata","gene"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/cellxgene-census","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/cellxgene-census","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":6,"bytes":56636,"sha256":"123b66d6701c7c0587d0a615a2394caee52e62745b3fd31176381ea64aaa794a","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/cellxgene-census/SKILL.md","bytes":13648,"sha256":"123b66d6701c7c0587d0a615a2394caee52e62745b3fd31176381ea64aaa794a","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/cellxgene-census/SKILL.md"},{"path":"references/api_access.md","sourcePath":"skills/cellxgene-census/references/api_access.md","bytes":5917,"sha256":"231a947443ea6bd1f3b827951a4db2603a2dc203908f59bfeb24ca55a8f913a9","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a7