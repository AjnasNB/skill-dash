{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--ncats-arax","name":"ncats-arax","description":"Queries the NCATS Translator ARAX production API for bounded, typed, provenance-rich one-hop and endpoint-pinned two-hop biomedical knowledge-graph relationships. Use for Biolink-constrained RTX-KG2 lookup, explicit selected-provider ARAX federation, separate entity normalization, qualifier-aware graph traversal, and inspection of TRAPI edge bindings, publications, and knowledge-source provenance. Do not use for inference, ranking, open-ended pathfinding, clinical guidance, or sensitive queries.","category":"AI & agents","tags":["ncats","arax","queries","translator","production","api","bounded","typed","provenance","rich","one","hop","endpoint","pinned","two","biomedical","knowledge","graph"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/ncats-arax","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/ncats-arax","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":5,"bytes":112135,"sha256":"f15f9f9a149a942ab1eaed0115879afa399249e261d7118a6d19e3da834ba74c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/ncats-arax/SKILL.md","bytes":9136,"sha256":"f15f9f9a149a942ab1eaed0115879afa399249e261d7118a6d19e3da834ba74c","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/ncats-arax/SKILL.md"},{"path":"references/output-schema.md","sourcePath":"skills/ncats-arax/references/output-schema.md","bytes":8388,"sha256":"232a1fdf71eb2c4003df645955dbe6ddf25f28dc6736c21eee60b356f7fb843c","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e7