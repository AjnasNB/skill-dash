{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--system-commandline-cli","name":"system-commandline-cli","description":"Use this skill when adding, modifying, or reviewing CLI commands in a .NET project built with System.CommandLine. Triggers include: creating a new CLI command, adding options or arguments, wiring command handlers, registering subcommands, building command groups, or any architecture decision about CLI command structure. Also use when the user mentions 'System.CommandLine', 'CommandBase', 'SetAction', 'ParseResult', 'RootCommand', 'subcommand', or asks to add a verb to the CLI. Do NOT use for general C# coding, web APIs, UI work, or non-CLI projects.","category":"Design","tags":["system","commandline","cli","skill","when","adding","modifying","reviewing","commands",".net","project","built","system.commandline.","triggers","include","creating","new","command"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/system-commandline-cli","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/system-commandline-cli","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":11697,"sha256":"579c731ea7a7c948bea8d4ad9eef8d65a94e9f260401d7028ffdd4193372e250","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/system-commandline-cli/SKILL.md","bytes":10638,"sha256":"579c731ea7a7c948bea8d4ad9eef8d65a94e9f260401d7028ffdd4193372e250","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/system-commandline-cli/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot