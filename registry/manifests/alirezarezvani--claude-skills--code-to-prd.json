{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--code-to-prd","name":"code-to-prd","description":"Reverse-engineer any codebase into a complete Product Requirements Document (PRD). Analyzes routes, components, state management, API integrations, and user interactions to produce business-readable documentation detailed enough for engineers or AI agents to fully reconstruct every page and endpoint. Works with frontend frameworks (React, Vue, Angular, Svelte, Next.js, Nuxt), backend frameworks (NestJS, Django, Express, FastAPI), and fullstack applications. Use when users mention: generate PRD, reverse-engineer requirements, code to documentation, extract product specs from code, document page logic, analyze page fields and interactions, create a functional inventory, write requirements from an existing codebase, document API endpoints, or analyze backend routes.","category":"AI & agents","tags":["code","prd","reverse","engineer","any","codebase","into","complete","product","requirements","document","analyzes","routes","components","state","management","api","integrations"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"product-team/code-to-prd/skills/code-to-prd","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/product-team/code-to-prd/skills/code-to-prd","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":81139,"sha256":"7a11ba564076b882d8d67f26bdd1ed115b3bb2281f029581c384357b82425305","historical":false},"files":[{"path":"SKILL.md","sourcePath":"product-team/code-to-prd/skills/code-to-prd/SKILL.md","bytes":19708,"sha256":"7a11ba564076b882d8d67f26bdd1ed115b3bb2281f029581c384357b82425305","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a