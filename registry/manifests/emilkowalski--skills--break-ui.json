{"schemaVersion":1,"skill":{"id":"emilkowalski--skills--break-ui","name":"break-ui","description":"Try to break a piece of UI by feeding it worst-case data — long names, unbreakable emails, one-letter names, missing fields, huge counts, zero items, long labels, non-Latin text, emoji, extreme numbers — then render it behind a \"Demo data / Worst case\" toggle and report everything that broke, with the fix for each. Use when the user asks to stress-test, break, or find edge cases in a component or screen, or to \"try the worst case\". For visual design critique use emil-design-eng; for motion use review-animations.","category":"Design","tags":["break","ui","try","piece","by","feeding","it","worst","case","data","long","names","unbreakable","emails","one","letter","missing","fields"],"repo":"emilkowalski/skills","owner":"emilkowalski","stars":45550,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"2d228630ba1446365f614a108cb8252f1feda202","path":"skills/break-ui","sourceUrl":"https://github.com/emilkowalski/skills/tree/2d228630ba1446365f614a108cb8252f1feda202/skills/break-ui","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-11T13:58:32Z","fileCount":3,"bytes":23718,"sha256":"e7eec1d70ac56a04255e9c0dbe98084ea3d544cc04aaad34f32c95d6fa9dff5e","historical":false},"files":[{"path":"CATALOG.md","sourcePath":"skills/break-ui/CATALOG.md","bytes":8268,"sha256":"7358efcc6bb48e35187be1c064cf60022dcb18c72c18fab58b606dfc5f421f15","mode":420,"url":"https://raw.githubusercontent.com/emilkowalski/skills/2d228630ba1446365f614a108cb8252f1feda202/skills/break-ui/CATALOG.md"},{"path":"SKILL.md","sourcePath":"skills/break-ui/SKILL.md","bytes":14380,"sha256":"e7eec1d70ac56a04255e9c0dbe98084ea3d544cc04aaad34f32c95d6fa9dff5e","mode":420,"url":"https://raw.githubusercontent.com/emilkowalski/skills/2d228630ba1446365f614a108cb8252f1feda202/skills/break-ui/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1070,"sha256":"4ff5bdb7887