{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--agent-memory","name":"agent-memory","description":"Use when a project's CLAUDE.md has grown past what anyone reads and you want the agent to learn durable facts from its own sessions instead — or when asking why the agent keeps re-learning the same correction, why a remembered rule is wrong, or where a memory line came from. Implements a four-tier store (L0 transcripts / L1 candidates / L2 project context / L3 stable persona) where promotion is earned by recurrence across sessions and days, never by one confident statement, and nothing reaches a committed file without a human adopting it.","category":"AI & agents","tags":["agent","memory","when","project","claude.md","has","grown","past","what","anyone","reads","you","learn","durable","facts","from","its","own"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/agent-memory/skills/agent-memory","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/agent-memory/skills/agent-memory","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":110468,"sha256":"9c95ad2d18a41b1ca4d575377868c84ff5d294fd0e96a83aafd67fe404aec078","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/agent-memory/skills/agent-memory/SKILL.md","bytes":5222,"sha256":"9c95ad2d18a41b1ca4d575377868c84ff5d294fd0e96a83aafd67fe404aec078","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/agent-memory/skills/agent-memory/SKILL.md"},{"path":"assets/memory_schema.json","sourcePath":"engineering/agent-memory/skills/agent-memory/assets/memory_schema.json","bytes":15600,"sha256":"f744d4e87fdb603f44817929e6be9e19b6df454e