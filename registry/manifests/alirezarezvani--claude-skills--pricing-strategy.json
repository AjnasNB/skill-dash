{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--pricing-strategy","name":"pricing-strategy","description":"Design, optimize, and communicate SaaS pricing — tier structure, value metrics, pricing pages, and price increase strategy. Use when building a pricing model from scratch, redesigning existing pricing, planning a price increase, or improving a pricing page. Trigger keywords: pricing tiers, pricing page, price increase, packaging, value metric, per seat pricing, usage-based pricing, freemium, good-better-best, pricing strategy, monetization, pricing page conversion, Van Westendorp. NOT for broader product strategy — use product-strategist for that. NOT for customer success or renewals — use customer-success-manager for expansion revenue.","category":"Design","tags":["pricing","strategy","design","optimize","communicate","saas","tier","structure","value","metrics","pages","price","increase","strategy.","when","building","model","from"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/pricing-strategy","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/pricing-strategy","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":42695,"sha256":"7b92d0f653fb30784c1317cd60fb58a7a15220debd1ea6884ee5893098acc15a","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/pricing-strategy/SKILL.md","bytes":14446,"sha256":"7b92d0f653fb30784c1317cd60fb58a7a15220debd1ea6884ee5893098acc15a","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/pricing-strategy/SKILL.md"},{"path":"references/pricing-models.md","sourcePath":"marketing-skill/skills