{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--videodb","name":"videodb","description":"See, Understand, Act on video and audio. See- ingest from local files, URLs, RTSP/live feeds, or live record desktop; return realtime context and playable stream links. Understand- extract frames, build visual/semantic/temporal indexes, and search moments with timestamps and auto-clips. Act- transcode and normalize (codec, fps, resolution, aspect ratio), perform timeline edits (subtitles, text/image overlays, branding, audio overlays, dubbing, translation), generate media assets (image, audio, video), and create real time alerts for events from live streams or desktop capture. Use when ingesting, indexing, searching, editing, transcoding, or alerting on video or audio content.","category":"Video & audio","tags":["videodb","see","understand","act","video","audio.","ingest","from","local","files","urls","rtsp","live","feeds","record","desktop","return","realtime"],"repo":"affaan-m/ECC","owner":"affaan-m","stars":266395,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"bf70150eb2df8070024e5bdf08e4aa08959e2735","path":"skills/videodb","sourceUrl":"https://github.com/affaan-m/ECC/tree/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/videodb","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-21T18:40:16Z","fileCount":13,"bytes":129464,"sha256":"1d252c32d309be70786e5b97e40423ec654c6ec1e61180499449b4b52e624798","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/videodb/SKILL.md","bytes":14245,"sha256":"1d252c32d309be70786e5b97e40423ec654c6ec1e61180499449b4b52e624798","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/videodb/SKILL.md"},{"path":"reference/api-reference.md","sourcePath":"skills/videodb/reference/api-reference.md","bytes":20455,"sha256":"fa15b0239185cc807ee77f201818c49cdaf74a50142a04ab8acfa0d90eef43b9","mode":420,"url":"https://raw.githubusercontent