{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--secure-code-guardian","name":"secure-code-guardian","description":"Use when implementing authentication/authorization, securing user input, or preventing OWASP Top 10 vulnerabilities — including custom security implementations such as hashing passwords with bcrypt/argon2, sanitizing SQL queries with parameterized statements, configuring CORS/CSP headers, validating input with Zod, and setting up JWT tokens. Invoke for authentication, authorization, input validation, encryption, OWASP Top 10 prevention, secure session management, and security hardening. For pre-built OAuth/SSO integrations or standalone security audits, consider a more specialized skill.","category":"Security","tags":["secure","code","guardian","when","implementing","authentication","authorization","securing","user","input","preventing","owasp","top","10","vulnerabilities","including","custom","security"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11835,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1be15d8064f88fc25216442406d40add8fd23b53","path":"skills/secure-code-guardian","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/1be15d8064f88fc25216442406d40add8fd23b53/skills/secure-code-guardian","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-03T15:49:22Z","fileCount":7,"bytes":24565,"sha256":"47715fd6db1e0507041a6674a3096f1fd65b086e23453cb7d77a202bbe15fb56","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/secure-code-guardian/SKILL.md","bytes":7220,"sha256":"47715fd6db1e0507041a6674a3096f1fd65b086e23453cb7d77a202bbe15fb56","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/1be15d8064f88fc25216442406d40add8fd23b53/skills/secure-code-guardian/SKILL.md"},{"path":"references/authentication.md","sourcePath":"skills/secure-code-guardian/references/authentication.md","bytes":3349,"sha256":"4d680ac47602955de09a4bb248346a91b961