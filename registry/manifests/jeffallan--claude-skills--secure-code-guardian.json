{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--secure-code-guardian","name":"secure-code-guardian","description":"Use when implementing authentication/authorization, securing user input, or preventing OWASP Top 10 vulnerabilities — including custom security implementations such as hashing passwords with bcrypt/argon2, sanitizing SQL queries with parameterized statements, configuring CORS/CSP headers, validating input with Zod, and setting up JWT tokens. Invoke for authentication, authorization, input validation, encryption, OWASP Top 10 prevention, secure session management, and security hardening. For pre-built OAuth/SSO integrations or standalone security audits, consider a more specialized skill.","category":"Security","tags":["secure","code","guardian","when","implementing","authentication","authorization","securing","user","input","preventing","owasp","top","10","vulnerabilities","including","custom","security"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/secure-code-guardian","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/secure-code-guardian","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":7,"bytes":24389,"sha256":"19153a339a499baf6ea7fc684afc535d8b31292af468e5dd008b58b20d29a89c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/secure-code-guardian/SKILL.md","bytes":7044,"sha256":"19153a339a499baf6ea7fc684afc535d8b31292af468e5dd008b58b20d29a89c","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/secure-code-guardian/SKILL.md"},{"path":"references/authentication.md","sourcePath":"skills/secure-code-guardian/references/authentication.md","bytes":3349,"sha256":"4d680ac47602955de09a4bb248346a91b961