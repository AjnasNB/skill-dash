{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--onekgpd","name":"onekgpd","description":"Queries the 1000 Genomes Project dataset (3,202 whole-genome-sequenced individuals, GRCh38) at the level of individual participants. Use when a question is about individuals or variants in the 1000 Genomes Project cohort: which individuals carry variants matching specific criteria in a gene or region, which individuals are homozygous-reference at a position, which variants exist in the dataset or carried by specified individuals in a gene or region, the relatedness between two specified individuals. Variants are returned with 1000 Genomes allele frequencies (AF), gnomAD v4.1 exome and genome AF, AlphaMissense score, and HGVSp annotations.","category":"Data & research","tags":["onekgpd","queries","1000","genomes","project","dataset","202","whole","genome","sequenced","individuals","grch38","at","level","individual","participants.","when","question"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/onekgpd","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/onekgpd","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":7,"bytes":1135804,"sha256":"6a7c0a90c42e899e818de866e843cf60d5434422fa69b910a7db9a06f25240e9","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/onekgpd/SKILL.md","bytes":22564,"sha256":"6a7c0a90c42e899e818de866e843cf60d5434422fa69b910a7db9a06f25240e9","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/onekgpd/SKILL.md"},{"path":"assets/kgpe.json","sourcePath":"skills/onekgpd/assets/kgpe.json","bytes":1037258,"sha256":"51bce468b9c339e658305376ae338eac7912ac4b8ab31982f9ca6