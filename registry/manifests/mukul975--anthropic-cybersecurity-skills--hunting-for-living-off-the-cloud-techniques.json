{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-living-off-the-cloud-techniques","name":"hunting-for-living-off-the-cloud-techniques","description":"Hunts for adversary abuse of legitimate cloud services (Azure, AWS, GCP, and SaaS platforms) for command-and-control, data staging, and exfiltration, i.e. \"living off the cloud\" tradecraft that blends in with normal cloud API and service activity. Use when threat hunting for cloud-native C2 channels, abnormal use of storage/SaaS services for data staging, or exfiltration hidden in legitimate cloud traffic.","category":"Security","tags":["hunting","living","off","cloud","techniques","hunts","adversary","abuse","legitimate","services","azure","aws","gcp","saas","platforms","command","control","data"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-living-off-the-cloud-techniques/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-living-off-the-cloud-techniques","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-living-off-the-cloud-techniques","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":34108,"sha256":"301f9148b2301da8a8005a30e59617b51af6ba84d1f1966bcece39c26a6895c4","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-living-off-the-cloud-techniques/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-living-off-the-cloud-techniques/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-living-off-the-cloud-techniques/SKILL.md","bytes":3697,"sha256":"301f9