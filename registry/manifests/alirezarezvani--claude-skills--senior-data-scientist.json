{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--senior-data-scientist","name":"senior-data-scientist","description":"World-class senior data scientist skill specialising in statistical modeling, experiment design, causal inference, and predictive analytics. Covers A/B testing (sample sizing, two-proportion z-tests, Bonferroni correction), difference-in-differences, feature engineering pipelines (Scikit-learn, XGBoost), cross-validated model evaluation (AUC-ROC, AUC-PR, SHAP), and MLflow experiment tracking — using Python (NumPy, Pandas, Scikit-learn), R, and SQL. Use when designing or analysing controlled experiments, building and evaluating classification or regression models, performing causal analysis on observational data, engineering features for structured tabular datasets, or translating statistical findings into data-driven business decisions.","category":"Design","tags":["senior","data","scientist","world","class","skill","specialising","statistical","modeling","experiment","design","causal","inference","predictive","analytics.","covers","testing","sample"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering-team/skills/senior-data-scientist","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/senior-data-scientist","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":23189,"sha256":"6d0418ae7e9f28d14b31b7850375e831355ab6275eff556afeccf06633a3299c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering-team/skills/senior-data-scientist/SKILL.md","bytes":9404,"sha256":"6d0418ae7e9f28d14b31b7850375e831355ab6275eff556afeccf06633a3299c","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486