{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-webshell-activity","name":"hunting-for-webshell-activity","description":"Runs a hypothesis-driven threat hunt for web shell deployment (T1505.003) on internet-facing servers by analyzing file creation in web directories, suspicious child-process spawning from web server processes, and anomalous HTTP request patterns. Use when hunting for web shells after a public-facing app compromise, when EDR/SIEM alerts fire on webserver process anomalies, or during incident response on internet-facing infrastructure.","category":"Security","tags":["hunting","webshell","activity","runs","hypothesis","driven","threat","hunt","web","shell","deployment","t1505.003","internet","facing","servers","by","analyzing","file"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-webshell-activity/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-webshell-activity","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-webshell-activity","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":35157,"sha256":"924090564520ffe6d4a8f57ea2cc2823613c689379b1943c7946fecfec9d6e6d","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-webshell-activity/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-webshell-activity/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-webshell-activity/SKILL.md","bytes":3613,"sha256":"924090564520ffe6d4a8f57ea2cc2823613c689379b1943c7946fecfec9d6e6d","mode":420,"url":"ht