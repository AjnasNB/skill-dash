{"schemaVersion":1,"skill":{"id":"phuryn--pm-skills--intended-vs-implemented","name":"intended-vs-implemented","description":"The method for finding the gap between what a system is supposed to do and what the code actually does — the class of bug generic scanners miss because they have no model of intent. Defines what counts as documented intent, what counts as implementation evidence, which mismatches matter, and how to avoid hand-wavy findings. Use when auditing AI-built code, reviewing access control against documented permissions, or checking whether a codebase matches its own documentation.","category":"Writing","tags":["intended","vs","implemented","method","finding","gap","between","what","system","is","supposed","do","code","actually","does","class","bug","generic"],"repo":"phuryn/pm-skills","owner":"phuryn","stars":26567,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"8607e3b077817f89bf4a9b623246219734ac3be0","path":"pm-ai-shipping/skills/intended-vs-implemented","sourceUrl":"https://github.com/phuryn/pm-skills/tree/8607e3b077817f89bf4a9b623246219734ac3be0/pm-ai-shipping/skills/intended-vs-implemented","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-14T21:15:01Z","fileCount":2,"bytes":4883,"sha256":"6d917f0e59f78ea6b5d847f57b1c816baa2948cac56529939589cd73d2e4c9eb","historical":false},"files":[{"path":"SKILL.md","sourcePath":"pm-ai-shipping/skills/intended-vs-implemented/SKILL.md","bytes":3815,"sha256":"6d917f0e59f78ea6b5d847f57b1c816baa2948cac56529939589cd73d2e4c9eb","mode":420,"url":"https://raw.githubusercontent.com/phuryn/pm-skills/8607e3b077817f89bf4a9b623246219734ac3be0/pm-ai-shipping/skills/intended-vs-implemented/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1068,"sha256":"a2c922f9b81b4f40347ddfa79c38eda0f1278b5a6d108bd4099b4da254c774ee","mode":420,"url":"https://raw.githubusercontent.com/phuryn/pm-skills/8607e3b077817f89bf4a9b623246219734ac3be0/LICENSE"}],"archiveSha256":"005a