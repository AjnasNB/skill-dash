{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--operationalizing-misp-threat-feeds","name":"operationalizing-misp-threat-feeds","description":"Stand up MISP, enable and cache curated threat feeds (CIRCL, abuse.ch, Feodo Tracker), apply warninglists to suppress false positives, query indicators with PyMISP, and export attributes as auto-generated Suricata/Sigma/Wazuh detection rules. Use when maturing a MISP instance to actively drive detection, curating threat feeds with quality controls, or automating IOC-to-detection pipelines for the SIEM/IDS.","category":"Security","tags":["operationalizing","misp","threat","feeds","stand","up","enable","cache","curated","circl","abuse.ch","feodo","tracker","apply","warninglists","suppress","false","positives"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/operationalizing-misp-threat-feeds/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/operationalizing-misp-threat-feeds","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/operationalizing-misp-threat-feeds","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":5,"bytes":30628,"sha256":"c568fc3afc62140b55439e6385a96dfdffb2d1a339097d8017b7ea631136a888","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/operationalizing-misp-threat-feeds/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/operationalizing-misp-threat-feeds/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/operationalizing-misp-threat-feeds/SKILL.md","bytes":10557,"sha256":"c568fc3afc62140b55439e6385a96dfdffb2d1a339097d8017b7ea631136a888","m