{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--regulatory-affairs-head","name":"regulatory-affairs-head","description":"Senior Regulatory Affairs Manager for HealthTech and MedTech companies. Prepares FDA 510(k), De Novo, and PMA submission packages; analyzes regulatory pathways for new medical devices; drafts responses to FDA deficiency letters and Notified Body queries; develops CE marking technical documentation under EU MDR 2017/745; coordinates multi-market approval strategies across FDA, EU, Health Canada, PMDA, and NMPA; and maintains regulatory intelligence on evolving standards. Use when users need to plan or execute FDA submissions, navigate 510(k) or PMA approval processes, achieve CE marking, prepare pre-submission meeting materials, write regulatory strategy documents, respond to agency queries, or manage compliance documentation for medical device market access.","category":"Product & business","tags":["regulatory","affairs","head","senior","manager","healthtech","medtech","companies.","prepares","fda","510","de","novo","pma","submission","packages","analyzes","pathways"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"ra-qm-team/skills/regulatory-affairs-head","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/regulatory-affairs-head","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":84259,"sha256":"e2e4fa920a82cbc24f437fc5e2a8a1b1a219c61b81dbc5a5d9f7c86e56b08b4c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"ra-qm-team/skills/regulatory-affairs-head/SKILL.md","bytes":20196,"sha256":"e2e4fa920a82cbc24f437fc5e2a8a1b1a219c61b81dbc5a5d9f7c86e56b08b4c","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08