{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--django-expert","name":"django-expert","description":"Use when building Django web applications or REST APIs with Django REST Framework. Invoke when working with settings.py, models.py, manage.py, or any Django project file. Creates Django models with proper indexes, optimizes ORM queries using select_related/prefetch_related, builds DRF serializers and viewsets, and configures JWT authentication. Trigger terms: Django, DRF, Django REST Framework, Django ORM, Django model, serializer, viewset, Python web.","category":"Development","tags":["django","expert","when","building","web","applications","rest","apis","framework.","invoke","working","settings.py","models.py","manage.py","any","project","file.","creates"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/django-expert","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/django-expert","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":7,"bytes":28883,"sha256":"f4fd19b89f762e3845a32f8b37f57bc6973902d50fa55c0a279c5c591e6ccb56","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/django-expert/SKILL.md","bytes":6023,"sha256":"f4fd19b89f762e3845a32f8b37f57bc6973902d50fa55c0a279c5c591e6ccb56","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/django-expert/SKILL.md"},{"path":"references/authentication.md","sourcePath":"skills/django-expert/references/authentication.md","bytes":3962,"sha256":"1c8cb67744898fadca804fb262e25bf0fc3ee4e094ff920b00ae0be9ee5925a8","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/django-expert/references/authentication.md"},