{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--verify-agent-action","name":"verify-agent-action","description":"Review a proposed AI-agent action or human-approval packet before execution. Use when an agent wants to run a consequential tool, command, deployment, message, purchase, credential operation, or data mutation; when checking whether approval still matches the exact action; or when auditing action evidence for forged results, parameter swaps, replay, correlated reviewers, missing evidence, expiry, or stale monitoring. Produce an evidence-based review only—never execute or authorize the action.","category":"Cloud & DevOps","tags":["verify","agent","action","review","proposed","ai","human","approval","packet","before","execution.","when","wants","run","consequential","tool","command","deployment"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/verify-agent-action","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/verify-agent-action","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":9277,"sha256":"13138bebda37fea1fdc235db035a3b43b12545311c20962fe28188b2b8514bb2","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/verify-agent-action/SKILL.md","bytes":8218,"sha256":"13138bebda37fea1fdc235db035a3b43b12545311c20962fe28188b2b8514bb2","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/verify-agent-action/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/LICENSE"}],"archiveSha256":"ee03c1ac7b3e1ef7