{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--bulk-rnaseq","name":"bulk-rnaseq","description":"Prepares bulk RNA-seq FASTQ, Salmon, STAR or featureCounts output for gene-level differential expression. Covers nf-core/rnaseq and standalone quantification, biological replication, strandedness, reference provenance, validated count assembly and a PyDESeq2 handoff. Use for FASTQ-to-counts analysis, nf-core/rnaseq configuration, STAR/Salmon quantification, or building a counts matrix for DESeq2. For single-cell data use scanpy; for statistical fitting alone use pydeseq2.","category":"Development","tags":["bulk","rnaseq","prepares","rna","seq","fastq","salmon","star","featurecounts","output","gene","level","differential","expression.","covers","nf","core","standalone"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/bulk-rnaseq","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/bulk-rnaseq","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":9,"bytes":73337,"sha256":"e945e970268505368e20d9ddc0c135de469e86626d67565ae9047fb05f70cdbf","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/bulk-rnaseq/SKILL.md","bytes":16890,"sha256":"e945e970268505368e20d9ddc0c135de469e86626d67565ae9047fb05f70cdbf","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/bulk-rnaseq/SKILL.md"},{"path":"references/counts-and-handoff.md","sourcePath":"skills/bulk-rnaseq/references/counts-and-handoff.md","bytes":8483,"sha256":"1e2583f8a8906e6e7739f71ebe2486b4c2e0e89718bc7dfdf51875e6bab79d39","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6