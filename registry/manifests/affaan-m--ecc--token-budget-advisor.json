{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--token-budget-advisor","name":"token-budget-advisor","description":"Offer a choice of response depth (25%/50%/75%/100%) with token estimates before answering, then answer at that level. Use when the user asks to control response length or token budget, such as 'token budget', 'short version', 'brief answer', 'respuesta corta vs larga', 'cuántos tokens', 'ahorrar tokens', 'responde al 50%', 'dame la versión corta', 'quiero controlar cuánto usas'. Skip if depth is already set this session or 'token' means an auth/payment token.","category":"Development","tags":["token","budget","advisor","offer","choice","response","depth","25","50","75","100","estimates","before","answering","then","answer","at","level."],"repo":"affaan-m/ECC","owner":"affaan-m","stars":277532,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"b92f181b3b748d1abbc2afd94af6aa7d8c8fca29","path":"skills/token-budget-advisor","sourceUrl":"https://github.com/affaan-m/ECC/tree/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/skills/token-budget-advisor","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T02:02:10Z","fileCount":2,"bytes":6811,"sha256":"7f037a58306a6bd5c5a024491a6c4529cd8373309e413eda517ad2430420e25a","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/token-budget-advisor/SKILL.md","bytes":5740,"sha256":"7f037a58306a6bd5c5a024491a6c4529cd8373309e413eda517ad2430420e25a","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/skills/token-budget-advisor/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1071,"sha256":"326146379f01bb137c0a5d3c54770c1aa31076705c8b88a7f6b26a460f6221b2","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/LICENSE"}],"archiveSha256":"c515748cfebc203bc3d0739de6193690fda07ac59aa8e94455b3ad124fb8e2f4"}