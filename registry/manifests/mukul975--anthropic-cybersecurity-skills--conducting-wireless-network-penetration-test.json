{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--conducting-wireless-network-penetration-test","name":"conducting-wireless-network-penetration-test","description":"Conducts authorized wireless network penetration tests to assess the security of WiFi infrastructure by testing for weak encryption protocols, captive portal bypasses, evil twin attacks, WPA2/WPA3 handshake capture, rogue access point detection, and client-side attacks. The tester evaluates wireless authentication, network segmentation, and the effectiveness of wireless intrusion detection systems. Activates for requests involving wireless pentest, WiFi security assessment, WPA2/WPA3 testing, or rogue access point detection.","category":"Security","tags":["conducting","wireless","network","penetration","test","conducts","authorized","tests","assess","security","wifi","infrastructure","by","testing","weak","encryption","protocols","captive"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/conducting-wireless-network-penetration-test/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/conducting-wireless-network-penetration-test","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/conducting-wireless-network-penetration-test","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":32178,"sha256":"513cb626e6ea37735afe62223e2e34953ed327de70a6b379538585c233e07e79","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/conducting-wireless-network-penetration-test/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/conducting-wireless-network