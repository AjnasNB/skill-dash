{"schemaVersion":1,"skill":{"id":"coreyhaines31--marketingskills--cold-email","name":"cold-email","description":"Write B2B cold emails and follow-up sequences that get replies. Use when the user wants to write cold outreach emails, prospecting emails, cold email campaigns, sales development emails, or SDR emails. Also use when the user mentions \"cold outreach,\" \"prospecting email,\" \"outbound email,\" \"email to leads,\" \"reach out to prospects,\" \"sales email,\" \"follow-up email sequence,\" \"nobody's replying to my emails,\" or \"how do I write a cold email.\" Covers subject lines, opening lines, body copy, CTAs, personalization, and multi-touch follow-up sequences. For warm/lifecycle email sequences, see emails. For sales collateral beyond emails, see sales-enablement.","category":"Product & business","tags":["cold","email","write","b2b","emails","follow","up","sequences","get","replies.","when","user","wants","outreach","prospecting","campaigns","sales","development"],"repo":"coreyhaines31/marketingskills","owner":"coreyhaines31","stars":51366,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"5b2c0007766c6a1cf1d53fd8fc73e979e0821022","path":"skills/cold-email","sourceUrl":"https://github.com/coreyhaines31/marketingskills/tree/5b2c0007766c6a1cf1d53fd8fc73e979e0821022/skills/cold-email","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-05T04:48:02Z","fileCount":8,"bytes":37991,"sha256":"b7f8d793169a5111c857e5720c6b80028686cc95d5a0d0d6570957c2710aff9e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/cold-email/SKILL.md","bytes":7350,"sha256":"b7f8d793169a5111c857e5720c6b80028686cc95d5a0d0d6570957c2710aff9e","mode":420,"url":"https://raw.githubusercontent.com/coreyhaines31/marketingskills/5b2c0007766c6a1cf1d53fd8fc73e979e0821022/skills/cold-email/SKILL.md"},{"path":"evals/evals.json","sourcePath":"skills/cold-email/evals/evals.json","bytes":7025,"sha256":"e760f7766434923508d6491be56be68e3d19e2