{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--detecting-stuxnet-style-attacks","name":"detecting-stuxnet-style-attacks","description":"Detects sophisticated cyber-physical attacks that follow the Stuxnet pattern of modifying PLC logic while spoofing sensor readings to hide the manipulation, using PLC logic integrity monitoring (Claroty xDome, Nozomi Guardian) and physics-based process anomaly detection. Use when hunting for IT-to-OT lateral movement or discrepancies between PLC program state and physical process behavior in ICS/SCADA environments.","category":"Data & research","tags":["detecting","stuxnet","style","attacks","detects","sophisticated","cyber","physical","follow","pattern","modifying","plc","logic","while","spoofing","sensor","readings","hide"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/detecting-stuxnet-style-attacks/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/detecting-stuxnet-style-attacks","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-stuxnet-style-attacks","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":39305,"sha256":"6bac620942e775e43162315148bd8fa325ff04b1d91fc96432fe86a16892c80c","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/detecting-stuxnet-style-attacks/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-stuxnet-style-attacks/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/detecting-stuxnet-style-attacks/SKILL.md","bytes":19555,"sha256":"6bac620942e775e43162315148bd8fa325ff04b1d91fc96432fe86a16892c80c","mode":4