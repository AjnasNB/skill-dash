{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--mini-context-graph","name":"mini-context-graph","description":"A persistent, compounding knowledge base combining Karpathy's LLM Wiki pattern with a structured knowledge graph. Ingest documents once — the LLM writes wiki pages, extracts entities/relations into the graph, and stores raw content for evidence retrieval. Knowledge accumulates and cross-references; it is never re-derived from scratch.","category":"AI & agents","tags":["mini","context","graph","persistent","compounding","knowledge","base","combining","karpathy","llm","wiki","pattern","structured","graph.","ingest","documents","once","writes"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/mini-context-graph","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/mini-context-graph","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":16,"bytes":76677,"sha256":"53faa986896b13ef99f03681e7b3a7a5a8ac7b93120387922459527450022aaa","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/mini-context-graph/SKILL.md","bytes":8168,"sha256":"53faa986896b13ef99f03681e7b3a7a5a8ac7b93120387922459527450022aaa","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/mini-context-graph/SKILL.md"},{"path":"references/ingestion.md","sourcePath":"skills/mini-context-graph/references/ingestion.md","bytes":5161,"sha256":"baa6dda9e7aeedec295dbb48caa755bf2c5a8e5efe9956c49af3b0a756a5294b","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/mini-context-graph/references/ingestion.md"},{"path":"references/lint.md","sourcePath":"skills/mini-context-graph/references/lint.md","bytes":4235,