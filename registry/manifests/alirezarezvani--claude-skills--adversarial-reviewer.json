{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--adversarial-reviewer","name":"adversarial-reviewer","description":"Adversarial code review that breaks the self-review monoculture. Use when you want a genuinely critical review of recent changes, before merging a PR, or when you suspect Claude is being too agreeable about code quality. Forces perspective shifts through hostile reviewer personas that catch blind spots the author's mental model shares with the reviewer.","category":"Development","tags":["adversarial","reviewer","code","review","breaks","self","monoculture.","when","you","genuinely","critical","recent","changes","before","merging","pr","suspect","claude"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":28045,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering-team/skills/adversarial-reviewer","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/adversarial-reviewer","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":2,"bytes":12972,"sha256":"d69e917a7c84405a18b40bd6e41d5fae9aba966db903171028f86bb5c25f6f94","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering-team/skills/adversarial-reviewer/SKILL.md","bytes":11900,"sha256":"d69e917a7c84405a18b40bd6e41d5fae9aba966db903171028f86bb5c25f6f94","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/adversarial-reviewer/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1072,"sha256":"a20126646f93d32a8989c3cf4772d59194f405034f7babe7daebeac22b8ab151","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/LICENSE"}],"archiveSha256":"22c9a1bc0a599b8031c605cb4c0b5d1206670acf60f