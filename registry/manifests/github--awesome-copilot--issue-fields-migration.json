{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--issue-fields-migration","name":"issue-fields-migration","description":"Bulk-migrate metadata to GitHub issue fields from two sources: repo labels (e.g. priority labels to a Priority field) and Project V2 fields. Use when users say \"migrate my labels to issue fields\", \"migrate project fields to issue fields\", \"convert labels to issue fields\", \"copy project field values to issue fields\", or ask about adopting issue fields. Issue fields are org-level typed metadata (single select, text, number, date) that replace label-based workarounds with structured, searchable, cross-repo fields.","category":"Development","tags":["issue","fields","migration","bulk","migrate","metadata","github","from","two","sources","repo","labels","e.g.","priority","field","project","v2","fields."],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/issue-fields-migration","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/issue-fields-migration","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":5,"bytes":34308,"sha256":"a1538bbbb18f528fe3655534984a3be110c3411b4c10786507365982d8f5d950","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/issue-fields-migration/SKILL.md","bytes":24309,"sha256":"a1538bbbb18f528fe3655534984a3be110c3411b4c10786507365982d8f5d950","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/issue-fields-migration/SKILL.md"},{"path":"references/issue-fields-api.md","sourcePath":"skills/issue-fields-migration/references/issue-fields-api.md","bytes":3333,"sha256":"8180ec9e51e65ac054b539f35648feeb1c9dbdfd6e2a312e1a3e16476a7dc5f5","mode":420,"url":"https://raw.githubusercontent.com/github/a