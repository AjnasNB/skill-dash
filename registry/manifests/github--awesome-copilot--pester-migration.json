{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--pester-migration","name":"pester-migration","description":"Pester migration skill for upgrading PowerShell Pester test suites across major versions — v3→v4, v4→v5, and v5→v6. Covers the Discovery/Run two-phase model, moving setup into BeforeAll, $PSScriptRoot vs $MyInvocation, mock changes (Assert-MockCalled → Should -Invoke, removed fall-through), Invoke-Pester parameters → PesterConfiguration, data-driven -ForEach/-TestCases, and the v6 breaking changes. Use when the user asks to upgrade, migrate, or modernize Pester tests, fix *.Tests.ps1 files that broke after bumping the Pester version, or convert legacy Should / Invoke-Pester syntax.","category":"Development","tags":["pester","migration","skill","upgrading","powershell","test","suites","across","major","versions","v3","v4","v5","v6.","covers","discovery","run","two"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/pester-migration","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/pester-migration","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":5,"bytes":35005,"sha256":"eeb7c170eb8e547b951725e2a4202ac7bdfacca411f3e369f4c2ef7dd44d1c8c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/pester-migration/SKILL.md","bytes":8319,"sha256":"eeb7c170eb8e547b951725e2a4202ac7bdfacca411f3e369f4c2ef7dd44d1c8c","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/pester-migration/SKILL.md"},{"path":"references/v3-to-v4.md","sourcePath":"skills/pester-migration/references/v3-to-v4.md","bytes":3766,"sha256":"ca910a5133e62469bfe659227e32fe82b5e3b4df56ab485883bc98526242073e","mode":420,"url":"https://raw.githubusercontent.com/github/