{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--server-side-conversion-tracking","name":"server-side-conversion-tracking","description":"Set up server-side conversion tracking so purchases are reported accurately to Facebook, TikTok, Google and Bing despite iOS restrictions, ad blockers and cookie loss. Use when conversions are under-reported, when platform-reported purchases do not match real orders, when asked about Conversions API / Events API / offline conversions / CAPI, click id passthrough (fbclid, ttclid, gclid, msclkid), or when ad optimization has degraded after tracking changes.","category":"Marketing","tags":["server","side","conversion","tracking","set","up","so","purchases","are","reported","accurately","facebook","tiktok","google","bing","despite","ios","restrictions"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/server-side-conversion-tracking","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/server-side-conversion-tracking","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":9229,"sha256":"2b882d2e6ac0f5414d09e2cb7b173fbecd2e1213c55be6c5cf02663802423830","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/server-side-conversion-tracking/SKILL.md","bytes":8170,"sha256":"2b882d2e6ac0f5414d09e2cb7b173fbecd2e1213c55be6c5cf02663802423830","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/server-side-conversion-tracking/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/LICENSE"}],"archi