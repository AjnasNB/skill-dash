{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--datanalysis-credit-risk","name":"datanalysis-credit-risk","description":"Credit risk data cleaning and variable screening pipeline for pre-loan modeling. Use when working with raw credit data that needs quality assessment, missing value analysis, or variable selection before modeling. it covers data loading and formatting, abnormal period filtering, missing rate calculation, high-missing variable removal,low-IV variable filtering, high-PSI variable removal, Null Importance denoising, high-correlation variable removal, and cleaning report generation. Applicable scenarios arecredit risk data cleaning, variable screening, pre-loan modeling preprocessing.","category":"Development","tags":["datanalysis","credit","risk","data","cleaning","variable","screening","pipeline","pre","loan","modeling.","when","working","raw","needs","quality","assessment","missing"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/datanalysis-credit-risk","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/datanalysis-credit-risk","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":5,"bytes":87663,"sha256":"c54807b18fa6118cb732b6975937ddf696dca295711e34ada9a9515fc2112e9e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/datanalysis-credit-risk/SKILL.md","bytes":6301,"sha256":"c54807b18fa6118cb732b6975937ddf696dca295711e34ada9a9515fc2112e9e","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/datanalysis-credit-risk/SKILL.md"},{"path":"references/analysis.py","sourcePath":"skills/datanalysis-credit-risk/references/analysis.py","bytes":53911,"sha256":"844189556f142189d77539b87bba12abd9612bbf4a88a56d26651b71ae