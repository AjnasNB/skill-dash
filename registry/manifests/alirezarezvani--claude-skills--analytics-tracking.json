{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--analytics-tracking","name":"analytics-tracking","description":"Set up, audit, and debug analytics tracking implementation — GA4, Google Tag Manager, event taxonomy, conversion tracking, and data quality. Use when building a tracking plan from scratch, auditing existing analytics for gaps or errors, debugging missing events, or setting up GTM. Trigger keywords: GA4 setup, Google Tag Manager, GTM, event tracking, analytics implementation, conversion tracking, tracking plan, event taxonomy, custom dimensions, UTM tracking, analytics audit, missing events, tracking broken. NOT for analyzing marketing campaign data — use campaign-analytics for that. NOT for BI dashboards — use product-analytics for in-product event analysis.","category":"Marketing","tags":["analytics","tracking","set","up","audit","debug","implementation","ga4","google","tag","manager","event","taxonomy","conversion","data","quality.","when","building"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/analytics-tracking","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/analytics-tracking","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":6,"bytes":55512,"sha256":"e5ac8c8f9826ff62727966e94231c3737de73bf12781d76ea92adc517d67b339","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/analytics-tracking/SKILL.md","bytes":15274,"sha256":"e5ac8c8f9826ff62727966e94231c3737de73bf12781d76ea92adc517d67b339","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/analytics-tracking/SKILL.md"},{"path":"references/debugging-playbook.md",