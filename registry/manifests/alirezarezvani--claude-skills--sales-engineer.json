{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--sales-engineer","name":"sales-engineer","description":"Analyzes RFP/RFI responses for coverage gaps, builds competitive feature comparison matrices, and plans proof-of-concept (POC) engagements for pre-sales engineering. Use when responding to RFPs, bids, or proposal requests; comparing product features against competitors; planning or scoring a customer POC or sales demo; preparing a technical proposal; or performing win/loss competitor analysis. Handles tasks described as 'RFP response', 'bid response', 'proposal response', 'competitor comparison', 'feature matrix', 'POC planning', 'sales demo prep', or 'pre-sales engineering'.","category":"Product & business","tags":["sales","engineer","analyzes","rfp","rfi","responses","coverage","gaps","builds","competitive","feature","comparison","matrices","plans","proof","concept","poc","engagements"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"business-growth/skills/sales-engineer","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/business-growth/skills/sales-engineer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":13,"bytes":145572,"sha256":"7081cae4383df30c2e4908b522ae5bbf54497bc9e7a3f4472d81c5343ea8f93e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"business-growth/skills/sales-engineer/SKILL.md","bytes":9363,"sha256":"7081cae4383df30c2e4908b522ae5bbf54497bc9e7a3f4472d81c5343ea8f93e","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/business-growth/skills/sales-engineer/SKILL.md"},{"path":"assets/demo_script_template.md","sourcePath":"business-growth/skills/sales-engineer/assets/demo_script_template.md","bytes"