{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--waypoint-bio","name":"waypoint-bio","description":"Supports work with Outpost Bio's open microbiome foundation models - the Waypoint checkpoints (Waypoint-6m, Waypoint-45m, Waypoint-170m), the Atlas pretraining corpus, the Compass eight-task benchmark, or the `waypoint` CLI from the `waypoint-bio` package. Covers embedding microbiome samples, fine-tuning on taxonomic abundance data, benchmarking a checkpoint on Compass, pretraining a GPT-2 model on taxonomic abundance profiles, and converting MetaPhlAn, Kraken2, QIIME 2, or MGnify abundance tables into waypoint format.","category":"AI & agents","tags":["waypoint","bio","supports","work","outpost","open","microbiome","foundation","models","checkpoints","6m","45m","170m","atlas","pretraining","corpus","compass","eight"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/waypoint-bio","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/waypoint-bio","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":9,"bytes":92052,"sha256":"132d1f33d5d99bd6288a4cb432b277fcbc0f8bc4315e333dcecb840e7adc87a5","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/waypoint-bio/SKILL.md","bytes":16666,"sha256":"132d1f33d5d99bd6288a4cb432b277fcbc0f8bc4315e333dcecb840e7adc87a5","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/waypoint-bio/SKILL.md"},{"path":"references/cli-reference.md","sourcePath":"skills/waypoint-bio/references/cli-reference.md","bytes":10874,"sha256":"bb6f673ea630f2254258a7a7ce9130529b98c7307e1e3296fd5e30682f639d18","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scie