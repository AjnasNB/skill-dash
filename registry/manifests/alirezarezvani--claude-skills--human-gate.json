{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--human-gate","name":"human-gate","description":"Runs the human-verification lane of an agent loop, and proves review happened before work is called done. Builds a single-file HTML review page, collects batched feedback as a structured artifact instead of chat prose, and runs a gate that refuses to close while a BLOCKER is open, the reviewer is unnamed, or nobody has reviewed at all. Use when a plan, spec, RFC, report, landing page, migration, or any irreversible action needs human sign-off before shipping, or on requests such as 'get sign-off', 'have someone check this', 'hold until reviewed', 'needs approval first'. NOT for making AI text sound human (use content-humanizer or behuman). NOT for reviewing code diffs (use md-review or code-reviewer).","category":"Video & audio","tags":["human","gate","runs","verification","lane","agent","loop","proves","review","happened","before","work","is","called","done.","builds","single","file"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/human-gate/skills/human-gate","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/human-gate/skills/human-gate","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":10,"bytes":110994,"sha256":"60bccda7c5c3845e69a232c0db5b8bb319307a871347e6ac1356ede7925a78b4","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/human-gate/skills/human-gate/SKILL.md","bytes":5915,"sha256":"60bccda7c5c3845e69a232c0db5b8bb319307a871347e6ac1356ede7925a78b4","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/human-gate/skills/human-gate/SKILL.md"},{"path":"assets/batch.v1.sche