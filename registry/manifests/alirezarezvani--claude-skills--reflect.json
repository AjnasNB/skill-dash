{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--reflect","name":"reflect","description":"Mid-conversation reflection skill that pauses execution and zooms out from detail-mode to honestly reassess direction, assumptions, and bias. Use when the user says 'reflect', 'take a step back', 'step back', 'zoom out', 'are we missing something', 'bigger picture', 'sanity check this', 'are we on track', 'are we overthinking this', 'forest for the trees', or any variation signaling intent to break out of detail-mode and reassess. Also trigger when the conversation has gone deep on implementation details without strategic check-in, or when the user shows signs of being stuck — that's often a signal the framing needs a reset, not more detail work. Intentionally low-intake: runs the 5-dimension analysis immediately when prior context is rich enough; asks one forcing clarifier only when invocation context is too thin to reassess from.","category":"Development","tags":["reflect","mid","conversation","reflection","skill","pauses","execution","zooms","out","from","detail","mode","honestly","reassess","direction","assumptions","bias.","when"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"productivity/reflect/skills/reflect","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":61876,"sha256":"0a5133831e855d958978767cc808585196840c5d488abe684946c521de6a3ed5","historical":false},"files":[{"path":"SKILL.md","sourcePath":"productivity/reflect/skills/reflect/SKILL.md","bytes":9809,"sha256":"0a5133831e855d958978767cc808585196840c5d488abe684946c521de6a3ed5","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect/SKILL.md"},{"path":"references/cognitive_bias_canon.md","sourcePath":"productivity/reflect/skills/reflect/references/cognitive_bias_canon.md","bytes":8450,"sha256":"1d201d611819248b00cf17e3af2732ea74a5fb80add1f7efec09b4edf61be691","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect/references/cognitive_bias_canon.md"},{"path":"references/conversation_reflection_practice.md","sourcePath":"productivity/reflect/skills/reflect/references/conversation_reflection_practice.md","bytes":8758,"sha256":"23bbe922521b61009b10c69dda407bc27cec7fb188f2319fe227872ec039b11f","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect/references/conversation_reflection_practice.md"},{"path":"references/honest_output_discipline.md","sourcePath":"productivity/reflect/skills/reflect/references/honest_output_discipline.md","bytes":9693,"sha256":"3efcbd34ea705d238cf4a9768826c7d6b0c02423fe2a0d4aaed53db71809df0e","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect/references/honest_output_discipline.md"},{"path":"scripts/bias_pattern_detector.py","sourcePath":"productivity/reflect/skills/reflect/scripts/bias_pattern_detector.py","bytes":7280,"sha256":"7584678dcda1476dbb96ca50d104df1b11270a15866198a3e996f6580e17a815","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/reflect/skills/reflect/scripts/bias_pattern_detector.py"},{"path":"scripts/conversation_depth_analyzer.py","sourcePath":"productivity/reflect/skills/reflect/scripts/conversation_depth_analyzer.py","bytes":7165,"sha256":"27591aa5eb299432c8e87bcfc6c21afee4e1c5ee