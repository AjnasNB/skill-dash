{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-anomalous-powershell-execution","name":"hunting-for-anomalous-powershell-execution","description":"Hunt for malicious PowerShell activity by analyzing Script Block Logging (Event 4104), Module Logging (Event 4103), and process creation events. The analyst parses Windows Event Log EVTX files to detect obfuscated commands, AMSI bypass attempts, encoded payloads, credential dumping keywords, and suspicious download cradles. Activates for requests involving PowerShell threat hunting, script block analysis, encoded command detection, or AMSI bypass identification.","category":"Security","tags":["hunting","anomalous","powershell","execution","hunt","malicious","activity","by","analyzing","script","block","logging","event","4104","module","4103","process","creation"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-anomalous-powershell-execution/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-anomalous-powershell-execution","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-anomalous-powershell-execution","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":26830,"sha256":"7f02bb8bac8b528c6a03856a8832e24193cc1dc77f4c87fb9b0c0152f5c96e50","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-anomalous-powershell-execution/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-anomalous-powershell-execution/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-anomalous-pow