{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--terraform-azurerm-set-diff-analyzer","name":"terraform-azurerm-set-diff-analyzer","description":"Analyze Terraform plan JSON output for AzureRM Provider to distinguish between false-positive diffs (order-only changes in Set-type attributes) and actual resource changes. Use when reviewing terraform plan output for Azure resources like Application Gateway, Load Balancer, Firewall, Front Door, NSG, and other resources with Set-type attributes that cause spurious diffs due to internal ordering changes.","category":"Cloud & DevOps","tags":["terraform","azurerm","set","diff","analyzer","analyze","plan","json","output","provider","distinguish","between","false","positive","diffs","order","only","changes"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/terraform-azurerm-set-diff-analyzer","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/terraform-azurerm-set-diff-analyzer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":7,"bytes":49362,"sha256":"b7efae1dd84de6f644daeac4e6f2f6a7f281b5edf68bb864fb79bb36cd3c4195","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/terraform-azurerm-set-diff-analyzer/SKILL.md","bytes":2187,"sha256":"b7efae1dd84de6f644daeac4e6f2f6a7f281b5edf68bb864fb79bb36cd3c4195","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/terraform-azurerm-set-diff-analyzer/SKILL.md"},{"path":"references/azurerm_set_attributes.json","sourcePath":"skills/terraform-azurerm-set-diff-analyzer/references/azurerm_set_attributes.json","bytes":5106,"sha256":"2c0c359943e471ee9f33bf173a6771ab62fd82c546c5e17f4e49f0932da574bd","mode":420,"url":"https://raw.githubusercontent.com/github/