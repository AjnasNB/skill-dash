{"schemaVersion":1,"skill":{"id":"mattpocock--skills--code-review","name":"code-review","description":"Review the changes since a fixed point (commit, branch, tag, or merge-base) along two axes: Standards (does the code follow this repo's documented coding standards?) and Spec (does the code match what the originating issue/spec asked for?). Runs both reviews in parallel sub-agents and reports them side by side. Use when the user wants to review a branch, a PR, work-in-progress changes, or asks to \"review since X\".","category":"AI & agents","tags":["code","review","changes","since","fixed","point","commit","branch","tag","merge","base","along","two","axes","standards","does","follow","repo"],"repo":"mattpocock/skills","owner":"mattpocock","stars":268729,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"c55ee46073ed923f86ce59a5eb3b6d895095d1b7","path":"skills/engineering/code-review","sourceUrl":"https://github.com/mattpocock/skills/tree/c55ee46073ed923f86ce59a5eb3b6d895095d1b7/skills/engineering/code-review","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-18T10:12:29Z","fileCount":3,"bytes":7757,"sha256":"47f4e52c21694def9c7c11cbfbf891ca35eac7a93e395797515be3c8a409ae50","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/engineering/code-review/SKILL.md","bytes":6589,"sha256":"47f4e52c21694def9c7c11cbfbf891ca35eac7a93e395797515be3c8a409ae50","mode":420,"url":"https://raw.githubusercontent.com/mattpocock/skills/c55ee46073ed923f86ce59a5eb3b6d895095d1b7/skills/engineering/code-review/SKILL.md"},{"path":"agents/openai.yaml","sourcePath":"skills/engineering/code-review/agents/openai.yaml","bytes":100,"sha256":"8229ca854e11dc8e6aef2131ee03f31fb1561cf905fab9ccc325180cf3331352","mode":420,"url":"https://raw.githubusercontent.com/mattpocock/skills/c55ee46073ed923f86ce59a5eb3b6d895095d1b7/skills/engineering/code-review/agents/openai.yaml"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1068,"sha256"