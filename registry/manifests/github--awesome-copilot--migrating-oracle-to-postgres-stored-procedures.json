{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--migrating-oracle-to-postgres-stored-procedures","name":"migrating-oracle-to-postgres-stored-procedures","description":"Migrates Oracle PL/SQL stored procedures to PostgreSQL PL/pgSQL. Translates Oracle-specific syntax, preserves method signatures and type-anchored parameters, leverages orafce where appropriate, and applies explicit collation mapping (`COLLATE \"C\"` only when appropriate, locale collations when required). Use when converting Oracle stored procedures or functions to PostgreSQL equivalents during a database migration.","category":"Development","tags":["migrating","oracle","postgres","stored","procedures","migrates","pl","sql","postgresql","pgsql.","translates","specific","syntax","preserves","method","signatures","type","anchored"],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/migrating-oracle-to-postgres-stored-procedures","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/migrating-oracle-to-postgres-stored-procedures","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":2,"bytes":4210,"sha256":"9e4b7233a4ec43e0581d5511ce07a3d6607cdfb8a36b22f884e72c7b7e69f1a5","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/migrating-oracle-to-postgres-stored-procedures/SKILL.md","bytes":3151,"sha256":"9e4b7233a4ec43e0581d5511ce07a3d6607cdfb8a36b22f884e72c7b7e69f1a5","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/migrating-oracle-to-postgres-stored-procedures/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awes