{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-lateral-movement-via-wmi","name":"hunting-for-lateral-movement-via-wmi","description":"Detects WMI-based lateral movement (e.g. wmic process call create, Win32_Process.Create()) by analyzing Windows Event ID 4688 and Sysmon Event ID 1 for WmiPrvSE.exe spawning suspicious child processes like cmd.exe or powershell.exe, plus WMI-Activity/Operational events 5857/5860/5861 for subscription-based persistence. Use when hunting for remote code execution via WMI or investigating lateral movement across Windows hosts.","category":"Development","tags":["hunting","lateral","movement","via","wmi","detects","based","e.g.","wmic","process","call","win32","process.create","by","analyzing","windows","event","id"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-lateral-movement-via-wmi/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-lateral-movement-via-wmi","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-lateral-movement-via-wmi","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":24628,"sha256":"afb57eb7f4aad84a153331747603706288f129ab88ae5b3e5bf56491e0d57531","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-lateral-movement-via-wmi/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-lateral-movement-via-wmi/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-lateral-movement-via-wmi/SKILL.md","bytes":2636,"sha256":"afb57eb7f4aad84a153331747603706288f129ab88ae5b3e5