{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--react-audit-grep-patterns","name":"react-audit-grep-patterns","description":"Provides the complete, verified grep scan command library for auditing React codebases before a React 18.3.1 or React 19 upgrade. Use this skill whenever running a migration audit - for both the react18-auditor and react19-auditor agents. Contains every grep pattern needed to find deprecated APIs, removed APIs, unsafe lifecycle methods, batching vulnerabilities, test file issues, dependency conflicts, and React 19 specific removals. Always use this skill when writing audit scan commands - do not rely on memory for grep syntax, especially for the multi-line async setState patterns which require context flags.","category":"Security","tags":["react","audit","grep","patterns","provides","complete","verified","scan","command","library","auditing","codebases","before","18.3.1","19","upgrade.","skill","whenever"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/react-audit-grep-patterns","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react-audit-grep-patterns","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":6,"bytes":21383,"sha256":"786b14c055e6182ed04e606bae7c7489cf9a4dc83f866f3f2c317d032cdaf023","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/react-audit-grep-patterns/SKILL.md","bytes":1845,"sha256":"786b14c055e6182ed04e606bae7c7489cf9a4dc83f866f3f2c317d032cdaf023","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/react-audit-grep-patterns/SKILL.md"},{"path":"references/dep-scans.md","sourcePath":"skills/react-audit-grep-patterns/references/dep-scans.md","bytes":2735,"sha256":"0123eda642e78e25c2