{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--churn-prevention","name":"churn-prevention","description":"Reduce voluntary and involuntary churn through cancel flow design, save offers, exit surveys, and dunning sequences. Use when designing or optimizing a cancel flow, building save offers, setting up dunning emails, or reducing failed-payment churn. Trigger keywords: cancel flow, churn reduction, save offers, dunning, exit survey, payment recovery, win-back, involuntary churn, failed payments, cancel page. NOT for customer health scoring or expansion revenue — use customer-success-manager for that.","category":"Design","tags":["churn","prevention","reduce","voluntary","involuntary","through","cancel","flow","design","save","offers","exit","surveys","dunning","sequences.","when","designing","optimizing"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/churn-prevention","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/churn-prevention","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":37310,"sha256":"92c0132bdc156c0cd856d278e0c06fca162f0e474473c5f6c699bab50047b611","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/churn-prevention/SKILL.md","bytes":11104,"sha256":"92c0132bdc156c0cd856d278e0c06fca162f0e474473c5f6c699bab50047b611","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/churn-prevention/SKILL.md"},{"path":"references/cancel-flow-playbook.md","sourcePath":"marketing-skill/skills/churn-prevention/references/cancel-flow-playbook.md","bytes":8573,"sha256":"72190b72bca56d2205eb77616c81d2e35d6e73152367142ef760