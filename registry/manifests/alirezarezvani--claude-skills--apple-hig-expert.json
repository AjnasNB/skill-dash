{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--apple-hig-expert","name":"apple-hig-expert","description":"Audits and designs iOS/macOS/watchOS/visionOS interfaces against the Apple Human Interface Guidelines, including the Liquid Glass design language (announced WWDC25, shipped with iOS 26/macOS Tahoe, Sept 2025). Use when reviewing an Apple-platform mockup or app for HIG compliance, checking contrast or tap-target sizes, or designing native-feeling Apple UI (e.g., 'audit my iOS app against the HIG', 'is this text readable on Liquid Glass?').","category":"Design","tags":["apple","hig","expert","audits","designs","ios","macos","watchos","visionos","interfaces","against","human","interface","guidelines","including","liquid","glass","design"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"product-team/apple-hig-expert/skills/apple-hig-expert","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/product-team/apple-hig-expert/skills/apple-hig-expert","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":7,"bytes":21187,"sha256":"85c5aaa9653aeb9671b7047a9ea64063bdaee81955a918bc627aa38b307eb68c","historical":false},"files":[{"path":"SKILL.md","sourcePath":"product-team/apple-hig-expert/skills/apple-hig-expert/SKILL.md","bytes":5412,"sha256":"85c5aaa9653aeb9671b7047a9ea64063bdaee81955a918bc627aa38b307eb68c","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/product-team/apple-hig-expert/skills/apple-hig-expert/SKILL.md"},{"path":"references/accessibility.md","sourcePath":"product-team/apple-hig-expert/skills/apple-hig-expert/references/accessibility.md","bytes":2743,"sha256":"90a404c83c39f06d2e271f127532069fab01a94a68becc6d9ada3c7e5e89acd8