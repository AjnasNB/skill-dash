{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--linkedin-content","name":"linkedin-content","description":"Use when someone wants to write, edit, or lint a LinkedIn post — a story, how-to, opinion piece, carousel script, video script, or poll — or wants an article, talk, or transcript repurposed into posts. Triggers on \"write a LinkedIn post\", \"is this hook any good\", \"review my post\", \"turn this into LinkedIn posts\", \"carousel\", \"what format should this be\". Lints posts 0-100 on mechanics, hook, integrity, and accessibility; picks the format the material actually supports; and splits long sources into standalone units with a reuse ledger.","category":"Video & audio","tags":["linkedin","content","when","someone","wants","write","edit","lint","post","story","opinion","piece","carousel","script","video","poll","article","talk"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing/linkedin/skills/linkedin-content","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-content","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":77013,"sha256":"7e78b602667dcf4f75499dedb440d380f93765589981073da6291fb432b0f20e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing/linkedin/skills/linkedin-content/SKILL.md","bytes":5515,"sha256":"7e78b602667dcf4f75499dedb440d380f93765589981073da6291fb432b0f20e","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-content/SKILL.md"},{"path":"assets/example_post.md","sourcePath":"marketing/linkedin/skills/linkedin-content/assets/example_post.md","bytes":2321,"sha256":"f15d0bd69f283d85886ba510bd5bc