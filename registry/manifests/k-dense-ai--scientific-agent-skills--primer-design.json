{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--primer-design","name":"primer-design","description":"Designs and audits PCR and RT-qPCR primers with Primer3, explicit thermodynamic conditions, reference-based off-target amplification searches, and traceable sequence coordinates. Use for designing primer pairs, checking existing primers, exon-junction or isoform-specific assays, variant masking, cloning tails, multiplex compatibility, and interpreting Primer-BLAST results. Includes bounded local in-silico PCR and BLAST screening; distinguishes computational candidates from experimentally validated assays.","category":"Design","tags":["primer","design","designs","audits","pcr","rt","qpcr","primers","primer3","explicit","thermodynamic","conditions","reference","based","off","target","amplification","searches"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/primer-design","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/primer-design","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":16,"bytes":127106,"sha256":"ea8bed0aa340a5f6538c206bb3d9fe503da6759e68a944a2bce564fa115d25e4","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/primer-design/SKILL.md","bytes":16361,"sha256":"ea8bed0aa340a5f6538c206bb3d9fe503da6759e68a944a2bce564fa115d25e4","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/primer-design/SKILL.md"},{"path":"assets/assay-report-template.md","sourcePath":"skills/primer-design/assets/assay-report-template.md","bytes":2440,"sha256":"62f3a9a292b7c176425a4a4c4ee10b45acd7bc1217bea33d6fd492f0cbd7bf1b","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-A