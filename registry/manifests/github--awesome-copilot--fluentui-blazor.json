{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--fluentui-blazor","name":"fluentui-blazor","description":"Guide for using the Microsoft Fluent UI Blazor component library (Microsoft.FluentUI.AspNetCore.Components NuGet package) in Blazor applications. Use this when the user is building a Blazor app with Fluent UI components, setting up the library, using FluentUI components like FluentButton, FluentDataGrid, FluentDialog, FluentToast, FluentNavMenu, FluentTextField, FluentSelect, FluentAutocomplete, FluentDesignTheme, or any component prefixed with \"Fluent\". Also use when troubleshooting missing providers, JS interop issues, or theming.","category":"Design","tags":["fluentui","blazor","guide","microsoft","fluent","ui","component","library","microsoft.fluentui.aspnetcore.components","nuget","package","applications.","when","user","is","building","app","components"],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/fluentui-blazor","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/fluentui-blazor","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":6,"bytes":26761,"sha256":"d23fbc5dfb9a1580f930652bdfbf8c891edbaaa3bf162fb4904de9cba74f01b0","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/fluentui-blazor/SKILL.md","bytes":7513,"sha256":"d23fbc5dfb9a1580f930652bdfbf8c891edbaaa3bf162fb4904de9cba74f01b0","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/fluentui-blazor/SKILL.md"},{"path":"references/DATAGRID.md","sourcePath":"skills/fluentui-blazor/references/DATAGRID.md","bytes":4692,"sha256":"aa1866dd3cef4e97fec2a01730098f3cfeb8c3b36b2fd6376fa1bb897088b94c","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-co