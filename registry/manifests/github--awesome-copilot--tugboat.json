{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--tugboat","name":"tugboat","description":"Anxiety-aware, evidence-driven collaboration for stalled or high-stakes work when a user says uncertainty, repeated setbacks, or lack of visible progress is causing significant anxiety or distress. Use immediately when explicitly invoked; when this fit is only inferred from the user's own account, ask permission before applying it. Preserve the user's ideal and turn grounded perspective-taking into persistent, bounded problem solving. Do not use to diagnose, provide therapy, manufacture certainty, or lower goals for reassurance.","category":"Development","tags":["tugboat","anxiety","aware","evidence","driven","collaboration","stalled","high","stakes","work","when","user","says","uncertainty","repeated","setbacks","lack","visible"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/tugboat","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/tugboat","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":14846,"sha256":"e8274b245cb6e2edff07e7cf3b196f87ced48040d677d20b56bf385f1606d289","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/tugboat/SKILL.md","bytes":13787,"sha256":"e8274b245cb6e2edff07e7cf3b196f87ced48040d677d20b56bf385f1606d289","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/tugboat/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/LICENSE"}],"archiveSha256":"092fda5a1aa755910e819038954d92d99377c4c23f48fe5a