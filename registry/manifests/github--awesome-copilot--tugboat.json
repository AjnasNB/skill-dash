{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--tugboat","name":"tugboat","description":"Anxiety-aware, evidence-driven collaboration for stalled or high-stakes work when a user says uncertainty, repeated setbacks, or lack of visible progress is causing significant anxiety or distress. Use immediately when explicitly invoked; when this fit is only inferred from the user's own account, ask permission before applying it. Preserve the user's ideal and turn grounded perspective-taking into persistent, bounded problem solving. Do not use to diagnose, provide therapy, manufacture certainty, or lower goals for reassurance.","category":"Development","tags":["tugboat","anxiety","aware","evidence","driven","collaboration","stalled","high","stakes","work","when","user","says","uncertainty","repeated","setbacks","lack","visible"],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/tugboat","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/tugboat","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":2,"bytes":14846,"sha256":"e8274b245cb6e2edff07e7cf3b196f87ced48040d677d20b56bf385f1606d289","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/tugboat/SKILL.md","bytes":13787,"sha256":"e8274b245cb6e2edff07e7cf3b196f87ced48040d677d20b56bf385f1606d289","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/tugboat/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/LICENSE"}],"archiveSha256":"469aa4d8c664835beb3b86c00b328cd82d672dc852f5e345