{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--book-to-skill","name":"book-to-skill","description":"Converts books, documentation folders, and source collections (PDF, EPUB, DOCX, HTML, Markdown, RST, AsciiDoc, RTF, MOBI/AZW) into structured agent skills — extracting named frameworks, principles, techniques, and anti-patterns into a master SKILL.md plus on-demand chapter files, a glossary, a patterns file, and a decision cheatsheet. Use when the user wants to study a document with an agent, apply an author's frameworks while working, turn internal docs or standards into a reusable knowledge base, or package a compiled book skill as a claude-skills plugin.","category":"Documents","tags":["book","skill","converts","books","documentation","folders","source","collections","pdf","epub","docx","html","markdown","rst","asciidoc","rtf","mobi","azw"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"engineering/book-to-skill/LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/book-to-skill/skills/book-to-skill","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/book-to-skill/skills/book-to-skill","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":29,"bytes":239466,"sha256":"ea8195653ada2575833cc2622f2b88d8717fb60d7e056aabcb183f5da0ab2e5d","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/book-to-skill/skills/book-to-skill/SKILL.md","bytes":11784,"sha256":"ea8195653ada2575833cc2622f2b88d8717fb60d7e056aabcb183f5da0ab2e5d","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/book-to-skill/skills/book-to-skill/SKILL.md"},{"path":"assets/chapter_template.md","sourcePath":"engineering/book-to-skill/skills/book-to-skill/assets/chapter_temp