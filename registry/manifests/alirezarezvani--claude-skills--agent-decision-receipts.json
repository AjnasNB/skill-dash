{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--agent-decision-receipts","name":"agent-decision-receipts","description":"Mint a tamper-evident, post-quantum-signed receipt for a consequential agent action (deploy, delete, pay, grant-access, model decision) so it can be verified later from the certificate alone. Use when an autonomous agent takes a side-effecting action that may need to be proven later, or when satisfying EU AI Act Article 12 record-keeping. Three decisions: whether an action needs a receipt, minting it, verifying it. Signing is delegated to the open-source OpenAgentOntology package. Not after-the-fact log analysis; not a hosted notary; not a legal opinion.","category":"Cloud & DevOps","tags":["agent","decision","receipts","mint","tamper","evident","post","quantum","signed","receipt","consequential","action","deploy","delete","pay","grant","access","model"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"ra-qm-team/skills/agent-decision-receipts","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/agent-decision-receipts","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":4,"bytes":17806,"sha256":"61834517519a01472bf729b9e5c5b5ba9d3f434b306299746cb6378afb47ce70","historical":false},"files":[{"path":"SKILL.md","sourcePath":"ra-qm-team/skills/agent-decision-receipts/SKILL.md","bytes":7939,"sha256":"61834517519a01472bf729b9e5c5b5ba9d3f434b306299746cb6378afb47ce70","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/agent-decision-receipts/SKILL.md"},{"path":"references/receipt-fields.md","sourcePath":"ra-qm-team/skills/agent-decision-receipts/references/receipt-fields.md","bytes":46