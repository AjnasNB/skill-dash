{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--test-collaboration","name":"test-collaboration","description":"Inventory and govern a project's test assets. Connect requirements, business rules, risks, bugs, and cross-boundary contracts to stable TEST-IDs and executable evidence in the repository's existing test registry or TESTS.md. Use for test inventory, test gap analysis, unit/integration/contract/E2E/smoke classification, bug-to-test regression protection, consumer/provider contract testing, test-necessity review, and pre-delivery evidence review.","category":"Product & business","tags":["test","collaboration","inventory","govern","project","assets.","connect","requirements","business","rules","risks","bugs","cross","boundary","contracts","stable","ids","executable"],"repo":"affaan-m/ECC","owner":"affaan-m","stars":277532,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"b92f181b3b748d1abbc2afd94af6aa7d8c8fca29","path":"skills/test-collaboration","sourceUrl":"https://github.com/affaan-m/ECC/tree/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/skills/test-collaboration","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T02:02:10Z","fileCount":3,"bytes":17347,"sha256":"741138330940e2c9d3cc7bec9e671787f24a361ff89be44e09a56abc8e10dcfa","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/test-collaboration/SKILL.md","bytes":11127,"sha256":"741138330940e2c9d3cc7bec9e671787f24a361ff89be44e09a56abc8e10dcfa","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/skills/test-collaboration/SKILL.md"},{"path":"templates/TESTS.example.md","sourcePath":"skills/test-collaboration/templates/TESTS.example.md","bytes":5149,"sha256":"0f8fc6bbffa386f5901055ab86598ae38ef0a9026542a22d0be93b865c5d31a8","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/b92f181b3b748d1abbc2afd94af6aa7d8c8fca29/skills/test-collaboration/templates/TESTS.example.md"},{"path":"UPSTRE