{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--agent-skill-stack","name":"agent-skill-stack","description":"Find, evaluate, and assemble the smallest compatible set of AI Agent Skills for an end-to-end natural-language goal. Use when a user wants Skills for a multi-step workflow, asks which Skills fit a project, needs an installed-Skill audit or conflict check, has low Skill recall, wants indirect helpers such as humanizers or compliance checks, or wants a project-specific Skill Stack with controlled installation. Search local Skills, registries, GitHub, and OpenCLI; compare adoption, verified fit, safety, and overlap. Do not use for locating one known or common Skill; use the generic find-skills workflow.","category":"AI & agents","tags":["agent","skill","stack","find","evaluate","assemble","smallest","compatible","set","ai","skills","end","natural","language","goal.","when","user","wants"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/agent-skill-stack","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/agent-skill-stack","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":12,"bytes":69201,"sha256":"d75ed95177dab5ddb5ca96c87fed93842e7d3221b4b5c9f2d8ebb72d33cde5e2","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/agent-skill-stack/SKILL.md","bytes":10340,"sha256":"d75ed95177dab5ddb5ca96c87fed93842e7d3221b4b5c9f2d8ebb72d33cde5e2","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/agent-skill-stack/SKILL.md"},{"path":"agents/openai.yaml","sourcePath":"skills/agent-skill-stack/agents/openai.yaml","bytes":276,"sha256":"a0318ac51904d253783b55f26aa7ef141fa53c3303ccafe5987522390055a3e7","mode":420,"url":"https://raw.githubus