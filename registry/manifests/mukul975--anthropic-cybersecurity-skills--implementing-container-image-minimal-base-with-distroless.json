{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--implementing-container-image-minimal-base-with-distroless","name":"implementing-container-image-minimal-base-with-distroless","description":"Reduces container attack surface by building application images on Google distroless base images that ship only the application runtime - no shell, package manager, or OS utilities - using multi-stage build patterns plus debugging and scanning techniques adapted to distroless. Use when hardening container images, cutting attack surface in a container architecture, or answering an assessment finding about bloated base images. Keywords: distroless, multi-stage build, no shell, nonroot tag, debug image, scratch, attack surface. Do not use for scanning an image for known CVEs - use scanning-docker-images-with-trivy.","category":"Cloud & DevOps","tags":["implementing","container","image","minimal","base","distroless","reduces","attack","surface","by","building","application","images","google","ship","only","runtime","no"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/implementing-container-image-minimal-base-with-distroless/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/implementing-container-image-minimal-base-with-distroless","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/implementing-container-image-minimal-base-with-distroless","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":34591,"sha256":"2346ae9ca48aabf2fbbd57eb552ccbe7ef882934377bf23faf35fd3202c28d0b","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/implementing-container-image-minimal-base-with-distroless/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,