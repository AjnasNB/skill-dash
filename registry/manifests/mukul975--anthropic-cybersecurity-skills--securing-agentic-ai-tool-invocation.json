{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--securing-agentic-ai-tool-invocation","name":"securing-agentic-ai-tool-invocation","description":"Implements defense-in-depth controls at an AI agent's tool-invocation boundary using tool allowlisting, least-privilege identity binding, NeMo Guardrails policy enforcement, human-in-the-loop approval, and audit logging. Use when hardening an agent that calls tools with real side effects (email, payments, file writes, code execution), mapping OWASP Agentic AI Top 10 controls, or bounding prompt-injection blast radius.","category":"Security","tags":["securing","agentic","ai","tool","invocation","implements","defense","depth","controls","at","agent","boundary","allowlisting","least","privilege","identity","binding","nemo"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/securing-agentic-ai-tool-invocation/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/securing-agentic-ai-tool-invocation","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/securing-agentic-ai-tool-invocation","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":5,"bytes":32476,"sha256":"9bc5fbdd43961c9d02212b11d11ac9f3029bdd51d2bcbe40b41b174169a3278d","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/securing-agentic-ai-tool-invocation/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/securing-agentic-ai-tool-invocation/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/securing-agentic-ai-tool-invocation/SKILL.md","bytes":11854,"sha256":"9bc5fbdd43961c9d02212b11d11ac9f3029bdd51d2bcbe4