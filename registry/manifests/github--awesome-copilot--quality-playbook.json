{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--quality-playbook","name":"quality-playbook","description":"Run a complete quality engineering audit on any codebase. Derives behavioral requirements from the code, generates spec-traced functional tests, runs a three-pass code review with regression tests, executes a multi-model spec audit (Council of Three), and produces a consolidated bug report with TDD-verified patches. Finds the 35% of real defects that structural code review alone cannot catch. Works with any language. Trigger on 'quality playbook', 'spec audit', 'Council of Three', 'fitness-to-purpose', or 'coverage theater'.","category":"Development","tags":["quality","playbook","run","complete","engineering","audit","any","codebase.","derives","behavioral","requirements","from","code","generates","spec","traced","functional","tests"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"Apache-2.0","licensePath":"skills/quality-playbook/LICENSE.txt","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/quality-playbook","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/quality-playbook","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":31,"bytes":788171,"sha256":"2b6f0e36e5427d81d94b2ac35ec6e657c57fb9434ba0d9a011b0e462b04ae729","historical":false},"files":[{"path":"LICENSE.txt","sourcePath":"skills/quality-playbook/LICENSE.txt","bytes":10766,"sha256":"dbc2c2d54f16293c98da2af3e37c182c39d6c06780f9a9e016a67851ba4be5f7","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/quality-playbook/LICENSE.txt"},{"path":"SKILL.md","sourcePath":"skills/quality-playbook/SKILL.md","bytes":294426,"sha256":"2b6f0e36e5427d81d94b2ac35ec6e657c57fb9434ba0d9a011b0e462b04ae729","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-co