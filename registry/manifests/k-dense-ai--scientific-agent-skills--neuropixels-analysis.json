{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--neuropixels-analysis","name":"neuropixels-analysis","description":"Analyzes Neuropixels extracellular recordings end-to-end with SpikeInterface. Covers loading SpikeGLX/Open Ephys/NWB data, preprocessing, drift/motion correction, Kilosort4 (and CPU) spike sorting, quality metrics, and unit curation (threshold-based, model-based UnitRefine, and AI-assisted visual review). Use when working with Neuropixels 1.0/2.0 recordings, spike sorting, or extracellular electrophysiology analysis.","category":"Development","tags":["neuropixels","analysis","analyzes","extracellular","recordings","end","spikeinterface.","covers","loading","spikeglx","open","ephys","nwb","data","preprocessing","drift","motion","correction"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/neuropixels-analysis","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/neuropixels-analysis","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":20,"bytes":144563,"sha256":"65985e85e9ac2206c92291446f543505b2b568bf1d622448e162ae6255e154dc","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/neuropixels-analysis/SKILL.md","bytes":20153,"sha256":"65985e85e9ac2206c92291446f543505b2b568bf1d622448e162ae6255e154dc","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/neuropixels-analysis/SKILL.md"},{"path":"assets/analysis_template.py","sourcePath":"skills/neuropixels-analysis/assets/analysis_template.py","bytes":9547,"sha256":"ca24aeed6706f0b6952163f01fab112ca7892f3971a65e8bbed831f917c64e7d","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1