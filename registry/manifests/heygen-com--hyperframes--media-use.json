{"schemaVersion":1,"skill":{"id":"heygen-com--hyperframes--media-use","name":"media-use","description":"Agent Media OS, the single skill for every media need in a HyperFrames project. Resolve BGM, SFX, image, icon, brand logo, voice, color grade, or LUT into a frozen local file or paste-ready block + ledger record (one verb, `resolve`); generate via TTS / music / image models when the catalog misses; produce voiceover, transcription, captions, and background removal through one shared audio engine; operate on media (cut / reframe / transform); and reuse assets across projects. Also use for vague feedback that real footage looks dark, flat, boring, should feel retro/camcorder/print/ASCII, needs privacy, or needs a media reveal.","category":"Video & audio","tags":["media","agent","os","single","skill","every","hyperframes","project.","resolve","bgm","sfx","image","icon","brand","logo","voice","color","grade"],"repo":"heygen-com/hyperframes","owner":"heygen-com","stars":52761,"official":true,"featured":false,"license":"Apache-2.0","licensePath":"LICENSE","revision":"58c873d8161d6a2357eacf89a540bfecc359349b","path":"skills/media-use","sourceUrl":"https://github.com/heygen-com/hyperframes/tree/58c873d8161d6a2357eacf89a540bfecc359349b/skills/media-use","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T06:32:31Z","fileCount":99,"bytes":1751046,"sha256":"17806a2257b84e018805edd1357bdc437cc890578e420cb8d14d4e8a034da064","historical":false},"files":[{"path":".gitignore","sourcePath":"skills/media-use/.gitignore","bytes":17,"sha256":"a299ec0fcdb6bc6670cf9fb22eefe3fcc37730e2e554b7f54e25de88be1ede02","mode":420,"url":"https://raw.githubusercontent.com/heygen-com/hyperframes/58c873d8161d6a2357eacf89a540bfecc359349b/skills/media-use/.gitignore"},{"path":"SKILL.md","sourcePath":"skills/media-use/SKILL.md","bytes":7944,"sha256":"17806a2257b84e018805edd1357bdc437cc890578e420cb8d14d4e8a034da064","mode":420,"url":"https://raw.githubusercontent.com/heygen-com/hyperframes/58