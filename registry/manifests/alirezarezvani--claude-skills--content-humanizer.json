{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--content-humanizer","name":"content-humanizer","description":"Makes AI-generated content sound genuinely human — not just cleaned up, but alive. Use when content feels robotic, uses too many AI clichés, lacks personality, or reads like it was written by committee. Triggers: 'this sounds like AI', 'make it more human', 'add personality', 'it feels generic', 'sounds robotic', 'fix AI writing', 'inject our voice'. NOT for initial content creation (use content-production). NOT for SEO optimization (use content-production Mode 3).","category":"Video & audio","tags":["content","humanizer","makes","ai","generated","sound","genuinely","human","not","just","cleaned","up","but","alive.","when","feels","robotic","uses"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/content-humanizer","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/content-humanizer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":50259,"sha256":"394c104c21992e984d1d14e0de40f0b244a59407e7d16232d6ea8c55ee892cdb","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/content-humanizer/SKILL.md","bytes":14828,"sha256":"394c104c21992e984d1d14e0de40f0b244a59407e7d16232d6ea8c55ee892cdb","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/content-humanizer/SKILL.md"},{"path":"references/ai-tells-checklist.md","sourcePath":"marketing-skill/skills/content-humanizer/references/ai-tells-checklist.md","bytes":7509,"sha256":"2acefc0276c8a27f9ad29dc98376786048189f0ce269e7b380cbd594c29aa35e","mode":420,"url":"https://raw.githubu