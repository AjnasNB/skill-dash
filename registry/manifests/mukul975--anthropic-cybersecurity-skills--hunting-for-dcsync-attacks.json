{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-for-dcsync-attacks","name":"hunting-for-dcsync-attacks","description":"Detect DCSync attacks (MITRE ATT&CK T1003.006) by analyzing Windows Event ID 4662 (AccessMask 0x100) for DS-Replication-Get-Changes and DS-Replication-Get-Changes-All requests issued by non-domain-controller accounts. Use when hunting for DCSync credential theft, after detecting Mimikatz-class tooling, or during incident response and purple-team exercises involving Active Directory replication abuse.","category":"Development","tags":["hunting","dcsync","attacks","detect","mitre","att","ck","t1003.006","by","analyzing","windows","event","id","4662","accessmask","0x100","ds","replication"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-for-dcsync-attacks/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-for-dcsync-attacks","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-dcsync-attacks","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":28246,"sha256":"9ad657788192fa12e540bb8c03be654c7b18fde053272e67bea4c843e81a8442","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-for-dcsync-attacks/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-for-dcsync-attacks/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-for-dcsync-attacks/SKILL.md","bytes":3586,"sha256":"9ad657788192fa12e540bb8c03be654c7b18fde053272e67bea4c843e81a8442","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Ski