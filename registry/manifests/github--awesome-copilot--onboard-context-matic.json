{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--onboard-context-matic","name":"onboard-context-matic","description":"Interactive onboarding tour for the context-matic MCP server. Walks the user through what the server does, shows all available APIs, lets them pick one to explore, explains it in their project language, demonstrates model_search and endpoint_search live, and ends with a menu of things the user can ask the agent to do. USE FOR: first-time setup; \"what can this MCP do?\"; \"show me the available APIs\"; \"onboard me\"; \"how do I use the context-matic server\"; \"give me a tour\". DO NOT USE FOR: actually integrating an API end-to-end (use integrate-context-matic instead).","category":"AI & agents","tags":["onboard","context","matic","interactive","onboarding","tour","mcp","server.","walks","user","through","what","server","does","shows","all","available","apis"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/onboard-context-matic","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/onboard-context-matic","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":14576,"sha256":"db5b6ff9092017ab254334daee1df36ee526b3f1af42d9d8197d6dc6f7a4edb9","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/onboard-context-matic/SKILL.md","bytes":13517,"sha256":"db5b6ff9092017ab254334daee1df36ee526b3f1af42d9d8197d6dc6f7a4edb9","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/onboard-context-matic/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1