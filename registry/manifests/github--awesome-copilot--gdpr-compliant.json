{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--gdpr-compliant","name":"gdpr-compliant","description":"Apply GDPR-compliant engineering practices across your codebase. Use this skill whenever you are designing APIs, writing data models, building authentication flows, implementing logging, handling user data, writing retention/deletion jobs, designing cloud infrastructure, or reviewing pull requests for privacy compliance. Trigger this skill for any task involving personal data, user accounts, cookies, analytics, emails, audit logs, encryption, pseudonymization, anonymization, data exports, breach response, CI/CD pipelines that process real data, or any question framed as \"is this GDPR-compliant?\". Inspired by CNIL developer guidance and GDPR Articles 5, 25, 32, 33, 35.","category":"Cloud & DevOps","tags":["gdpr","compliant","apply","engineering","practices","across","codebase.","skill","whenever","you","are","designing","apis","writing","data","models","building","authentication"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/gdpr-compliant","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/gdpr-compliant","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":4,"bytes":31411,"sha256":"e1f33a817a1d0f7165f4f6652cfeb52632ba124067c3f46c37f867cde730242e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/gdpr-compliant/SKILL.md","bytes":11923,"sha256":"e1f33a817a1d0f7165f4f6652cfeb52632ba124067c3f46c37f867cde730242e","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/gdpr-compliant/SKILL.md"},{"path":"references/Security.md","sourcePath":"skills/gdpr-compliant/references/Security.md","bytes":11886,"sha256":"4fffe37e4c02404328