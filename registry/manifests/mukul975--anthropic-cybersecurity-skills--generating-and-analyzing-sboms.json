{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--generating-and-analyzing-sboms","name":"generating-and-analyzing-sboms","description":"Generate CycloneDX and SPDX SBOMs from container images and filesystems with Syft, correlate them to CVEs with Grype, and sign/attest them with Cosign. Use when you need a machine-readable dependency inventory for supply-chain risk, want to scan images or SBOMs for known vulnerabilities, or are embedding SBOM generation and vulnerability gating into CI/CD.","category":"Security","tags":["generating","analyzing","sboms","generate","cyclonedx","spdx","from","container","images","filesystems","syft","correlate","them","cves","grype","sign","attest","cosign."],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/generating-and-analyzing-sboms/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/generating-and-analyzing-sboms","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/generating-and-analyzing-sboms","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":5,"bytes":28161,"sha256":"de6a43482cb67c970a2096b393b5cf0541b5104cd2bbece2ff51b5a4ea13572d","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/generating-and-analyzing-sboms/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/generating-and-analyzing-sboms/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/generating-and-analyzing-sboms/SKILL.md","bytes":7617,"sha256":"de6a43482cb67c970a2096b393b5cf0541b5104cd2bbece2ff51b5a4ea13572d","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Ski