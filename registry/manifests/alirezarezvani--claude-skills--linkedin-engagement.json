{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--linkedin-engagement","name":"linkedin-engagement","description":"Use when someone wants to grow reach through comments, replies, groups, or outreach on LinkedIn — a commenting roster, a connection request note, a DM or InMail, a networking plan, or a check on whether their outreach volume is safe. Triggers on \"who should I engage with\", \"write a connection request\", \"cold DM\", \"LinkedIn outreach\", \"networking strategy\", \"how many invites can I send\". Builds a weekly comment roster inside a real time budget, assembles one message at a time and refuses templates, and caps volume against LinkedIn's limits. Nothing is ever sent.","category":"Product & business","tags":["linkedin","engagement","when","someone","wants","grow","reach","through","comments","replies","groups","outreach","commenting","roster","connection","request","note","dm"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing/linkedin/skills/linkedin-engagement","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-engagement","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":9,"bytes":55530,"sha256":"6203dedcb7d1f594e5f3d836aa38062caf48c09d31487c814d2cb7c0ad0622d3","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing/linkedin/skills/linkedin-engagement/SKILL.md","bytes":5423,"sha256":"6203dedcb7d1f594e5f3d836aa38062caf48c09d31487c814d2cb7c0ad0622d3","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-engagement/SKILL.md"},{"path":"assets/example_outreach.json","sourcePath":"marketing/linkedin/skills/linkedin-engagement