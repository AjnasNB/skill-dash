{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--intent-driven-development","name":"intent-driven-development","description":"Turn ambiguous or high-impact product and engineering changes into scoped, verifiable acceptance criteria before or alongside implementation. Use when a user asks to clarify a feature, define acceptance criteria, de-risk a security/data/migration/integration change, prepare implementation requirements for another agent, or make a complex request testable. Do not trigger for trivial edits, straightforward fixes, active debugging, code review, or implementation requests whose acceptance conditions are already clear unless the user explicitly invokes this skill.","category":"Security","tags":["intent","driven","development","turn","ambiguous","high","impact","product","engineering","changes","into","scoped","verifiable","acceptance","criteria","before","alongside","implementation."],"repo":"affaan-m/ECC","owner":"affaan-m","stars":266395,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"bf70150eb2df8070024e5bdf08e4aa08959e2735","path":"skills/intent-driven-development","sourceUrl":"https://github.com/affaan-m/ECC/tree/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/intent-driven-development","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-21T18:40:16Z","fileCount":2,"bytes":18270,"sha256":"e34045f7b3bf6a6fbd364f85c7bc81d8208e18bb929ceff80bbc987f78aadea8","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/intent-driven-development/SKILL.md","bytes":17199,"sha256":"e34045f7b3bf6a6fbd364f85c7bc81d8208e18bb929ceff80bbc987f78aadea8","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/intent-driven-development/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1071,"sha256":"326146379f01bb137c0a5d3c54770c1aa31076705c8b88a7f6b26a460f6221b2","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf701