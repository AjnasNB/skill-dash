{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--sandbox-npm-install","name":"sandbox-npm-install","description":"Install npm packages in a Docker sandbox environment. Use this skill whenever you need to install, reinstall, or update node_modules inside a container where the workspace is mounted via virtiofs. Native binaries (esbuild, lightningcss, rollup) crash on virtiofs, so packages must be installed on the local ext4 filesystem and symlinked back.","category":"Cloud & DevOps","tags":["sandbox","npm","install","packages","docker","environment.","skill","whenever","you","reinstall","update","node","modules","inside","container","where","workspace","is"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/sandbox-npm-install","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/sandbox-npm-install","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":10464,"sha256":"efbad94eaadd3b4284dd4fb3e2dfab71e528bcad4dfbfe4dc8c03c34a35439b3","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/sandbox-npm-install/SKILL.md","bytes":3812,"sha256":"efbad94eaadd3b4284dd4fb3e2dfab71e528bcad4dfbfe4dc8c03c34a35439b3","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/sandbox-npm-install/SKILL.md"},{"path":"scripts/install.sh","sourcePath":"skills/sandbox-npm-install/scripts/install.sh","bytes":5593,"sha256":"6bdcd1e673f1508f46c2f031f6277e4ee4fc107296baac4300308790f417aab2","mode":493,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/sandbox-npm-install/scripts/install.sh"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730