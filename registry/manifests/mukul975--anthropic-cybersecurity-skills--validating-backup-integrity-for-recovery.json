{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--validating-backup-integrity-for-recovery","name":"validating-backup-integrity-for-recovery","description":"Validates backup integrity through cryptographic hash verification, automated restore testing, corruption detection, and recoverability checks to confirm backups are reliable for disaster recovery and ransomware response. Use before relying on backups for recovery, when building post-backup validation pipelines, auditing backup infrastructure for compliance, or checking immutable/air-gapped backups for silent corruption or tampering.","category":"Cloud & DevOps","tags":["validating","backup","integrity","recovery","validates","through","cryptographic","hash","verification","automated","restore","testing","corruption","detection","recoverability","checks","confirm","backups"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/validating-backup-integrity-for-recovery/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/validating-backup-integrity-for-recovery","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/validating-backup-integrity-for-recovery","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":33739,"sha256":"81bba3e34a6c091117440392ca3bca25d8c22abafdaa22e59ea71dd021c9b41b","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/validating-backup-integrity-for-recovery/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/validating-backup-integrity-for-recovery/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/validating-backup-integrity