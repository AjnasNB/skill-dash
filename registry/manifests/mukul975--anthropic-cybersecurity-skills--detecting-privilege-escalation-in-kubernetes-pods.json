{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--detecting-privilege-escalation-in-kubernetes-pods","name":"detecting-privilege-escalation-in-kubernetes-pods","description":"Detects and prevents privilege escalation inside Kubernetes pods by combining admission control (OPA policies), runtime monitoring (Falco), and audit log analysis of security contexts, Linux capabilities, and syscall patterns. Use when investigating a pod running as root or privileged, hardening workloads against in-pod escalation, or hunting for containers exceeding their intended scope. Keywords: allowPrivilegeEscalation, runAsRoot, capabilities, securityContext, OPA, Falco, audit log. Do not use for escalation through RBAC and service-account permissions - use auditing-kubernetes-rbac-privilege-escalation.","category":"Security","tags":["detecting","privilege","escalation","kubernetes","pods","detects","prevents","inside","by","combining","admission","control","opa","policies","runtime","monitoring","falco","audit"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/detecting-privilege-escalation-in-kubernetes-pods/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/detecting-privilege-escalation-in-kubernetes-pods","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-privilege-escalation-in-kubernetes-pods","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":34939,"sha256":"fbadde97dd456a82afa3e53e571d83cc0d84c8059d099d6e309349a7c561121b","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/detecting-privilege-escalation-in-kubernetes-pods/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul