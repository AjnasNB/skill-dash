{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--senior-secops","name":"senior-secops","description":"Senior SecOps engineer skill for application security, vulnerability management, compliance verification, and secure development practices. Runs SAST/DAST scans, generates CVE remediation plans, checks dependency vulnerabilities, creates security policies, enforces secure coding patterns, and automates compliance checks against SOC2, PCI-DSS, HIPAA, and GDPR. Use when conducting a security review or audit, responding to a CVE or security incident, hardening infrastructure, implementing authentication or secrets management, running penetration test prep, checking OWASP Top 10 exposure, or enforcing security controls in CI/CD pipelines.","category":"Security","tags":["senior","secops","engineer","skill","application","security","vulnerability","management","compliance","verification","secure","development","practices.","runs","sast","dast","scans","generates"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering-team/skills/senior-secops","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/senior-secops","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":150091,"sha256":"49e933139a7ce3fe02e7ae1e6d59f2fdf947afeabcee125a8e2c4cda7b575bd9","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering-team/skills/senior-secops/SKILL.md","bytes":16062,"sha256":"49e933139a7ce3fe02e7ae1e6d59f2fdf947afeabcee125a8e2c4cda7b575bd9","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/senior-secops/SKILL.md"},{"path":"references/compliance_requirements.md","sourcePath":"e