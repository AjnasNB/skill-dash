{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--architecture-designer","name":"architecture-designer","description":"Use when designing new high-level system architecture, reviewing existing designs, or making architectural decisions. Invoke to create architecture diagrams, write Architecture Decision Records (ADRs), evaluate technology trade-offs, design component interactions, and plan for scalability. Use for system design, architecture review, microservices structuring, ADR authoring, scalability planning, and infrastructure pattern selection — distinct from code-level design patterns or database-only design tasks.","category":"Design","tags":["architecture","designer","when","designing","new","high","level","system","reviewing","existing","designs","making","architectural","decisions.","invoke","diagrams","write","decision"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/architecture-designer","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/architecture-designer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":7,"bytes":21787,"sha256":"5235b031e8fadacf01f39ad9db7b8d5ec9d6f83460ebcef78da95d31c9f36276","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/architecture-designer/SKILL.md","bytes":4750,"sha256":"5235b031e8fadacf01f39ad9db7b8d5ec9d6f83460ebcef78da95d31c9f36276","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/architecture-designer/SKILL.md"},{"path":"references/adr-template.md","sourcePath":"skills/architecture-designer/references/adr-template.md","bytes":2752,"sha256":"cada2aa2f8fa039ba63ab95499cbe653a28110f9f406040a06966552026fea4b","mode":420,"url":"https://raw.githubusercontent.com/Jeffall