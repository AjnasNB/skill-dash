{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--securing-container-registry-with-harbor","name":"securing-container-registry-with-harbor","description":"Configures the security features of the Harbor open-source container registry - integrated Trivy scanning, Cosign and Notary content trust policies, project-level RBAC, immutable tag and retention rules, and OIDC authentication - to enforce provenance and block deployment of vulnerable images. Use when deploying or hardening Harbor, or when compliance requires that only signed and scanned images can be pulled. Keywords: Harbor, project policy, content trust, immutable tag, retention, robot account, OIDC, replication. Do not use for signing images with Cosign outside a registry - use implementing-image-provenance-verification-with-cosign.","category":"Security","tags":["securing","container","registry","harbor","configures","security","features","open","source","integrated","trivy","scanning","cosign","notary","content","trust","policies","project"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/securing-container-registry-with-harbor/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/securing-container-registry-with-harbor","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/securing-container-registry-with-harbor","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":8,"bytes":36774,"sha256":"7a848d19da4f0ad949f8ce14f8b991fa939119b2e9fe93181ff31fef8258ae44","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/securing-container-registry-with-harbor/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Sk