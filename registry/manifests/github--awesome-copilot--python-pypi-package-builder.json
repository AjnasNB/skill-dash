{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--python-pypi-package-builder","name":"python-pypi-package-builder","description":"End-to-end skill for building, testing, linting, versioning, and publishing a production-grade Python library to PyPI. Covers all four build backends (setuptools+setuptools_scm, hatchling, flit, poetry), PEP 440 versioning, semantic versioning, dynamic git-tag versioning, OOP/SOLID design, type hints (PEP 484/526/544/561), Trusted Publishing (OIDC), and the full PyPA packaging flow. Use for: creating Python packages, pip-installable SDKs, CLI tools, framework plugins, pyproject.toml setup, py.typed, setuptools_scm, semver, mypy, pre-commit, GitHub Actions CI/CD, or PyPI publishing.","category":"Design","tags":["python","pypi","package","builder","end","skill","building","testing","linting","versioning","publishing","production","grade","library","pypi.","covers","all","four"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/python-pypi-package-builder","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/python-pypi-package-builder","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":12,"bytes":149573,"sha256":"a936499b350cc292fead873345f54893c2e91c46ce0bae8620bd2f1734376f3e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/python-pypi-package-builder/SKILL.md","bytes":19188,"sha256":"a936499b350cc292fead873345f54893c2e91c46ce0bae8620bd2f1734376f3e","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/python-pypi-package-builder/SKILL.md"},{"path":"references/architecture-patterns.md","sourcePath":"skills/python-pypi-package-builder/references/architecture-patterns.md","bytes":16148,"sha256":"238dc70