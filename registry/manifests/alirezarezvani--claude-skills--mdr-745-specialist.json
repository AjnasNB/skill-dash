{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--mdr-745-specialist","name":"mdr-745-specialist","description":"EU MDR 2017/745 compliance specialist for medical device classification, technical documentation, clinical evidence, and post-market surveillance. Covers Annex VIII classification rules, Annex II/III technical files, Annex XIV clinical evaluation, Art. 86 PSUR schedules, and EUDAMED integration. Use when classifying a medical device under MDR, building or gap-checking a technical file, planning clinical evaluation or PMS/PSUR cadence, or preparing for notified body review (e.g., 'what class is my device under MDR', 'review my PSUR schedule').","category":"Writing","tags":["mdr","745","specialist","eu","2017","compliance","medical","device","classification","technical","documentation","clinical","evidence","post","market","surveillance.","covers","annex"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"ra-qm-team/skills/mdr-745-specialist","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/mdr-745-specialist","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":6,"bytes":58369,"sha256":"054682d1d6cd2eeb0f783845589ba498c3fc8770d4edd23792e2b2cf616aad1d","historical":false},"files":[{"path":"SKILL.md","sourcePath":"ra-qm-team/skills/mdr-745-specialist/SKILL.md","bytes":10406,"sha256":"054682d1d6cd2eeb0f783845589ba498c3fc8770d4edd23792e2b2cf616aad1d","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/mdr-745-specialist/SKILL.md"},{"path":"references/clinical-evidence-requirements.md","sourcePath":"ra-qm-team/skills/mdr-745-specialist/references/clinical-evidence-requirements.md","bytes":9408