{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--optimize-for-gpu","name":"optimize-for-gpu","description":"GPU-accelerates scientific Python on NVIDIA hardware and verifies that the result is correct and faster. Use for CUDA/GPU optimization; CPU-bound NumPy, SciPy, pandas, scikit-learn, NetworkX, scikit-image, vector-search, image-processing, graph, simulation, or file-I/O workloads; CuPy, cuDF, cuML, cuGraph, cuVS, cuCIM, KvikIO, Warp, Newton, Numba-CUDA, or RAFT questions; and profiling, memory-transfer, kernel, or multi-GPU bottlenecks. Also use when large data-parallel Python code is slow and GPU acceleration is a plausible option, even if the user does not name CUDA.","category":"Data & research","tags":["optimize","gpu","accelerates","scientific","python","nvidia","hardware","verifies","result","is","correct","faster.","cuda","optimization","cpu","bound","numpy","scipy"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/optimize-for-gpu","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/optimize-for-gpu","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":17,"bytes":302416,"sha256":"e31bdb10b8ea66e5ec438583755999b66b9afab90f2583e1d500b8457ef28054","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/optimize-for-gpu/SKILL.md","bytes":13786,"sha256":"e31bdb10b8ea66e5ec438583755999b66b9afab90f2583e1d500b8457ef28054","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/optimize-for-gpu/SKILL.md"},{"path":"references/code_transformation_patterns.md","sourcePath":"skills/optimize-for-gpu/references/code_transformation_patterns.md","bytes":10031,"sha256":"55529fbb284e676c9