{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--customer-success-manager","name":"customer-success-manager","description":"Monitors customer health, predicts churn risk, and identifies expansion opportunities using weighted scoring models for SaaS customer success. Use when analyzing customer accounts, reviewing retention metrics, scoring at-risk customers, or when the user mentions churn, customer health scores, upsell opportunities, expansion revenue, retention analysis, or customer analytics. Runs three Python CLI tools to produce deterministic health scores, churn risk tiers, and prioritized expansion recommendations across Enterprise, Mid-Market, and SMB segments.","category":"Development","tags":["customer","success","manager","monitors","health","predicts","churn","risk","identifies","expansion","opportunities","weighted","scoring","models","saas","success.","when","analyzing"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"business-growth/skills/customer-success-manager","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/business-growth/skills/customer-success-manager","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":14,"bytes":130398,"sha256":"ea53629ec26895fc84229d817f91512879be54331122521b180df3a568826546","historical":false},"files":[{"path":"SKILL.md","sourcePath":"business-growth/skills/customer-success-manager/SKILL.md","bytes":9222,"sha256":"ea53629ec26895fc84229d817f91512879be54331122521b180df3a568826546","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/business-growth/skills/customer-success-manager/SKILL.md"},{"path":"assets/executive_business_review_template.md","sourcePath":"business-growth/skills/custo