{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--prompt-engineer-toolkit","name":"prompt-engineer-toolkit","description":"Turns marketing prompts into tested, versioned production assets: A/B prompt evaluation against structured test cases, immutable prompt version history with diffs, ready-to-use marketing prompt templates (ad copy, email campaigns, social posts, landing pages, SEO meta), and an LLM-governance playbook for marketing teams (claim discipline, disclosure rules, human-review gates). Use when a marketing team relies on AI-generated content and needs prompt quality to be measurable and safe — or when the user mentions 'prompt engineering,' 'improve my prompts,' 'prompt templates,' 'prompt versioning,' 'AI content workflow,' or 'AI governance for marketing.'","category":"Marketing","tags":["prompt","engineer","toolkit","turns","marketing","prompts","into","tested","versioned","production","assets","evaluation","against","structured","test","cases","immutable","version"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/prompt-engineer-toolkit","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/prompt-engineer-toolkit","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":40831,"sha256":"619516d20520a7a84b54aaad8f35d35d42317a1b633e173bb2595f575b2ac4df","historical":false},"files":[{"path":"README.md","sourcePath":"marketing-skill/skills/prompt-engineer-toolkit/README.md","bytes":1244,"sha256":"9c3a78ebb25a4903b3400e864d0fb537c943742dd22af774a3fe1c4dea79f33f","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/prompt-engineer-toolkit/README.md"},{"p