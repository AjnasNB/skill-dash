{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--isms-audit-expert","name":"isms-audit-expert","description":"Information Security Management System (ISMS) audit expert for ISO 27001 compliance verification, security control assessment, and certification support. Use when the user mentions ISO 27001, ISMS audit, Annex A controls, Statement of Applicability (SOA), gap analysis, nonconformity management, internal audit, surveillance audit, or security certification preparation. Helps review control implementation evidence, document audit findings, classify nonconformities, generate risk-based audit plans, map controls to Annex A requirements, prepare Stage 1 and Stage 2 audit documentation, and support corrective action workflows.","category":"Security","tags":["isms","audit","expert","information","security","management","system","iso","27001","compliance","verification","control","assessment","certification","support.","when","user","mentions"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"ra-qm-team/skills/isms-audit-expert","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/isms-audit-expert","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":7,"bytes":47754,"sha256":"99fddd2db9f85167eeb47474bf3b30eea28062377c8e14dc2f188c2607062e8e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"ra-qm-team/skills/isms-audit-expert/SKILL.md","bytes":7687,"sha256":"99fddd2db9f85167eeb47474bf3b30eea28062377c8e14dc2f188c2607062e8e","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/ra-qm-team/skills/isms-audit-expert/SKILL.md"},{"path":"references/cloud-security-audit.md","sourcePath":"ra-qm-team/skills/isms-audit