{"schemaVersion":1,"skill":{"id":"heygen-com--hyperframes--hyperframes-animation","name":"hyperframes-animation","description":"All animation knowledge for HyperFrames — atomic motion rules, multi-phase scene blueprints, scene transitions, broader motion-design techniques, AND the seven runtime adapters (GSAP default, plus Lottie, Three.js, Anime.js, CSS keyframes, Web Animations API, TypeGPU). Use for any motion or animation task: pick 2-4 rules and compose, or load a blueprint, or look up runtime-specific API (e.g. GSAP eases / Lottie player / Three.js mixer). Also covers auditing an existing composition's choreography (animation map) and 24 named text-animation effects. HyperFrames-native: single paused timeline, seek-safe, deterministic.","category":"Video & audio","tags":["hyperframes","animation","all","knowledge","atomic","motion","rules","multi","phase","scene","blueprints","transitions","broader","design","techniques","seven","runtime","adapters"],"repo":"heygen-com/hyperframes","owner":"heygen-com","stars":52761,"official":true,"featured":false,"license":"Apache-2.0","licensePath":"LICENSE","revision":"58c873d8161d6a2357eacf89a540bfecc359349b","path":"skills/hyperframes-animation","sourceUrl":"https://github.com/heygen-com/hyperframes/tree/58c873d8161d6a2357eacf89a540bfecc359349b/skills/hyperframes-animation","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T06:32:31Z","fileCount":123,"bytes":1241554,"sha256":"e784a9bb115911d5b87e4f172ec180c3012ac14352dcb867ccdeef396f753352","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/hyperframes-animation/SKILL.md","bytes":8113,"sha256":"e784a9bb115911d5b87e4f172ec180c3012ac14352dcb867ccdeef396f753352","mode":420,"url":"https://raw.githubusercontent.com/heygen-com/hyperframes/58c873d8161d6a2357eacf89a540bfecc359349b/skills/hyperframes-animation/SKILL.md"},{"path":"adapters/animate-text.md","sourcePath":"skills/hyperframes-animation/adapters/animate-text.md","bytes":4069,"sha256":"82f0