{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--make-blog-post","name":"make-blog-post","description":"Turn code from the current session into a blog post written in the voice of its author. Covers one function, script, class, or tool as a focused walkthrough with a generalized sample and a usage example, learns tone and structure from existing posts or writing samples by the same author, takes the destination from what the user names or the blog repository in use instead of assumed folders, and saves no file until the draft is approved. Use when asked to write, draft, or turn code into a blog post, article, tutorial, or gist, or when invoked as /make-blog-post at the end of a turn.","category":"Writing","tags":["blog","post","turn","code","from","current","session","into","written","voice","its","author.","covers","one","function","script","class","tool"],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/make-blog-post","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/make-blog-post","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":7,"bytes":38262,"sha256":"471093b0a65e68a99c52b7a8d44184c43cac3ad9d1f0c33a5dea1c421b331798","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/make-blog-post/SKILL.md","bytes":13884,"sha256":"471093b0a65e68a99c52b7a8d44184c43cac3ad9d1f0c33a5dea1c421b331798","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/make-blog-post/SKILL.md"},{"path":"assets/voice-profile-template.md","sourcePath":"skills/make-blog-post/assets/voice-profile-template.md","bytes":1077,"sha256":"95e80a6635145e4e82974643217b12a4000ace3ab71981e54d50f652a70db341","mode":420,"url":"https://raw.githubusercontent.com/github/awe