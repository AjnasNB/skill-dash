{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--code-reviewer","name":"code-reviewer","description":"Analyzes code diffs and files to identify bugs, security vulnerabilities (SQL injection, XSS, insecure deserialization), code smells, N+1 queries, naming issues, and architectural concerns, then produces a structured review report with prioritized, actionable feedback. Use when reviewing pull requests, conducting code quality audits, identifying refactoring opportunities, or checking for security issues. Invoke for PR reviews, code quality checks, refactoring suggestions, review code, code quality. Complements specialized skills (security-reviewer, test-master) by providing broad-scope review across correctness, performance, maintainability, and test coverage in a single pass.","category":"Security","tags":["code","reviewer","analyzes","diffs","files","identify","bugs","security","vulnerabilities","sql","injection","xss","insecure","deserialization","smells","n+1","queries","naming"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/code-reviewer","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/code-reviewer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":8,"bytes":33941,"sha256":"8f0ddb7d90178b6986f8d597ab0bc93ec01adb044bd27b75e1682b06902dae93","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/code-reviewer/SKILL.md","bytes":5179,"sha256":"8f0ddb7d90178b6986f8d597ab0bc93ec01adb044bd27b75e1682b06902dae93","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/code-reviewer/SKILL.md"},{"path":"references/common-issues.md","sourcePath":"skills/code-reviewer/references/common-issues.md","bytes":2999,"sha256":"19de3cc