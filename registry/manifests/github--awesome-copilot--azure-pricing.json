{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--azure-pricing","name":"azure-pricing","description":"Fetches real-time Azure retail pricing using the Azure Retail Prices API (prices.azure.com) and estimates Copilot Studio agent credit consumption. Use when the user asks about the cost of any Azure service, wants to compare SKU prices, needs pricing data for a cost estimate, mentions Azure pricing, Azure costs, Azure billing, or asks about Copilot Studio pricing, Copilot Credits, or agent usage estimation. Covers compute, storage, networking, databases, AI, Copilot Studio, and all other Azure service families.","category":"Cloud & DevOps","tags":["azure","pricing","fetches","real","time","retail","prices","api","prices.azure.com","estimates","copilot","studio","agent","credit","consumption.","when","user","asks"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/azure-pricing","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/azure-pricing","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":6,"bytes":26468,"sha256":"905bd90f658435e9812dca1aa613675fce948ad878e29c9f1bbe19b237edc3ee","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/azure-pricing/SKILL.md","bytes":9494,"sha256":"905bd90f658435e9812dca1aa613675fce948ad878e29c9f1bbe19b237edc3ee","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/azure-pricing/SKILL.md"},{"path":"references/COPILOT-STUDIO-RATES.md","sourcePath":"skills/azure-pricing/references/COPILOT-STUDIO-RATES.md","bytes":5795,"sha256":"922b55a807afe9a5e5913cfec2d3b249a66fc92ba3584a9d0f81f18d047253be","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b2