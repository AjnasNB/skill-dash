{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--nodejs-keccak256","name":"nodejs-keccak256","description":"Prevent Ethereum hashing bugs in JavaScript and TypeScript. Node's sha3-256 is NIST SHA3, not Ethereum Keccak-256, and silently breaks selectors, signatures, storage slots, and address derivation. Use when hashing for Ethereum in JavaScript or TypeScript, or when a selector, signature, storage slot, or derived address is wrong.","category":"Development","tags":["nodejs","keccak256","prevent","ethereum","hashing","bugs","javascript","typescript.","node","sha3","256","is","nist","not","keccak","silently","breaks","selectors"],"repo":"affaan-m/ECC","owner":"affaan-m","stars":266395,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"bf70150eb2df8070024e5bdf08e4aa08959e2735","path":"skills/nodejs-keccak256","sourceUrl":"https://github.com/affaan-m/ECC/tree/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/nodejs-keccak256","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-21T18:40:16Z","fileCount":2,"bytes":4063,"sha256":"973c1194e28b51f56895617abcbcca82a37d25282e7603700a6bf284459bebdb","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/nodejs-keccak256/SKILL.md","bytes":2992,"sha256":"973c1194e28b51f56895617abcbcca82a37d25282e7603700a6bf284459bebdb","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/nodejs-keccak256/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1071,"sha256":"326146379f01bb137c0a5d3c54770c1aa31076705c8b88a7f6b26a460f6221b2","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/LICENSE"}],"archiveSha256":"405240201bda8686e3facde73558579420dcef4659e45fdc8185c2fb68eb9ea6"}