{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--detecting-oauth-token-theft","name":"detecting-oauth-token-theft","description":"Detect and respond to OAuth token theft and replay in Microsoft Entra ID (Azure AD), covering access token theft, refresh token replay, Primary Refresh Token (PRT) abuse, pass-the-cookie attacks, and Token Protection conditional access policies. Use for impossible-travel or anomalous token-usage alerts, suspected session hijacking, sign-in log analysis, or configuring token-binding defenses in Azure/M365.","category":"Cloud & DevOps","tags":["detecting","oauth","token","theft","detect","respond","replay","microsoft","entra","id","azure","ad","covering","access","refresh","primary","prt","abuse"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/detecting-oauth-token-theft/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/detecting-oauth-token-theft","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-oauth-token-theft","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":4,"bytes":32864,"sha256":"d70f73b9be11811ff64728233f5015825b2be3c3462bf8630d6f76d2f34d71a3","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/detecting-oauth-token-theft/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/detecting-oauth-token-theft/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/detecting-oauth-token-theft/SKILL.md","bytes":12766,"sha256":"d70f73b9be11811ff64728233f5015825b2be3c3462bf8630d6f76d2f34d71a3","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-