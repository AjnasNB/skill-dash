{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--geofeed-tuner","name":"geofeed-tuner","description":"Use this skill whenever the user mentions IP geolocation feeds, RFC 8805, geofeeds, or wants help creating, tuning, validating, or publishing a self-published IP geolocation feed in CSV format. Intended user audience is a network operator, ISP, mobile carrier, cloud provider, hosting company, IXP, or satellite provider asking about IP geolocation accuracy, or geofeed authoring best practices. Helps create, refine, and improve CSV-format IP geolocation feeds with opinionated recommendations beyond RFC 8805 compliance. Do NOT use for private or internal IP address management — applies only to publicly routable IP addresses.","category":"Development","tags":["geofeed","tuner","skill","whenever","user","mentions","ip","geolocation","feeds","rfc","8805","geofeeds","wants","creating","tuning","validating","publishing","self"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/geofeed-tuner","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/geofeed-tuner","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":9,"bytes":528961,"sha256":"60ba0fc27995b7def1b76599878ac1ad1dc5896b09bf099a1428348cf8a72bcf","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/geofeed-tuner/SKILL.md","bytes":48706,"sha256":"60ba0fc27995b7def1b76599878ac1ad1dc5896b09bf099a1428348cf8a72bcf","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/geofeed-tuner/SKILL.md"},{"path":"assets/example/01-user-input-rfc8805-feed.csv","sourcePath":"skills/geofeed-tuner/assets/example/01-user-input-rfc8805-feed.csv","bytes":214,"sha256":"eba2393da5109458d55aec578318018073603426c1d