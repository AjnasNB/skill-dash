{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--upstash-redis","name":"upstash-redis","description":"Use Redis over HTTP from serverless and edge runtimes with @upstash/redis, and add rate limiting with @upstash/ratelimit. Use when the user mentions Upstash Redis, needs Redis from a Next.js route handler or middleware, Vercel, Cloudflare Workers, Deno, or Bun without TCP connection pooling, or wants cache-aside with TTLs, a session store, counters, or a 429 rate limiter using fixed window, sliding window, or token bucket. DO NOT use for self-hosted or TCP Redis clients (ioredis, node-redis), Redis Cluster administration, or vector similarity search.","category":"Cloud & DevOps","tags":["upstash","redis","over","http","from","serverless","edge","runtimes","add","rate","limiting","ratelimit.","when","user","mentions","needs","next.js","route"],"repo":"github/awesome-copilot","owner":"github","stars":39944,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"70ddff7fab9d4d49743d221b56d761cff58048d0","path":"skills/upstash-redis","sourceUrl":"https://github.com/github/awesome-copilot/tree/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/upstash-redis","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T07:38:37Z","fileCount":2,"bytes":7995,"sha256":"6a51da36588cdfad16b8ced54d7a3f8cb01aa3a9b07e16982dedd990bf7bcee3","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/upstash-redis/SKILL.md","bytes":6936,"sha256":"6a51da36588cdfad16b8ced54d7a3f8cb01aa3a9b07e16982dedd990bf7bcee3","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/skills/upstash-redis/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/70ddff7fab9d4d49743d221b56d761cff58048d0/LICENSE"}],"archiveSha256":"5d