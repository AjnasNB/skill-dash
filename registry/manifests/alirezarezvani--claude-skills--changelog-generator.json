{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--changelog-generator","name":"changelog-generator","description":"Produce consistent, auditable release notes from Conventional Commits. Separates commit parsing, semantic-bump logic, and changelog rendering for automated releases with editorial control. Use when cutting a release, generating CHANGELOG.md from git history, computing the next semantic version from commits, automating release notes in CI, or planning a hotfix/rollback. Examples: 'generate the changelog for v1.4.0', 'what version bump do these commits require', 'we need an emergency hotfix process'.","category":"Writing","tags":["changelog","generator","produce","consistent","auditable","release","notes","from","conventional","commits.","separates","commit","parsing","semantic","bump","logic","rendering","automated"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/changelog-generator","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/changelog-generator","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":65258,"sha256":"0866b458e0eff49b95328452a32e326a866b661bbdd3b2f4ac2d3f9b9f3ddc25","historical":false},"files":[{"path":"README.md","sourcePath":"engineering/skills/changelog-generator/README.md","bytes":1451,"sha256":"ed6920c97a0bb76032085fbde949531400e9df5e6bdb7ea2ccfe4e231eae4017","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/changelog-generator/README.md"},{"path":"SKILL.md","sourcePath":"engineering/skills/changelog-generator/SKILL.md","bytes":7524,"sha256":"0866b458e0eff49b95328452a32e326a866b661bbdd3b2f4ac2d3f9b9f3ddc25","mode":420,"url":"h