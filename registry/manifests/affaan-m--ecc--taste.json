{"schemaVersion":1,"skill":{"id":"affaan-m--ecc--taste","name":"taste","description":"A creative-direction (taste) layer for music videos and short-form edits in the angelcore / cloud-trance / hyperpop visual family. Distills a named-genre aesthetic vocabulary, a mood + color + light system, and a beat-synced editing grammar, then chains ECC's video skills (video-editing, fal-ai-media, remotion-video-creation, motion-*, content-engine) into one production pipeline. Use when the work is not just making a video function but making it feel intentional, when building a music video, a fancam/edit, a moodboard-driven reel, or when choosing a coherent visual direction for AI-generated b-roll.","category":"Video & audio","tags":["taste","creative","direction","layer","music","videos","short","form","edits","angelcore","cloud","trance","hyperpop","visual","family.","distills","named","genre"],"repo":"affaan-m/ECC","owner":"affaan-m","stars":266395,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"bf70150eb2df8070024e5bdf08e4aa08959e2735","path":"skills/taste","sourceUrl":"https://github.com/affaan-m/ECC/tree/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/taste","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-21T18:40:16Z","fileCount":3,"bytes":21482,"sha256":"fa161c7dd71a26d07c86ff48a82d35756f41ed18a384d918c42264a1939d1260","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/taste/SKILL.md","bytes":15542,"sha256":"fa161c7dd71a26d07c86ff48a82d35756f41ed18a384d918c42264a1939d1260","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/taste/SKILL.md"},{"path":"references/genre-taxonomy.md","sourcePath":"skills/taste/references/genre-taxonomy.md","bytes":4869,"sha256":"56b0a37d643c79b0b18f67053e4733ffc383f82c7c9e1134f3c6e21e295d8c77","mode":420,"url":"https://raw.githubusercontent.com/affaan-m/ECC/bf70150eb2df8070024e5bdf08e4aa08959e2735/skills/taste/refer