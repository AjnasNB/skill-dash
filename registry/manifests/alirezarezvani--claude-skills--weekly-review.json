{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--weekly-review","name":"weekly-review","description":"Use when someone wants to run a weekly review, close open loops, audit stalled projects and commitments, get their system back to trusted, restart a lapsed review habit, or says \"/cs:weekly-review\". Walks David Allen's three-phase loop — GET CLEAR, GET CURRENT, GET CREATIVE — with deterministic scripts that inventory open loops, gate the checklist with named gaps, and score commitment health 0-100.","category":"Development","tags":["weekly","review","when","someone","wants","run","close","open","loops","audit","stalled","projects","commitments","get","their","system","back","trusted"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"productivity/weekly-review/skills/weekly-review","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/productivity/weekly-review/skills/weekly-review","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":10,"bytes":57271,"sha256":"3df151a1102d44eb45f131637119a02e03e4e9719f23e7130327a299e7a18f17","historical":false},"files":[{"path":"SKILL.md","sourcePath":"productivity/weekly-review/skills/weekly-review/SKILL.md","bytes":5813,"sha256":"3df151a1102d44eb45f131637119a02e03e4e9719f23e7130327a299e7a18f17","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/productivity/weekly-review/skills/weekly-review/SKILL.md"},{"path":"assets/example_weekly_review.md","sourcePath":"productivity/weekly-review/skills/weekly-review/assets/example_weekly_review.md","bytes":4163,"sha256":"c366bf59c54e3ea71ee6db372b04ccb8d6923c9ac5d6318861f01a55ccb0d761","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-s