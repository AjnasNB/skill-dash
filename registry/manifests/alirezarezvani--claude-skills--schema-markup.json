{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--schema-markup","name":"schema-markup","description":"When the user wants to implement, audit, or validate structured data (schema markup) on their website. Use when the user mentions 'structured data,' 'schema.org,' 'JSON-LD,' 'rich results,' 'rich snippets,' 'schema markup,' 'FAQ schema,' 'Product schema,' 'HowTo schema,' or 'structured data errors in Search Console.' Also use when someone asks why their content isn't showing rich results or wants to improve AI search visibility. NOT for general SEO audits (use seo-audit) or technical SEO crawl issues (use site-architecture).","category":"Marketing","tags":["schema","markup","when","user","wants","implement","audit","validate","structured","data","their","website.","mentions","schema.org","json","ld","rich","results"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/schema-markup","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/schema-markup","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":48843,"sha256":"949186b826c714ae173d8d2e9dd73c705dbd4ee5fe33645e9583a5b451e1dfcc","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/schema-markup/SKILL.md","bytes":11661,"sha256":"949186b826c714ae173d8d2e9dd73c705dbd4ee5fe33645e9583a5b451e1dfcc","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/schema-markup/SKILL.md"},{"path":"references/implementation-patterns.md","sourcePath":"marketing-skill/skills/schema-markup/references/implementation-patterns.md","bytes":9695,"sha256":"2b547b731800d9462034cf0a1ce89ee013d90e5d433aa7e0567