{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--git-worktree-manager","name":"git-worktree-manager","description":"Run parallel feature work safely with Git worktrees. Standardizes branch isolation, port allocation, environment sync, and cleanup so each worktree behaves like an independent local app. Optimized for multi-agent workflows where each agent or terminal session owns one worktree. Use when running multiple feature branches simultaneously, isolating experimental work, or coordinating multi-agent development across the same repo.","category":"AI & agents","tags":["git","worktree","manager","run","parallel","feature","work","safely","worktrees.","standardizes","branch","isolation","port","allocation","environment","sync","cleanup","so"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/git-worktree-manager","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/git-worktree-manager","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":7,"bytes":26817,"sha256":"c972e7576a18df4180b92f83af3d5e375814a8d6133267acce44ec89709f4dac","historical":false},"files":[{"path":"README.md","sourcePath":"engineering/skills/git-worktree-manager/README.md","bytes":1291,"sha256":"f50d318567114db46620ce72137a61e781e93b00cefa7e750380bd07aa8c6d49","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/git-worktree-manager/README.md"},{"path":"SKILL.md","sourcePath":"engineering/skills/git-worktree-manager/SKILL.md","bytes":7089,"sha256":"c972e7576a18df4180b92f83af3d5e375814a8d6133267acce44ec89709f4dac","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed0048