{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--sponsor-finder","name":"sponsor-finder","description":"Find which of a GitHub repository's dependencies are sponsorable via GitHub Sponsors. Uses deps.dev API for dependency resolution across npm, PyPI, Cargo, Go, RubyGems, Maven, and NuGet. Checks npm funding metadata, FUNDING.yml files, and web search. Verifies every link. Shows direct and transitive dependencies with OSSF Scorecard health data. Invoke with /sponsor followed by a GitHub owner/repo (e.g. \"/sponsor expressjs/express\").","category":"Development","tags":["sponsor","finder","find","which","github","repository","dependencies","are","sponsorable","via","sponsors.","uses","deps.dev","api","dependency","resolution","across","npm"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/sponsor-finder","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/sponsor-finder","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":2,"bytes":13238,"sha256":"f150e859624fec421a0c93d582a154891dab14c052ce67399c8df0ff12f93aee","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/sponsor-finder/SKILL.md","bytes":12179,"sha256":"f150e859624fec421a0c93d582a154891dab14c052ce67399c8df0ff12f93aee","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/sponsor-finder/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1059,"sha256":"e32449d23085399adc1222f7a17408b730550258e51627c153cb108ca9955823","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/LICENSE"}],"archiveSha256":"18afd2b75d37add9dc679cb2049d130fb71c999f2cb2e72aecb5ea7bce32cc4b"}