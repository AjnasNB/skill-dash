{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--gget","name":"gget","description":"Queries 20+ bioinformatics resources through CLI/Python. Supports quick lookups of gene info, BLAST/BLAT, viral sequence downloads, PDB/mmCIF structures, G2P residue annotations, enrichment analysis, OpenTargets, COSMIC, CELLxGENE, and 8cube mouse specificity/expression data. Best for interactive exploration and simple queries. For batch processing or advanced BLAST use biopython; for multi-database Python workflows use bioservices.","category":"Data & research","tags":["gget","queries","20+","bioinformatics","resources","through","cli","python.","supports","quick","lookups","gene","info","blast","blat","viral","sequence","downloads"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/gget","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/gget","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":10,"bytes":111581,"sha256":"55027a94be8dde013fd17e563ba20ccba92b7131c29c21e9c83e54fbce2b348a","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/gget/SKILL.md","bytes":11253,"sha256":"55027a94be8dde013fd17e563ba20ccba92b7131c29c21e9c83e54fbce2b348a","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/gget/SKILL.md"},{"path":"references/common_workflows.md","sourcePath":"skills/gget/references/common_workflows.md","bytes":2570,"sha256":"125d01874c0577e29b50ca9fb43bcf995ed0816662b11fb20941948cfbe58400","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/gget/references/common_workflows.md"},{"path":"references/database