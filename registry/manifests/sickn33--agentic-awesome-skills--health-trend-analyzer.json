{"schemaVersion":1,"skill":{"id":"sickn33--agentic-awesome-skills--health-trend-analyzer","name":"health-trend-analyzer","description":"分析一段时间内健康数据的趋势和模式。关联药物、症状、生命体征、化验结果和其他健康指标的变化。识别令人担忧的趋势、改善情况，并提供数据驱动的洞察。当用户询问健康趋势、模式、随时间的变化或\"我的健康状况有什么变化？\"时使用。支持多维度分析（体重/BMI、症状、药物依从性、化验结果、情绪睡眠），相关性分析，变化检测，以及交互式HTML可视化报告（ECharts图表）。","category":"Development","tags":["health","trend","analyzer","分析一段时间内健康数据的趋势和模式","关联药物","症状","生命体征","化验结果和其他健康指标的变化","识别令人担忧的趋势","改善情况","并提供数据驱动的洞察","当用户询问健康趋势","模式","随时间的变化或","我的健康状况有什么变化","时使用","支持多维度分析","体重"],"repo":"sickn33/agentic-awesome-skills","owner":"sickn33","stars":46853,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"21efc48cceaf0f7043fa496ad8fcd5815637121e","path":"skills/health-trend-analyzer","sourceUrl":"https://github.com/sickn33/agentic-awesome-skills/tree/21efc48cceaf0f7043fa496ad8fcd5815637121e/skills/health-trend-analyzer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T06:08:57Z","fileCount":2,"bytes":15392,"sha256":"f72bf2a7b14c32b29a5993024c7c9098d884c079f03f17adc584ab7ab868f8b6","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/health-trend-analyzer/SKILL.md","bytes":14319,"sha256":"f72bf2a7b14c32b29a5993024c7c9098d884c079f03f17adc584ab7ab868f8b6","mode":420,"url":"https://raw.githubusercontent.com/sickn33/agentic-awesome-skills/21efc48cceaf0f7043fa496ad8fcd5815637121e/skills/health-trend-analyzer/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1073,"sha256":"af98370a7edc0f00ec46979d049517833c9a7fa2ba74e3cf8cc42f7db557299d","mode":420,"url":"https://raw.githubusercontent.com/sickn33/agentic-awesome-skills/21efc48cceaf0f7043fa496ad8fcd5815637121e/LICENSE"}],"archiveSha256":"b66cca8fcc2773982d938c4e978c45d2b08d9406a25b99d2c275a5db540f2e90"}