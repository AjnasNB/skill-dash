{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--gitmoji","name":"gitmoji","description":"Generates commit messages following the gitmoji convention (https://gitmoji.dev) — picks the right emoji for the intent of the change and writes a well-formed message. Use when asked to \"write a gitmoji commit\", \"add an emoji to my commit message\", \"which gitmoji should I use\", \"gitmoji this change\", or when a project uses gitmoji-style commit messages. Works from a git diff, staged changes, or a plain description of the change. Generates the message only — does not run git commands.","category":"Writing","tags":["gitmoji","generates","commit","messages","following","convention","https","gitmoji.dev","picks","right","emoji","intent","change","writes","well","formed","message.","when"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/gitmoji","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/gitmoji","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":3,"bytes":13012,"sha256":"2ac146eec71a7ffddff6d488118084cb8b3bc0368da7cff4c444485f8177c6a1","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/gitmoji/SKILL.md","bytes":7260,"sha256":"2ac146eec71a7ffddff6d488118084cb8b3bc0368da7cff4c444485f8177c6a1","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/gitmoji/SKILL.md"},{"path":"references/gitmoji-reference.md","sourcePath":"skills/gitmoji/references/gitmoji-reference.md","bytes":4693,"sha256":"642062cbd712401a489ed03ce8ef73e17abd3aa6b1ab7aa0c18934685feb3334","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/gitmoji/references/gitmoji-reference.md"},{"path":"UPST