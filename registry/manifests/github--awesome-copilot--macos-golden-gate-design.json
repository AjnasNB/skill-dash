{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--macos-golden-gate-design","name":"macos-golden-gate-design","description":"Design, implement, review, or refactor native macOS 27 Golden Gate interfaces in SwiftUI or AppKit. Use when a Mac app must match Apple's current macOS 27 UI kit and restrained Liquid Glass language: integrated windows, full-height sidebars, native toolbars, flat lists, tables, and forms, clear pane boundaries, accessible materials, and removal of unnecessary nested cards, framed panels, or glassmorphism. Also use for Figma macOS 27 design-to-code work and audits of interfaces that feel too boxed.","category":"Design","tags":["macos","golden","gate","design","implement","review","refactor","native","27","interfaces","swiftui","appkit.","when","mac","app","must","match","apple"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/macos-golden-gate-design","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/macos-golden-gate-design","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":5,"bytes":40303,"sha256":"677c4bc36b638bffe0702e7e307328777059f578601065165048d92e8e6bec31","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/macos-golden-gate-design/SKILL.md","bytes":8505,"sha256":"677c4bc36b638bffe0702e7e307328777059f578601065165048d92e8e6bec31","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/macos-golden-gate-design/SKILL.md"},{"path":"references/design-patterns.md","sourcePath":"skills/macos-golden-gate-design/references/design-patterns.md","bytes":10852,"sha256":"23ac745ab33ab9a90e1d64bd07bca63562229e64da093b3bff4ba6cdc90cf74e","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f