{"schemaVersion":1,"skill":{"id":"addyosmani--agent-skills--doubt-driven-development","name":"doubt-driven-development","description":"Subjects every non-trivial decision to a fresh-context adversarial review before it stands. Use when you want every assumption cross-examined before proceeding, when stress-testing a plan for hidden failure modes, when correctness matters more than speed, when working in unfamiliar code, when stakes are high (production auth, security-sensitive logic, a high-stakes migration, irreversible operations), or any time a confident output would be cheaper to verify now than to debug later.","category":"Security","tags":["doubt","driven","development","subjects","every","non","trivial","decision","fresh","context","adversarial","review","before","it","stands.","when","you","assumption"],"repo":"addyosmani/agent-skills","owner":"addyosmani","stars":105293,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1be8e34187e34647bb83adc3a1323b26ae6f6abe","path":"skills/doubt-driven-development","sourceUrl":"https://github.com/addyosmani/agent-skills/tree/1be8e34187e34647bb83adc3a1323b26ae6f6abe/skills/doubt-driven-development","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-10T08:28:48Z","fileCount":2,"bytes":17715,"sha256":"6fa1fcd8420c28daf7e53c5b08b0f20b907911efd2a6d9bce0b9740da20a4008","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/doubt-driven-development/SKILL.md","bytes":16647,"sha256":"6fa1fcd8420c28daf7e53c5b08b0f20b907911efd2a6d9bce0b9740da20a4008","mode":420,"url":"https://raw.githubusercontent.com/addyosmani/agent-skills/1be8e34187e34647bb83adc3a1323b26ae6f6abe/skills/doubt-driven-development/SKILL.md"},{"path":"UPSTREAM-LICENSE","sourcePath":"LICENSE","bytes":1068,"sha256":"6f202f8bd568cd730dbb2b0d1f8e243bc74c2fa1f64dbce9b2c7ea08bd5c9fd7","mode":420,"url":"https://raw.githubusercontent.com/addyosmani/agent-skills/1be8e34187e34647bb83adc3a1323b26ae6f6abe/LICENSE"}],"arch