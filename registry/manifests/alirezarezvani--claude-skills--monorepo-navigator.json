{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--monorepo-navigator","name":"monorepo-navigator","description":"Navigate, manage, and optimize monorepos. Covers Turborepo, Nx, pnpm workspaces, and Lerna. Cross-package impact analysis, selective builds/tests on affected packages, remote caching, dependency graph visualization, and structured multi-repo to monorepo migrations. Use when setting up a new monorepo, optimizing CI for a large workspace, debugging cross-package dependency issues, or planning a multi-repo consolidation.","category":"Development","tags":["monorepo","navigator","navigate","manage","optimize","monorepos.","covers","turborepo","nx","pnpm","workspaces","lerna.","cross","package","impact","analysis","selective","builds"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering/skills/monorepo-navigator","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/monorepo-navigator","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":5,"bytes":24591,"sha256":"19184d57f8eea27ed974b0e7eac2033b366b9cdacb6454bb9a1977314b182335","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering/skills/monorepo-navigator/SKILL.md","bytes":4948,"sha256":"19184d57f8eea27ed974b0e7eac2033b366b9cdacb6454bb9a1977314b182335","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering/skills/monorepo-navigator/SKILL.md"},{"path":"references/monorepo-patterns.md","sourcePath":"engineering/skills/monorepo-navigator/references/monorepo-patterns.md","bytes":1011,"sha256":"649431c7614f51d51079ed8c1e0e1806741188bd940e8b3dc02c30b588d79ad1","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claud