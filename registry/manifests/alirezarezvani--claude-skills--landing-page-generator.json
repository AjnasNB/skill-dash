{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--landing-page-generator","name":"landing-page-generator","description":"Generates high-converting landing pages as complete Next.js/React (TSX) components with Tailwind CSS. Creates hero sections, feature grids, pricing tables, FAQ accordions, testimonial blocks, and CTA sections using proven copy frameworks (PAS, AIDA, BAB). Outputs SEO meta tags, structured data, and performance-optimised code targeting Core Web Vitals (LCP < 1s, CLS < 0.1). Use when the user asks to create a landing page, marketing page, homepage, single-page site, lead capture page, campaign page, promo page, or conversion-optimised web page — or when they want to A/B test landing page variants or replace a static page with one designed to convert.","category":"Design","tags":["landing","page","generator","generates","high","converting","pages","as","complete","next.js","react","tsx","components","tailwind","css.","creates","hero","sections"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"product-team/skills/landing-page-generator","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/product-team/skills/landing-page-generator","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":7,"bytes":58312,"sha256":"c5c07fa98752269c1158c20cc777c19476b7614fef30a0526785cc09aea82444","historical":false},"files":[{"path":"SKILL.md","sourcePath":"product-team/skills/landing-page-generator/SKILL.md","bytes":10646,"sha256":"c5c07fa98752269c1158c20cc777c19476b7614fef30a0526785cc09aea82444","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/product-team/skills/landing-page-generator/SKILL.md"},{"path":"references/conversion-patterns.md