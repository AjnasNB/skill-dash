{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--linkedin-strategy","name":"linkedin-strategy","description":"Use when someone needs a LinkedIn plan rather than a post — content pillars, positioning for a career change or consulting or thought leadership, a sustainable posting cadence, or a newsletter decision. Triggers on \"what should I post about\", \"how often should I post\", \"LinkedIn content strategy\", \"should I start a LinkedIn newsletter\", \"grow my following\", \"90-day plan\". Validates the positioning brief, sizes the week against real hours and refuses a plan that will not survive week five, and gates a newsletter against eligibility and a six-month cadence commitment.","category":"Product & business","tags":["linkedin","strategy","when","someone","needs","plan","rather","than","post","content","pillars","positioning","career","change","consulting","thought","leadership","sustainable"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing/linkedin/skills/linkedin-strategy","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-strategy","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":10,"bytes":65938,"sha256":"9e1c5c934a85142ed6b791f5bfb55ee0d2ad9852fe31f7fd83a36215ab15e72e","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing/linkedin/skills/linkedin-strategy/SKILL.md","bytes":5148,"sha256":"9e1c5c934a85142ed6b791f5bfb55ee0d2ad9852fe31f7fd83a36215ab15e72e","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing/linkedin/skills/linkedin-strategy/SKILL.md"},{"path":"assets/example_brief.json","sourcePath":"marketing/linkedin/skills/linkedin-strategy/ass