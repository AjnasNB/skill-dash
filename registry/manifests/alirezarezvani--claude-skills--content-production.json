{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--content-production","name":"content-production","description":"Full content production pipeline — takes a topic from blank page to published-ready piece. Use when you need to execute content: write a blog post, article, or guide end-to-end. Triggers: 'write a post about', 'draft an article', 'create content for', 'help me write', 'I need a blog post'. NOT for content strategy or calendar planning (use content-strategy). NOT for repurposing existing content (use content-repurposing). NOT for social captions only.","category":"Video & audio","tags":["content","production","full","pipeline","takes","topic","from","blank","page","published","ready","piece.","when","you","execute","write","blog","post"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/content-production","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/content-production","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":11,"bytes":83460,"sha256":"8e893a54ee044459e6dc8f3c901aa6617cfa6f66d940f60881b9957fd7c1aed3","historical":false},"files":[{"path":"SKILL.md","sourcePath":"marketing-skill/skills/content-production/SKILL.md","bytes":11368,"sha256":"8e893a54ee044459e6dc8f3c901aa6617cfa6f66d940f60881b9957fd7c1aed3","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/content-production/SKILL.md"},{"path":"references/ai-citation-readiness.md","sourcePath":"marketing-skill/skills/content-production/references/ai-citation-readiness.md","bytes":3131,"sha256":"6fa6b6e18aab4331bd4bb2351504f689c74edefcc1327c191ae2d6cc5af96829","mode":420,"url":"https://raw.githu