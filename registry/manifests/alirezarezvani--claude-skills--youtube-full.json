{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--youtube-full","name":"youtube-full","description":"Use when the user needs YouTube transcripts, video search, channel browsing, playlist extraction, or content monitoring. Trigger phrases: 'get the transcript for', 'search YouTube for', 'what are the latest videos on', 'list this playlist', 'monitor this channel', or any request involving a YouTube URL, video ID, or @handle. Do NOT use for downloading video or audio files, YouTube engagement data (likes, comments), or private/age-restricted videos.","category":"Video & audio","tags":["youtube","full","when","user","needs","transcripts","video","search","channel","browsing","playlist","extraction","content","monitoring.","trigger","phrases","get","transcript"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"marketing-skill/skills/youtube-full","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/youtube-full","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":4,"bytes":9258,"sha256":"0035de6d16bb11384365276fd88ee84be5fa0bb590aae5f7c0542084ad07933f","historical":false},"files":[{"path":".claude-plugin/authoring-notes.json","sourcePath":"marketing-skill/skills/youtube-full/.claude-plugin/authoring-notes.json","bytes":189,"sha256":"a8bc87a15b103550f129e415f2607de98d17edbfdf9eeba7c09ebc0bb68498e6","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/marketing-skill/skills/youtube-full/.claude-plugin/authoring-notes.json"},{"path":".claude-plugin/plugin.json","sourcePath":"marketing-skill/skills/youtube-full/.claude-plugin/plugin.json","bytes":659,"sha256":"53752f49b8f0fa426cc3de605565434fac62dbb37e63a43069fd6e2f3f9686