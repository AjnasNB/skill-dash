{"schemaVersion":1,"skill":{"id":"mukul975--anthropic-cybersecurity-skills--hunting-bootkits-in-efi-system-partition","name":"hunting-bootkits-in-efi-system-partition","description":"Baseline the EFI System Partition and hunt malicious EFI binaries such as ESPecter, BlackLotus, Bootkitty, and Glupteba by mounting the ESP, hashing and verifying boot loaders, scanning with YARA, and flagging anomalous non-EFI files or out-of-band bootloader changes. Use during proactive threat hunts for firmware/bootkit persistence (MITRE ATT&CK T1542.003) or when investigating suspected UEFI-level compromise that survives OS reinstall.","category":"Security","tags":["hunting","bootkits","efi","system","partition","baseline","hunt","malicious","binaries","such","as","especter","blacklotus","bootkitty","glupteba","by","mounting","esp"],"repo":"mukul975/Anthropic-Cybersecurity-Skills","owner":"mukul975","stars":34277,"official":false,"featured":false,"license":"Apache-2.0","licensePath":"skills/hunting-bootkits-in-efi-system-partition/LICENSE","revision":"54a798831d2266a3ca61ce68a7acb80b81160d57","path":"skills/hunting-bootkits-in-efi-system-partition","sourceUrl":"https://github.com/mukul975/Anthropic-Cybersecurity-Skills/tree/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-bootkits-in-efi-system-partition","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-08-31T04:32:42Z","fileCount":5,"bytes":34344,"sha256":"bdad354aaee13f6f28531c40ef94b629b872192f308e8478e0a8c58c988c879f","historical":false},"files":[{"path":"LICENSE","sourcePath":"skills/hunting-bootkits-in-efi-system-partition/LICENSE","bytes":11255,"sha256":"a941b58ef0ba43a31e24ae7ece1b743a585efed9e37792b9ca063e0798be1cbe","mode":420,"url":"https://raw.githubusercontent.com/mukul975/Anthropic-Cybersecurity-Skills/54a798831d2266a3ca61ce68a7acb80b81160d57/skills/hunting-bootkits-in-efi-system-partition/LICENSE"},{"path":"SKILL.md","sourcePath":"skills/hunting-bootkits-in-efi-system-partition/SKILL.md","bytes":12763,"