{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--clinical-research","name":"clinical-research","description":"Use when designing a prospective clinical study before submission — selecting and classifying endpoints (primary / key-secondary / exploratory, with surrogate-endpoint flagging), estimating sample size and power for two-arm designs (means / proportions / survival), or scoring a study plan for feasibility and a GO / GO-WITH-CONDITIONS / REDESIGN / NO-GO phase-gate decision. Every output is an ESTIMATE plus a named human owner (clinician / biostatistician / regulatory owner) — never clinical fact, never a finished protocol. Distinct from ra-qm-team, which handles the regulatory/QM submission (ISO 13485, EU MDR, FDA 510(k)/PMA/QSR), not the study design.","category":"Design","tags":["clinical","research","when","designing","prospective","study","before","submission","selecting","classifying","endpoints","primary","key","secondary","exploratory","surrogate","endpoint","flagging"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"research-ops/skills/clinical-research","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/research-ops/skills/clinical-research","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":12,"bytes":60441,"sha256":"2ee6764353ca5dd7b2366557be898e4aea17c7223e0f9ac6799c9b21a0ef8041","historical":false},"files":[{"path":"SKILL.md","sourcePath":"research-ops/skills/clinical-research/SKILL.md","bytes":10956,"sha256":"2ee6764353ca5dd7b2366557be898e4aea17c7223e0f9ac6799c9b21a0ef8041","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/research-ops/skills/clinical-research/SKILL.md"},{"path":"assets/protocol_synopsis_tem