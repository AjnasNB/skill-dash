{"schemaVersion":1,"skill":{"id":"k-dense-ai--scientific-agent-skills--genomic-intelligence","name":"genomic-intelligence","description":"Predicts regulatory features, gene structure, and expression directly from DNA sequence using Genomic Intelligence's hosted transformer DNA language models — no local GPU or model weights. Six tasks over a REST API and a hosted MCP server (keyless public demo): promoter regions, splice donor/acceptor sites, enhancer activity, chromatin state, sequence-to-expression (log TPM), and de-novo gene annotation, plus a composite find-genes-then-predict-expression workflow. Use when the user has a gene symbol, a genomic region, or a DNA/FASTA sequence and wants any of these predictions, mentions Genomic Intelligence, genomicintelligence.ai, api.genomicintelligence.ai, or mcp.genomicintelligence.ai.","category":"Data & research","tags":["genomic","intelligence","predicts","regulatory","features","gene","structure","expression","directly","from","dna","sequence","hosted","transformer","language","models","no","local"],"repo":"K-Dense-AI/scientific-agent-skills","owner":"K-Dense-AI","stars":48508,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE.md","revision":"a1043ef544e3a100c28e70a736b6cf32554d0677","path":"skills/genomic-intelligence","sourceUrl":"https://github.com/K-Dense-AI/scientific-agent-skills/tree/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/genomic-intelligence","checkedAt":"2026-10-12T11:14:06.196Z","updatedAt":"2026-10-12T09:43:29Z","fileCount":7,"bytes":63683,"sha256":"cdb027004996d313d31b55f6b93306de45306a89b8a4a792e94c36cf2d1dea20","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/genomic-intelligence/SKILL.md","bytes":24826,"sha256":"cdb027004996d313d31b55f6b93306de45306a89b8a4a792e94c36cf2d1dea20","mode":420,"url":"https://raw.githubusercontent.com/K-Dense-AI/scientific-agent-skills/a1043ef544e3a100c28e70a736b6cf32554d0677/skills/genomic-intelligence/SKILL.md"},{"path":"referenc