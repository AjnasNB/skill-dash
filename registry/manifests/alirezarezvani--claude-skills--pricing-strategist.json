{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--pricing-strategist","name":"pricing-strategist","description":"Use when designing or revisiting product pricing — selecting a pricing model (subscription seat-based, usage-based, value-based, freemium, or hybrid), running Van Westendorp Price Sensitivity Meter analysis on WTP survey data, or designing Good/Better/Best packaging tiers. Recommends a model and a price range with trade-offs, never a single number. For Commercial leads, Product Marketing, and CMOs at the pricing-design moment — not deal-by-deal discounting, not brand positioning.","category":"Design","tags":["pricing","strategist","when","designing","revisiting","product","selecting","model","subscription","seat","based","usage","value","freemium","hybrid","running","van","westendorp"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"commercial/skills/pricing-strategist","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/commercial/skills/pricing-strategist","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":9,"bytes":65623,"sha256":"0dcefcdeb60a2c319a0c12119290d1f812919ef7fe98aed9748aee2f9e79c9e6","historical":false},"files":[{"path":"SKILL.md","sourcePath":"commercial/skills/pricing-strategist/SKILL.md","bytes":9343,"sha256":"0dcefcdeb60a2c319a0c12119290d1f812919ef7fe98aed9748aee2f9e79c9e6","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/commercial/skills/pricing-strategist/SKILL.md"},{"path":"assets/pricing_brief_template.md","sourcePath":"commercial/skills/pricing-strategist/assets/pricing_brief_template.md","bytes":3396,"sha256":"d1ea641d9b68c143235d041a491905634f562b1eca1dc7794b070faca2eb0f40","mode":420,"url":"