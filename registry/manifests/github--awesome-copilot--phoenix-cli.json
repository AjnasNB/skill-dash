{"schemaVersion":1,"skill":{"id":"github--awesome-copilot--phoenix-cli","name":"phoenix-cli","description":"Debug LLM applications using the Phoenix CLI. Fetch traces, analyze errors, structure trace review with open coding and axial coding, inspect datasets, review experiments, query annotation configs, and use the GraphQL API. Use whenever the user is analyzing traces or spans, investigating LLM/agent failures, deciding what to do after instrumenting an app, building failure taxonomies, choosing what evals to write, or asking \"what's going wrong\", \"what kinds of mistakes\", or \"where do I focus\" — even without naming a technique.","category":"AI & agents","tags":["phoenix","cli","debug","llm","applications","cli.","fetch","traces","analyze","errors","structure","trace","review","open","coding","axial","inspect","datasets"],"repo":"github/awesome-copilot","owner":"github","stars":39345,"official":true,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"1f5644080a525d26a2e24f61a7609fb9b261c21a","path":"skills/phoenix-cli","sourceUrl":"https://github.com/github/awesome-copilot/tree/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/phoenix-cli","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-09-24T01:29:08Z","fileCount":4,"bytes":52882,"sha256":"dde98a935bea2f498567860dbb1577a3064b06a27178ee8ebbb76b48e79d26e1","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/phoenix-cli/SKILL.md","bytes":16232,"sha256":"dde98a935bea2f498567860dbb1577a3064b06a27178ee8ebbb76b48e79d26e1","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/phoenix-cli/SKILL.md"},{"path":"references/axial-coding.md","sourcePath":"skills/phoenix-cli/references/axial-coding.md","bytes":15076,"sha256":"428eee465b58ef01c713fedfc4f7382be3a7236ea814dfd656e26175b1ff6228","mode":420,"url":"https://raw.githubusercontent.com/github/awesome-copilot/1f5644080a525d26a2e24f61a7609fb9b261c21a/skills/pho