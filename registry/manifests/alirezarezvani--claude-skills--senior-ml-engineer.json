{"schemaVersion":1,"skill":{"id":"alirezarezvani--claude-skills--senior-ml-engineer","name":"senior-ml-engineer","description":"ML engineering skill for productionizing models, building MLOps pipelines, and integrating LLMs. Covers model deployment, feature stores, drift monitoring, RAG systems, and cost optimization. Use when the user asks about deploying ML models to production, setting up MLOps infrastructure (MLflow, Kubeflow, Kubernetes, Docker), monitoring model performance or drift, building RAG pipelines, or integrating LLM APIs with retry logic and cost controls. Focused on production and operational concerns rather than model research or initial training.","category":"Cloud & DevOps","tags":["senior","ml","engineer","engineering","skill","productionizing","models","building","mlops","pipelines","integrating","llms.","covers","model","deployment","feature","stores","drift"],"repo":"alirezarezvani/claude-skills","owner":"alirezarezvani","stars":26382,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"19392f7a08264ed00486a251f5b2098321771f94","path":"engineering-team/skills/senior-ml-engineer","sourceUrl":"https://github.com/alirezarezvani/claude-skills/tree/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/senior-ml-engineer","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-26T13:53:02Z","fileCount":8,"bytes":45700,"sha256":"78756b7e74b3e024d56c8d631ca40d6cbfd655ec5d98a9cbe19afff2617fc856","historical":false},"files":[{"path":"SKILL.md","sourcePath":"engineering-team/skills/senior-ml-engineer/SKILL.md","bytes":9764,"sha256":"78756b7e74b3e024d56c8d631ca40d6cbfd655ec5d98a9cbe19afff2617fc856","mode":420,"url":"https://raw.githubusercontent.com/alirezarezvani/claude-skills/19392f7a08264ed00486a251f5b2098321771f94/engineering-team/skills/senior-ml-engineer/SKILL.md"},{"path":"references/llm_integration_guide.md","sourcePath":"engineering-team/skills/senior-ml-engineer/references/llm_integration_guide.md