{"schemaVersion":1,"skill":{"id":"jeffallan--claude-skills--vue-expert-js","name":"vue-expert-js","description":"Creates Vue 3 components, builds vanilla JS composables, configures Vite projects, and sets up routing and state management using JavaScript only — no TypeScript. Generates JSDoc-typed code with @typedef, @param, and @returns annotations for full type coverage without a TS compiler. Use when building Vue 3 applications with JavaScript only (no TypeScript), when projects require JSDoc-based type hints, when migrating from Vue 2 Options API to Composition API in JS, or when teams prefer vanilla JavaScript, .mjs modules, or need quick prototypes without TypeScript setup.","category":"Development","tags":["vue","expert","js","creates","components","builds","vanilla","composables","configures","vite","projects","sets","up","routing","state","management","javascript","only"],"repo":"Jeffallan/claude-skills","owner":"Jeffallan","stars":11598,"official":false,"featured":false,"license":"MIT","licensePath":"LICENSE","revision":"882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf","path":"skills/vue-expert-js","sourceUrl":"https://github.com/Jeffallan/claude-skills/tree/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/vue-expert-js","checkedAt":"2026-09-24T09:18:44.317Z","updatedAt":"2026-08-07T20:19:14Z","fileCount":7,"bytes":38512,"sha256":"f621caa22b3a8c84f8af1680b0c84a27237cb6d0b135e0fb9d26d2716e6f00f6","historical":false},"files":[{"path":"SKILL.md","sourcePath":"skills/vue-expert-js/SKILL.md","bytes":6082,"sha256":"f621caa22b3a8c84f8af1680b0c84a27237cb6d0b135e0fb9d26d2716e6f00f6","mode":420,"url":"https://raw.githubusercontent.com/Jeffallan/claude-skills/882ef55e377dbf9a4dbe496bb41ac6ccd0e555cf/skills/vue-expert-js/SKILL.md"},{"path":"references/component-architecture.md","sourcePath":"skills/vue-expert-js/references/component-architecture.md","bytes":4724,"sha256":"57088271a634f2b5e13b6c92e82b42100f2fde8ee8d4f818c2a0472ec7e53f49","mode":420,"url":"https://raw.githubuser